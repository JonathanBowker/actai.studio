---
interface Props { bookingHref: string }
const { bookingHref } = Astro.props;
---

<header class="sticky top-0 z-50 grid h-[4.5rem] grid-cols-[1fr_auto] items-center border-b border-white/12 bg-[#11110f] px-5 text-white sm:px-8 lg:grid-cols-[1fr_auto_1fr]">
	<a href="/" class="text-base font-black text-white no-underline">Act AI Studio</a>
	<nav class="hidden items-center gap-8 text-[0.95rem] font-bold text-white/58 lg:flex" aria-label="Contact page navigation">
		<a class="text-current no-underline transition hover:text-white" href="/">Home</a>
		<a class="text-current no-underline transition hover:text-white" href="/#results">Results</a>
		<a class="text-current no-underline transition hover:text-white" href="/#direction">About us</a>
		<a class="text-current no-underline transition hover:text-white" href="/sitemap">Site map</a>
	</nav>
	<a class="inline-flex h-11 items-center justify-center justify-self-end rounded-lg bg-[#dfff42] px-3 text-xs font-bold text-black no-underline transition hover:bg-white sm:px-5 sm:text-sm" href={bookingHref}>REQUEST A 30-MINUTE CALL</a>
</header>
