---
interface Props { mode?: "contact" | "call" }
const { mode = "contact" } = Astro.props;
const isCall = mode === "call";
const contactSteps = [
	{ number: "01", title: "We read your message", copy: "We look at your question, the business context and what you need from us." },
	{ number: "02", title: "We reply directly", copy: "A member of our team responds with a useful answer or the questions needed to understand more." },
	{ number: "03", title: "We agree the next step", copy: "If a conversation would help, we'll arrange one. If it wouldn't, we'll say so clearly." },
];
const callSteps = [
	{ number: "01", title: "We read your note", copy: "We look at the business context, the pressure you are trying to resolve and what you need AI to make possible." },
	{ number: "02", title: "30-minute conversation", copy: "We talk through where time, consistency or control is being lost and whether AI is the right route." },
	{ number: "03", title: "Clear next step", copy: "You leave with a recommendation: what to explore, what to avoid and what needs to be scoped next." },
];
const nextSteps = isCall ? callSteps : contactSteps;
const options = isCall
	? ["AI direction", "Agent diagnostic", "Agent delivery", "Not sure yet"]
	: ["Agent in the Room", "AI direction", "Agent delivery", "Something else"];
const buttonLabel = isCall ? "Send call request" : "Send message";
---

<section class="bg-[#ebe9e4] px-5 py-20 text-[#11110f] sm:px-8 lg:px-10 lg:py-28">
	<div class="mx-auto grid min-w-0 max-w-[88rem] gap-16 lg:grid-cols-[1.08fr_0.82fr] lg:items-start">
		<form class="min-w-0 rounded-lg border border-black/10 bg-[#f6f4ef] p-6 sm:p-9 lg:p-11" action="/api/contact" method="post" data-contact-page-form>
			<div class="mb-10 flex items-end justify-between gap-6 border-b border-black/12 pb-7">
				<div>
					<p class="text-sm font-bold uppercase tracking-[0.12em] text-[#77736a]">{isCall ? "Start the conversation" : "Send us a message"}</p>
					<h2 class="mt-3 text-[clamp(1.8rem,3vw,2.7rem)] font-bold leading-none">{isCall ? "Request a 30-minute call" : "How can we help?"}</h2>
				</div>
				<span class="hidden h-3 w-3 rounded-full bg-[#dfff42] sm:block" aria-hidden="true"></span>
			</div>

			<div class="grid gap-5 sm:grid-cols-2">
				<label class="grid min-w-0 gap-2 text-sm font-bold">Full name <span class="sr-only">required</span><input class="min-h-13 min-w-0 w-full rounded-lg border border-black/15 bg-white px-4 text-base font-bold outline-none transition focus:border-black" name="name" autocomplete="name" placeholder="Your name" required /></label>
				<label class="grid min-w-0 gap-2 text-sm font-bold">Job title <span class="sr-only">required</span><input class="min-h-13 min-w-0 w-full rounded-lg border border-black/15 bg-white px-4 text-base font-bold outline-none transition focus:border-black" name="role" autocomplete="organization-title" placeholder="e.g. COO, director, founder" required /></label>
				<label class="grid min-w-0 gap-2 text-sm font-bold">Company <span class="sr-only">required</span><input class="min-h-13 min-w-0 w-full rounded-lg border border-black/15 bg-white px-4 text-base font-bold outline-none transition focus:border-black" name="company" autocomplete="organization" placeholder="Company name" required /></label>
				<label class="grid min-w-0 gap-2 text-sm font-bold">Work email <span class="sr-only">required</span><input class="min-h-13 min-w-0 w-full rounded-lg border border-black/15 bg-white px-4 text-base font-bold outline-none transition focus:border-black" name="email" type="email" autocomplete="email" placeholder="you@company.com" required /></label>
			</div>

			<label class="mt-5 grid gap-2 text-sm font-bold">{isCall ? "Where should we start?" : "What is your enquiry about?"}
				<select class="min-h-13 min-w-0 w-full rounded-lg border border-black/15 bg-white px-4 text-base font-bold outline-none transition focus:border-black" name="starting-point" required>
					<option value="" selected disabled>Select the closest fit</option>
					{options.map((option) => <option>{option}</option>)}
				</select>
			</label>

			<label class="mt-5 grid gap-2 text-sm font-bold">{isCall ? "What would you like to discuss?" : "Your message"}
				<textarea class="min-h-[9rem] min-w-0 w-full resize-y rounded-lg border border-black/15 bg-white p-4 text-base font-bold outline-none transition focus:border-black" name="details" placeholder={isCall ? "Tell us what is taking too long, where work is stuck, or what you need AI to make clearer." : "Tell us what you'd like to discuss and include any useful context."} required></textarea>
			</label>

			<label class="contact-honeypot" aria-hidden="true">Website<input name="website" type="text" tabindex="-1" autocomplete="off" /></label>

			<button class="action-pill mt-7 inline-flex h-13 w-full items-center justify-center bg-[#11110f] px-6 text-sm font-bold text-white transition hover:bg-[#dfff42] hover:text-black disabled:cursor-wait disabled:opacity-65" type="submit" data-contact-submit data-default-label={buttonLabel}>{buttonLabel}</button>
			<p class="mt-4 text-center text-sm font-bold" data-contact-status aria-live="polite"></p>
			<p class="mt-4 text-center text-sm font-bold text-[#89857d]">{isCall ? "No commitment required." : "Your details are used only to respond to your enquiry."}</p>
		</form>

		<aside class="grid gap-12">
			<div>
				<p class="mb-7 text-sm font-bold uppercase tracking-[0.14em] text-[#77736a]">What happens next</p>
				<div class="grid">
					{nextSteps.map((step) => (
						<div class="grid grid-cols-[3rem_1fr] gap-5 border-t border-black/14 py-7 first:border-t-0 first:pt-0">
							<span class="grid h-10 w-10 place-items-center rounded-lg bg-[#dfff42] text-xs font-bold">{step.number}</span>
							<div><h3 class="text-[1.1rem] font-bold leading-tight">{step.title}</h3><p class="mt-3 font-bold leading-[1.4] text-[#77736a]">{step.copy}</p></div>
						</div>
					))}
				</div>
			</div>

			<div class="border-t border-black/20 pt-7">
				<p class="text-sm font-bold uppercase tracking-[0.14em] text-[#77736a]">Direct contact</p>
				<dl class="mt-7 grid gap-6 font-bold">
					<div class="grid gap-2"><dt class="text-sm text-[#77736a]">Email</dt><dd><a class="text-[#11110f] underline decoration-black/25 underline-offset-4 hover:decoration-black" href="mailto:hello@actai.studio">hello@actai.studio</a></dd></div>
				</dl>
			</div>

			<p class="border-l-4 border-[#dfff42] pl-5 font-bold leading-[1.4] text-[#5f5b54]">{isCall ? "No sales deck and no automated follow-up sequence. If we're not the right fit, we'll say so." : "If we're not the right fit, we'll say so and point you in the right direction."}</p>
		</aside>
	</div>
</section>

<style>
	.contact-honeypot {
		position: absolute;
		left: -10000px;
		width: 1px;
		height: 1px;
		overflow: hidden;
	}
</style>

<script>
	const form = document.querySelector<HTMLFormElement>("[data-contact-page-form]");
	const submitButton = form?.querySelector<HTMLButtonElement>("[data-contact-submit]");
	const status = form?.querySelector<HTMLElement>("[data-contact-status]");

	form?.addEventListener("submit", async (event) => {
		event.preventDefault();
		if (!submitButton || !status) return;

		submitButton.disabled = true;
		submitButton.textContent = "SENDING...";
		status.textContent = "";

		try {
			const response = await fetch(form.action, {
				method: "POST",
				body: new FormData(form),
				headers: { Accept: "application/json" },
			});
			const result = await response.json();

			if (!response.ok || !result.ok) {
				throw new Error(result.message || "We could not send your note.");
			}

			form.reset();
			status.className = "mt-4 text-center text-sm font-bold text-[#315c00]";
			status.textContent = result.message;
		} catch (error) {
			const message = error instanceof Error ? error.message : "We could not send your note.";
			status.className = "mt-4 text-center text-sm font-bold text-[#9f2626]";
			status.replaceChildren(document.createTextNode(`${message} Email `));
			const emailLink = document.createElement("a");
			emailLink.href = "mailto:hello@actai.studio";
			emailLink.textContent = "hello@actai.studio";
			emailLink.className = "underline";
			status.append(emailLink, ".");
		} finally {
			submitButton.disabled = false;
			submitButton.textContent = submitButton.dataset.defaultLabel || "Send message";
		}
	});
</script>
