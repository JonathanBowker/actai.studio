---
interface Props { agent: any; zipHref: string; packBase: string; bookingHref: string }
const { agent, zipHref, packBase, bookingHref } = Astro.props;
---
<section id="pack" class="pack stack-panel">
	<div class="pack__inner">
		<header class="pack__header reveal">
			<p class="section-label">Self-help pack</p>
			<h2>Put the problem to the test.</h2>
		</header>
		<div class="pack__contents">
			<article class="pack-item reveal"><span>01 / Frame</span><h3>A short cover note that names the issue.</h3></article>
			<article class="pack-item reveal"><span>02 / Diagnose</span><h3>A diagnostic prompt to run in your assistant.</h3></article>
			<article class="pack-item reveal"><span>03 / Question</span><h3>Agent knowledge for the follow-up conversation.</h3></article>
		</div>
		<div class="gate-workspace">
			<div class="gate-workspace__copy reveal">
				<h2>One knowledge pack. Ready for your assistant.</h2>
				<p>Share your details and download one compressed pack containing the complete diagnosis.</p>
				<div class="delivery-note">
					<strong>Load it in two ways.</strong>
					<p>Upload the ZIP directly if your assistant supports ZIP files. Otherwise, unzip it and upload the three files together.</p>
				</div>
			</div>
			<div class="gate-surface reveal">
				<form class="gate-form" data-pack-gate data-agent-slug={agent.id}>
					<div class="gate-fields">
						<label class="gate-label"><span>Name</span><input class="gate-input" name="name" autocomplete="name" required /></label>
						<label class="gate-label"><span>Email</span><input class="gate-input" name="email" type="email" autocomplete="email" required /></label>
					</div>
					<label class="gate-checkbox"><input name="consent" type="checkbox" required /><span>I consent to Act AI Studio contacting me about this diagnostic pack and related AI direction.</span></label>
					<p class="gate-privacy">We use these details to exchange the self-help pack for contact permission. Read the <a href="/privacy">privacy notice</a>.</p>
					<button class="action-pill agent-button agent-button--unlock" type="submit">Unlock the pack</button>
				</form>
				<div class="unlock-panel" data-pack-unlock hidden>
					<p>Your compressed ZIP pack is ready.</p>
					<div class="unlock-panel__actions">
						<a class="action-pill agent-button agent-button--download" href={zipHref} download data-pack-download>Download ZIP pack</a>
						<button class="action-pill agent-button" type="button" data-open-tool="claude" data-pack-base={packBase}>Open in Claude</button>
						<button class="action-pill agent-button" type="button" data-open-tool="chatgpt" data-pack-base={packBase}>Open in ChatGPT</button>
					</div>
					<p data-tool-note>Upload the ZIP directly where supported. If it is not accepted, unzip it and upload cover.md, prompt.md and agent-knowledge.md together. The assistant buttons also copy the pack text before opening a new chat.</p>
				</div>
			</div>
		</div>
		<footer class="agent-footer">
			<div>
				<p>© 2026 Advanced Analytica Limited. All Rights Reserved.</p>
			</div>
			<a class="action-pill agent-nav__link agent-nav__link--primary" href={bookingHref}>REQUEST A 30-MINUTE CALL</a>
		</footer>
	</div>
</section>
