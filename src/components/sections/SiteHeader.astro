---
interface Props { showContactLink?: boolean; theme?: "light" | "dark" }
const { showContactLink = true, theme = "light" } = Astro.props;
---

<header class="nav-pill glass" data-site-header data-has-contact={String(showContactLink)} data-theme={theme}>
	<a href="/" class="site-brand" aria-label="Act AI Studio home">
		<img src="/act-logo.svg" alt="Act AI Studio" />
	</a>
	<nav class="site-menu" data-menu-panel data-open="false" aria-label="Main menu">
		<div>
			<div class="site-menu-links">
				<a class="site-menu-link" href="/#opportunity">The opportunity</a>
				<a class="site-menu-link" href="/#stages">The method</a>
				<a class="site-menu-link" href="/#practice">The practice</a>
				<a class="site-menu-link" href="/#governance">The governance</a>
				<a class="site-menu-link" href="/#direction">The direction</a>
				<a class="site-menu-link" href="/#footer">The company</a>
				{showContactLink && <a class="action-pill site-menu-link site-menu-contact" href="/meeting">Request a 30-minute call</a>}
			</div>
		</div>
	</nav>
	{showContactLink && <a class="action-pill site-contact-link" href="/meeting">Request a 30-minute call</a>}
	<button class="action-pill menu-toggle" type="button" aria-label="Open menu" aria-expanded="false" data-menu-toggle>
		<span class="menu-icon" data-menu-icon data-open="false" aria-hidden="true"></span>
	</button>
</header>

<style>
	.nav-pill {
		align-items: center;
		background: rgba(245, 245, 245, 0.98);
		border-bottom: 1px solid rgba(16, 16, 16, 0.08);
		box-shadow: 0 10px 30px rgba(0, 0, 0, 0.08);
		color: #101010;
		display: grid;
		grid-template-columns: auto 1fr auto;
		height: var(--header-height);
		left: 0;
		position: fixed;
		right: 0;
		top: 0;
		z-index: 50;
	}

	.site-brand {
		align-items: center;
		align-self: stretch;
		background: transparent;
		display: flex;
		justify-self: start;
		min-width: 14.25rem;
		padding: 0 0 0 3.75rem;
	}

	.site-brand img {
		filter: brightness(0);
		width: 10.5rem;
	}

	.site-menu {
		display: flex;
		justify-content: flex-start;
	}

	.site-menu-links {
		align-items: center;
		display: flex;
		gap: clamp(1rem, 2.4vw, 3.25rem);
		justify-content: flex-start;
		padding: 0 0 0 3.875rem;
		white-space: nowrap;
	}

	.site-menu-link {
		border-radius: 9999px;
		color: #101010;
		font-size: clamp(1rem, 1.3vw, 1.5625rem);
		font-weight: 600;
		padding: 0.5rem 0;
		text-decoration: none;
		transition: background 160ms ease, color 160ms ease;
	}

	.site-menu-link:hover,
	.site-menu-link:focus-visible {
		background: transparent;
		color: #101010;
		outline: 2px solid #101010;
		outline-offset: 5px;
	}

	.site-menu-contact { display: none; }

	.site-contact-link {
		align-items: center;
		background: transparent;
		border: 2px solid #101010;
		border-radius: 9999px;
		color: #11110f;
		display: inline-flex;
		font-weight: 700;
		font-size: clamp(1rem, 1.3vw, 1.5625rem);
		height: 4.375rem;
		justify-content: center;
		justify-self: end;
		margin-right: 3.75rem;
		padding: 0 2rem;
		text-decoration: none;
		transition: background 180ms ease;
		width: clamp(18rem, 21.77vw, 26.125rem);
	}

	.site-contact-link:hover,
	.site-contact-link:focus-visible {
		background: #dfff42;
		outline: 2px solid #101010;
		outline-offset: 2px;
	}

	.menu-toggle {
		align-items: center;
		background: transparent;
		border: 1px solid rgba(16, 16, 16, 0.2);
		border-radius: 9999px;
		color: #101010;
		display: none;
		height: 2.75rem;
		justify-content: center;
		justify-self: end;
		margin-right: 1.25rem;
		width: 2.75rem;
	}

	.menu-toggle:focus-visible {
		outline: 2px solid #101010;
		outline-offset: 2px;
	}

	.menu-icon,
	.menu-icon::before,
	.menu-icon::after {
		background: currentColor;
		border-radius: 9999px;
		display: block;
		height: 2px;
		transition: transform 200ms ease, opacity 160ms ease;
		width: 14px;
	}

	.menu-icon { position: relative; }

	.menu-icon::before,
	.menu-icon::after {
		content: "";
		left: 0;
		position: absolute;
	}

	.menu-icon::before { top: -5px; }
	.menu-icon::after { top: 5px; }
	.menu-icon[data-open="true"] { background: transparent; }
	.menu-icon[data-open="true"]::before { transform: translateY(5px) rotate(45deg); }
	.menu-icon[data-open="true"]::after { transform: translateY(-5px) rotate(-45deg); }

	.nav-pill[data-theme="dark"] {
		border-color: rgba(255, 255, 255, 0.14);
		background: rgba(7, 7, 7, 0.96);
		box-shadow: none;
		color: #fff;
	}

	.nav-pill[data-theme="dark"] .site-brand img {
		filter: brightness(0) invert(1);
	}

	.nav-pill[data-theme="dark"] :is(.site-menu-link, .site-contact-link, .menu-toggle) {
		border-color: rgba(255, 255, 255, 0.72);
		color: #fff;
	}

	.nav-pill[data-theme="dark"] :is(.site-menu-link, .site-contact-link, .menu-toggle):focus-visible {
		outline-color: #fff;
	}

	@media (max-width: 1500px) {
		.nav-pill { grid-template-columns: 1fr auto; }

		.site-brand {
			min-width: 9.5rem;
			padding: 0 1.25rem;
		}

		.site-brand img { width: 5.25rem; }
		.site-contact-link { display: none; }
		.site-menu-contact { color: #101010; display: block; }

		.site-menu {
			background: rgba(245, 245, 245, 0.99);
			border-bottom: 1px solid rgba(16, 16, 16, 0.1);
			box-shadow: 0 20px 35px rgba(0, 0, 0, 0.1);
			display: grid;
			grid-column: 1 / -1;
			grid-row: 2;
			grid-template-rows: 0fr;
			left: 0;
			opacity: 0;
			pointer-events: none;
			position: absolute;
			top: 100%;
			transform: translateY(-0.5rem);
			transition: grid-template-rows 260ms cubic-bezier(0.16, 1, 0.3, 1), opacity 220ms ease, transform 260ms cubic-bezier(0.16, 1, 0.3, 1);
			width: 100%;
		}

		.nav-pill[data-theme="dark"] .site-menu {
			border-color: rgba(255, 255, 255, 0.14);
			background: rgba(7, 7, 7, 0.99);
			box-shadow: 0 20px 35px rgba(0, 0, 0, 0.35);
		}

		.site-menu[data-open="true"] {
			grid-template-rows: 1fr;
			opacity: 1;
			pointer-events: auto;
			transform: translateY(0);
		}

		.site-menu > div { overflow: hidden; }

		.site-menu-links {
			align-items: stretch;
			display: grid;
			margin: 0 auto;
			max-width: 30rem;
			padding: 0.75rem;
			white-space: normal;
		}

		.site-menu-link {
			font-size: 1rem;
			padding: 0.75rem 0.9rem;
		}

		.nav-pill > .menu-toggle {
			display: flex;
			grid-column: 2;
			grid-row: 1;
			position: relative;
			z-index: 2;
		}
	}

	@media (max-width: 760px) {
		.nav-pill { grid-template-columns: 1fr auto; }
		.nav-pill > .menu-toggle { grid-column: 2; grid-row: 1; }
	}
</style>

<script>
	document.querySelectorAll("[data-site-header]").forEach((header) => {
		if (!(header instanceof HTMLElement) || header.dataset.initialised === "true") return;
		header.dataset.initialised = "true";
		const toggle = header.querySelector("[data-menu-toggle]");
		const panel = header.querySelector("[data-menu-panel]");
		const icon = header.querySelector("[data-menu-icon]");

		const setOpen = (open: boolean) => {
			if (!(toggle instanceof HTMLElement) || !(panel instanceof HTMLElement)) return;
			panel.dataset.open = String(open);
			toggle.setAttribute("aria-expanded", String(open));
			toggle.setAttribute("aria-label", open ? "Close menu" : "Open menu");
			if (icon instanceof HTMLElement) icon.dataset.open = String(open);
		};

		toggle?.addEventListener("click", () => setOpen(panel instanceof HTMLElement && panel.dataset.open !== "true"));
		panel?.querySelectorAll("a").forEach((link) => link.addEventListener("click", () => setOpen(false)));
		document.addEventListener("click", (event) => {
			if (!(panel instanceof HTMLElement) || panel.dataset.open !== "true") return;
			if (event.target instanceof Node && !toggle?.contains(event.target) && !panel.contains(event.target)) setOpen(false);
		});
		document.addEventListener("keydown", (event) => {
			if (event.key === "Escape" && panel instanceof HTMLElement && panel.dataset.open === "true") {
				setOpen(false);
				if (toggle instanceof HTMLElement) toggle.focus();
			}
		});
	});
</script>
