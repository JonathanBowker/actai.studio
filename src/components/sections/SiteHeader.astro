---
interface Props { showContactLink?: boolean }
const { showContactLink = true } = Astro.props;
---

<header class="nav-pill glass" data-site-header data-has-contact={String(showContactLink)}>
	<a href="/" class="site-brand" aria-label="Act AI Studio home">
		<img src="/act-logo.svg" alt="Act AI Studio" />
	</a>
	<nav class="site-menu" data-menu-panel data-open="false" aria-label="Main menu">
		<div>
			<div class="site-menu-links">
				<a class="site-menu-link" href="/#agent-in-the-room">Agent in the Room</a>
				<a class="site-menu-link" href="/#process">Process</a>
				<a class="site-menu-link" href="/#practice">Use cases</a>
				<a class="site-menu-link" href="/#governance">Governance</a>
				<a class="site-menu-link" href="/#direction">Team</a>
				<a class="site-menu-link" href="/#faq">FAQ</a>
				{showContactLink && <a class="site-menu-link site-menu-contact" href="/meeting">Request a 30-minute call</a>}
			</div>
		</div>
	</nav>
	{showContactLink && <a class="site-contact-link" href="/meeting">Request a 30-minute call</a>}
	<button class="action-pill menu-toggle" type="button" aria-label="Open menu" aria-expanded="false" data-menu-toggle>
		<span class="menu-icon" data-menu-icon data-open="false" aria-hidden="true"></span>
	</button>
</header>

<style>
	.nav-pill {
		align-items: center;
		background: rgba(17, 17, 15, 0.96);
		border-bottom: 1px solid rgba(255, 255, 255, 0.1);
		box-shadow: 0 10px 30px rgba(0, 0, 0, 0.08);
		color: white;
		display: grid;
		grid-template-columns: 1fr auto 1fr;
		height: 4.5rem;
		left: 0;
		position: fixed;
		right: 0;
		top: 0;
		z-index: 50;
	}

	.site-brand {
		align-items: center;
		align-self: stretch;
		display: flex;
		grid-column: 2;
		grid-row: 1;
		justify-content: center;
		justify-self: center;
		padding: 0 1rem;
		position: relative;
		z-index: 2;
	}

	.site-brand img {
		filter: brightness(0) invert(1);
		width: 5.25rem;
	}

	.site-menu {
		background: rgba(17, 17, 15, 0.99);
		border-bottom: 1px solid rgba(255, 255, 255, 0.1);
		box-shadow: 0 20px 35px rgba(0, 0, 0, 0.1);
		display: grid;
		grid-column: 1 / -1;
		grid-row: 2;
		grid-template-rows: 0fr;
		left: 0;
		opacity: 0;
		pointer-events: none;
		position: absolute;
		top: 100%;
		transform: translateY(-0.5rem);
		transition: grid-template-rows 260ms cubic-bezier(0.16, 1, 0.3, 1), opacity 220ms ease, transform 260ms cubic-bezier(0.16, 1, 0.3, 1);
		width: 100%;
	}

	.site-menu[data-open="true"] {
		grid-template-rows: 1fr;
		opacity: 1;
		pointer-events: auto;
		transform: translateY(0);
	}

	.site-menu > div { overflow: hidden; }

	.site-menu-links {
		align-items: stretch;
		display: grid;
		margin: 0 auto;
		max-width: 30rem;
		padding: 0.75rem;
	}

	.site-menu-link {
		border-radius: 9999px;
		color: rgba(255, 255, 255, 0.66);
		font-size: 1rem;
		font-weight: 600;
		padding: 0.75rem 0.9rem;
		text-decoration: none;
		transition: background 160ms ease, color 160ms ease;
	}

	.site-menu-link:hover,
	.site-menu-link:focus-visible {
		background: rgba(255, 255, 255, 0.1);
		color: white;
		outline: 2px solid transparent;
	}

	.site-menu-contact { color: white; }

	.site-contact-link {
		align-items: center;
		background: white;
		border-radius: 9999px;
		color: #11110f;
		display: none;
		font-weight: 700;
		height: 3rem;
		justify-content: center;
		padding: 0 1.25rem;
		text-decoration: none;
		transition: background 180ms ease;
	}

	.site-contact-link:hover,
	.site-contact-link:focus-visible {
		background: #dfff42;
		outline: 2px solid white;
		outline-offset: 2px;
	}

	.menu-toggle {
		align-items: center;
		background: transparent;
		border: 1px solid rgba(255, 255, 255, 0.15);
		border-radius: 9999px;
		color: white;
		display: flex;
		grid-column: 3;
		grid-row: 1;
		height: 2.75rem;
		justify-content: center;
		justify-self: end;
		margin-right: 1rem;
		position: relative;
		width: 2.75rem;
		z-index: 2;
	}

	.menu-toggle:focus-visible {
		outline: 2px solid white;
		outline-offset: 2px;
	}

	.menu-icon,
	.menu-icon::before,
	.menu-icon::after {
		background: currentColor;
		border-radius: 9999px;
		display: block;
		height: 2px;
		transition: transform 200ms ease, opacity 160ms ease;
		width: 14px;
	}

	.menu-icon { position: relative; }

	.menu-icon::before,
	.menu-icon::after {
		content: "";
		left: 0;
		position: absolute;
	}

	.menu-icon::before { top: -5px; }
	.menu-icon::after { top: 5px; }
	.menu-icon[data-open="true"] { background: transparent; }
	.menu-icon[data-open="true"]::before { transform: translateY(5px) rotate(45deg); }
	.menu-icon[data-open="true"]::after { transform: translateY(-5px) rotate(-45deg); }

	/* Remove this block to retain the centred mobile header only. */
	@media (min-width: 1051px) {
		.nav-pill { grid-template-columns: 1fr auto 1fr; }

		.site-menu {
			background: transparent;
			border: 0;
			box-shadow: none;
			display: flex;
			grid-column: 1;
			grid-row: 1;
			justify-self: end;
			opacity: 1;
			pointer-events: auto;
			position: static;
			transform: none;
			width: auto;
		}

		.site-menu > div { overflow: visible; }

		.site-menu-links {
			align-items: center;
			display: flex;
			justify-content: flex-end;
			max-width: none;
			padding: 0;
			white-space: nowrap;
		}

		.site-menu-link {
			font-size: clamp(0.72rem, 1vw, 1rem);
			padding: 0.7rem clamp(0.35rem, 0.6vw, 0.9rem);
		}

		.site-menu-contact { display: none; }

		.site-contact-link {
			display: inline-flex;
			grid-column: 3;
			grid-row: 1;
			justify-self: end;
			margin-right: 2rem;
		}

		.menu-toggle { display: none; }
	}
</style>

<script>
	document.querySelectorAll("[data-site-header]").forEach((header) => {
		if (!(header instanceof HTMLElement) || header.dataset.initialised === "true") return;
		header.dataset.initialised = "true";
		const toggle = header.querySelector("[data-menu-toggle]");
		const panel = header.querySelector("[data-menu-panel]");
		const icon = header.querySelector("[data-menu-icon]");

		const setOpen = (open: boolean) => {
			if (!(toggle instanceof HTMLElement) || !(panel instanceof HTMLElement)) return;
			panel.dataset.open = String(open);
			toggle.setAttribute("aria-expanded", String(open));
			toggle.setAttribute("aria-label", open ? "Close menu" : "Open menu");
			if (icon instanceof HTMLElement) icon.dataset.open = String(open);
		};

		toggle?.addEventListener("click", () => setOpen(panel instanceof HTMLElement && panel.dataset.open !== "true"));
		panel?.querySelectorAll("a").forEach((link) => link.addEventListener("click", () => setOpen(false)));
		document.addEventListener("click", (event) => {
			if (!(panel instanceof HTMLElement) || panel.dataset.open !== "true") return;
			if (event.target instanceof Node && !toggle?.contains(event.target) && !panel.contains(event.target)) setOpen(false);
		});
		document.addEventListener("keydown", (event) => {
			if (event.key === "Escape" && panel instanceof HTMLElement && panel.dataset.open === "true") {
				setOpen(false);
				if (toggle instanceof HTMLElement) toggle.focus();
			}
		});
	});
</script>
