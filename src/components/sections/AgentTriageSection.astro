---
interface Props { triageAgents: any[]; triageRows: any[][]; useCaseArt: string[] }
const { triageAgents, triageRows, useCaseArt } = Astro.props;
---
<section id="triage" class="stack-panel bg-[#f6f4ef] px-4 pb-32 pt-32 text-[#11110f] sm:px-8 lg:px-10 lg:pb-44 lg:pt-36">
				<div class="mx-auto grid max-w-[96rem] gap-12 px-5 sm:px-8 lg:grid-cols-[0.78fr_1.22fr] lg:items-start lg:gap-16 lg:px-10">
					<div class="reveal lg:sticky lg:top-28 lg:pt-6">
						<p class="w-fit rounded-lg bg-black/5 px-4 py-3 text-[1rem] font-bold text-[#77736a]">Agent triage</p>
						<h2 class="mt-12 max-w-[17ch] text-[clamp(2.3rem,4vw,4.6rem)] font-bold leading-[0.98] text-[#11110f]">
							Where is time being spent where it shouldn't be?
						</h2>
						<p class="mt-10 max-w-[22ch] text-[clamp(1.5rem,2.2vw,2.25rem)] font-bold leading-[1.08] text-[#8a8781]">
							<span class="mr-1 inline-block rounded-md bg-white px-2 py-1 text-[#11110f]">Start with the pain.</span>
							Each example opens a diagnostic page and
							<span class="mx-1 inline-block rounded-md bg-white px-2 py-1 text-[#11110f]">self-help pack</span>
							you can run in your own assistant.
						</p>
					</div>

					<div class="triage-vertical-grid grid h-[38rem] grid-cols-2 gap-x-4 overflow-hidden sm:gap-x-5 lg:h-[42rem]" aria-label="Agent triage examples">
						{triageRows.map((column, columnIndex) => (
							<div class="triage-vertical-column grid h-[36rem] gap-7 overflow-y-auto pb-16 sm:gap-8 lg:h-[40rem]" data-sector-column aria-label={`Agent triage column ${columnIndex + 1}`}>
								{[...column, ...column].map(({ agent, index }, itemIndex) => (
									<article class="use-case-card triage-card triage-vertical-card" style={`--case-tilt: ${index % 2 === 0 ? "-5deg" : "5deg"}`} aria-hidden={itemIndex >= column.length ? "true" : undefined}>
										<div class="use-case-shell relative overflow-hidden rounded-[1.55rem] p-4 sm:p-5">
											<img class="use-case-art-image absolute inset-0 h-full w-full object-cover" src={useCaseArt[index % useCaseArt.length]} alt="" />
											<div class="use-case-texture"></div>
											<div class="use-case-content relative px-5 py-5 text-center sm:px-6 sm:py-6">
												<div class="use-case-kicker flex items-center justify-between gap-4 text-white/82">
													<p class="text-[0.7rem] font-bold uppercase tracking-[0.14em]">Example</p>
													<p class="use-case-nav rounded-full px-3 py-1.5 text-[0.72rem] font-bold tabular-nums">{(index + 1).toString().padStart(2, "0")} / {triageAgents.length.toString().padStart(2, "0")}</p>
												</div>
												<div class="use-case-heading mx-auto grid max-w-[18rem] justify-items-center">
													<h3 class="use-case-title font-bold text-white">{agent.data.nerve}</h3>
												</div>
												<div class="use-case-detail triage-detail mx-auto w-full max-w-[17.5rem] rounded-[1.05rem] p-3 text-left">
													<p class="text-[0.88rem] font-bold leading-[1.28] text-white/84">{agent.data.cardCopy}</p>
													<a href={`/agents/${agent.id}`} class="action-pill triage-action inline-flex min-h-11 w-full items-center justify-center px-4 text-center text-[0.9rem] font-bold no-underline transition" data-agent-card-click={agent.id} tabindex={itemIndex >= column.length ? "-1" : undefined}>That sounds like me</a>
												</div>
											</div>
										</div>
									</article>
								))}
							</div>
						))}
					</div>

					<div class="use-case-track triage-mobile-track gap-6 overflow-x-auto pr-[12vw]" data-triage-mobile-track>
						{triageAgents.map((agent, index) => (
							<article class="use-case-card triage-card w-[min(86vw,31rem)] shrink-0" style={`--case-tilt: ${index % 2 === 0 ? "-5deg" : "5deg"}`}>
								<div class="use-case-shell relative overflow-hidden rounded-[1.55rem] p-4 sm:p-5">
									<img class="use-case-art-image absolute inset-0 h-full w-full object-cover" src={useCaseArt[index % useCaseArt.length]} alt="" />
									<div class="use-case-texture"></div>
									<div class="use-case-content relative px-5 py-5 text-center sm:px-6 sm:py-6">
										<div class="use-case-kicker flex items-center justify-between gap-4 text-white/82">
											<p class="text-[0.7rem] font-bold uppercase tracking-[0.14em]">Example</p>
											<p class="use-case-nav rounded-full px-3 py-1.5 text-[0.72rem] font-bold tabular-nums">{(index + 1).toString().padStart(2, "0")} / {triageAgents.length.toString().padStart(2, "0")}</p>
										</div>
										<div class="use-case-heading mx-auto grid max-w-[18rem] justify-items-center"><h3 class="use-case-title font-bold text-white">{agent.data.nerve}</h3></div>
										<div class="use-case-detail triage-detail mx-auto w-full max-w-[17.5rem] rounded-[1.05rem] p-3 text-left">
											<p class="text-[0.88rem] font-bold leading-[1.28] text-white/84">{agent.data.cardCopy}</p>
											<a href={`/agents/${agent.id}`} class="action-pill triage-action inline-flex min-h-11 w-full items-center justify-center px-4 text-center text-[0.9rem] font-bold no-underline transition" data-agent-card-click={agent.id}>That sounds like me</a>
										</div>
									</div>
								</div>
							</article>
						))}
					</div>
				</div>
			</section>
