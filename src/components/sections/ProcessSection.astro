---
interface Props { featureTabs: any[]; bookingHref: string }
const { featureTabs, bookingHref } = Astro.props;
---
<section id="process" class="feature-panel stack-panel px-4 pb-28 pt-24 text-white sm:px-8 lg:px-10 lg:pb-36">
				<div class="mx-auto grid max-w-[74rem] gap-12 lg:grid-cols-[0.72fr_1fr] lg:items-center">
					<aside>
						<div class="grid gap-14">
							<div>
								<h2 class="max-w-[16ch] text-[clamp(2.45rem,3.45vw,3.45rem)] font-normal leading-[0.98]">
									Build AI around your business.
								</h2>
								<p class="mt-5 max-w-[22rem] text-[1.05rem] font-bold leading-tight text-white/58">
									Start with one step. Prove it works. Then decide what's next.
								</p>
								<div class="mt-10 grid w-full gap-5">
									{featureTabs.map((item, index) => (
										<button
											type="button"
											class="feature-index flex w-full items-start gap-5 rounded-xl px-6 py-5 text-left font-bold transition hover:bg-black/42 hover:text-white"
											data-feature-nav={index}
											data-feature-target={`feature-${index}`}
											data-active={index === 0 ? "true" : "false"}
											aria-pressed={index === 0 ? "true" : "false"}
										>
											<span class="grid h-8 w-8 shrink-0 place-items-center rounded-lg bg-white/8 text-[0.82rem] text-white/52">{item.number}</span>
											<span class="grid gap-1.5">
												<span class="text-[1.16rem] leading-tight">{item.label}</span>
												<span class="text-[0.88rem] leading-tight text-white/48">{item.navHint}</span>
											</span>
										</button>
									))}
								</div>
							</div>
							<div class="max-w-[18rem]">
								<p class="font-medium leading-tight">
									Finding exactly what you need.<br />
									No hidden agenda, no hype, no tech-speak.
								</p>
								<a href={bookingHref} class="mt-4 inline-flex h-12 items-center rounded-xl bg-white px-6 font-bold text-black no-underline transition hover:bg-[#dfff42]">
									BEGIN THE CONVERSATION
								</a>
							</div>
						</div>
					</aside>

					<div class="feature-window">
						<div class="feature-track grid justify-items-center gap-8 lg:gap-10" data-feature-track>
							{featureTabs.map((item, index) => (
								<article
									id={`feature-${index}`}
									class="vertical-card feature-card reveal grid content-start rounded-[1.7rem] p-6 lg:p-8 lg:pb-12"
									data-feature-card={index}
									style={`--delay: ${Math.min(index * 70, 210)}ms`}
								>
									<p class="mb-4 text-[0.82rem] font-bold text-white/42">{item.number}</p>
									<h3 class="text-[clamp(1.55rem,2.1vw,2rem)] font-bold leading-tight">{item.title}</h3>
									<p class="mt-2 text-[0.95rem] font-bold leading-tight text-white/48">{item.navHint}</p>
									<div class="mx-auto mt-6 grid h-[10.6rem] w-[min(100%,16rem)] place-items-center overflow-hidden rounded-[1.4rem] bg-black/18">
										<img class="h-full w-full object-contain" src={item.image} alt="" />
									</div>
									<p class="mt-6 text-[0.98rem] font-bold leading-[1.28] text-white/62">{item.copy}</p>
								</article>
							))}
						</div>
					</div>
				</div>
			</section>
