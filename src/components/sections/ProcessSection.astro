---
const processSteps = [
	{
		number: "01",
		name: "DISCOVER",
		copy: "Find where the business creates value and where work is getting in the way.",
	},
	{
		number: "02",
		name: "DEFINE",
		copy: "Agree the problem, the outcome and the boundaries before anything is built.",
	},
	{
		number: "03",
		name: "DIRECT",
		copy: "Give the agent the context, decisions and governance it needs to act well.",
	},
	{
		number: "04",
		name: "BUILD",
		copy: "Shape the capability around the way your business actually works.",
	},
	{
		number: "05",
		name: "RUN",
		copy: "Put it to work, review what changes and keep the whole picture current.",
	},
];
---

<section id="process" class="stack-panel bg-[#ebe9e4] px-4 pb-40 pt-24 text-[#11110f] sm:px-8 lg:px-10 lg:pb-48" data-scroll-tone-section data-scroll-tone-theme="ink">
	<div class="reveal mx-auto grid max-w-[96rem] gap-14 p-5 sm:p-8 lg:p-10">
		<div class="grid gap-8 lg:grid-cols-[0.42fr_1fr] lg:items-end lg:gap-14">
			<p class="w-fit rounded-lg bg-black/5 px-4 py-3 text-[0.9rem] font-bold text-[#77736a]">THE PROCESS</p>
			<h2 class="max-w-[18ch] text-[clamp(2.25rem,4vw,4.5rem)] font-bold leading-[0.96]" data-scroll-tone-line>
				From first question to working capability.
			</h2>
		</div>

		<ol class="grid border-y border-black/25 sm:grid-cols-5" aria-label="The Act process">
			{processSteps.map((step, index) => (
				<li class="relative grid min-h-[15rem] content-between gap-8 border-b border-black/25 py-7 sm:min-h-[19rem] sm:grid-rows-[auto_1fr] sm:content-normal sm:gap-0 sm:border-b-0 sm:border-r sm:px-5 sm:py-8 sm:last:border-r-0 lg:px-7" data-scroll-tone-line>
					<div class="flex items-center justify-between gap-4">
						<span class="text-xs font-bold">{step.number}</span>
						{index < processSteps.length - 1 && <span class="text-xl font-bold sm:hidden" aria-hidden="true">↓</span>}
					</div>
					<div class="sm:pt-28">
						<h3 class="text-[clamp(1.4rem,2vw,2rem)] font-bold leading-none">{step.name}</h3>
						<p class="mt-4 max-w-[18rem] text-[0.95rem] font-bold leading-[1.3]">{step.copy}</p>
					</div>
					{index < processSteps.length - 1 && <span class="absolute -right-3 top-8 z-10 hidden h-6 w-6 place-items-center bg-[#ebe9e4] text-lg font-bold sm:grid" aria-hidden="true">→</span>}
				</li>
			))}
		</ol>
	</div>
</section>
