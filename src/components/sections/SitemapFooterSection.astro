---
interface Props { bookingHref: string; showBookingButton?: boolean; showContactLink?: boolean; showPrivacyLink?: boolean }
const { bookingHref, showBookingButton = true, showContactLink = true, showPrivacyLink = true } = Astro.props;
---

<footer class="bg-black px-5 py-12 text-white sm:px-8 lg:px-10">
	<div class="mx-auto grid max-w-[88rem] gap-10 md:grid-cols-[1fr_auto] md:items-end">
		<div class="grid gap-5 md:grid-cols-[auto_minmax(0,32rem)] md:items-end">
			<img class="-ml-7 h-20 w-auto self-end" src="/logos/ACT_White.svg" alt="Act." />
			<div class="grid gap-3 pb-1">
				<p class="max-w-[32rem] font-bold leading-tight text-white/45">Find where time is being lost, decide what AI should do, and put it to work.</p>
				<p class="text-sm font-bold text-white/35">© 2026 Advanced Analytica Limited. All Rights Reserved.</p>
			</div>
		</div>
		<div class="flex flex-wrap items-center gap-5 font-bold">
			{showContactLink && <a class="text-white/60 no-underline transition hover:text-white" href="/contact">Contact</a>}
			{showPrivacyLink && <a class="text-white/60 no-underline transition hover:text-white" href="/privacy">Privacy</a>}
			{showBookingButton && <a class="action-pill inline-flex h-12 items-center bg-white px-5 text-sm text-black no-underline transition hover:bg-[#dfff42]" href={bookingHref}>Request a 30-minute call</a>}
		</div>
	</div>
</footer>
