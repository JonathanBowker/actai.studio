<style is:global>
	[data-scroll-tone-line] {
		color: #fff;
		opacity: var(--scroll-tone-opacity, 0);
		transform: translateY(var(--scroll-tone-lift, 0.75rem));
		transition:
			opacity 160ms linear,
			transform 160ms linear;
		will-change: opacity, transform;
	}

	[data-scroll-tone-section][data-scroll-tone-theme="ink"] [data-scroll-tone-line] {
		color: #11110f;
	}

	@media (prefers-reduced-motion: reduce) {
		[data-scroll-tone-line] {
			opacity: 1;
			transform: none;
			transition: none;
		}
	}
</style>

<script>
	const toneSections = [...document.querySelectorAll("[data-scroll-tone-section]")];
	const reducedMotion = window.matchMedia("(prefers-reduced-motion: reduce)");
	let toneFrame = 0;

	const syncScrollTones = () => {
		toneFrame = 0;
		toneSections.forEach((section) => {
			const lines = [...section.querySelectorAll("[data-scroll-tone-line]")];
			const explicitEntry = Number(section.dataset.scrollToneEntry);
			const entryPoint = Number.isFinite(explicitEntry) ? explicitEntry : 0.86;
			const revealDistance = window.innerHeight * 0.18;

			lines.forEach((line) => {
				if (!(line instanceof HTMLElement)) return;
				const block = line.closest("[data-scroll-tone-block]");
				const anchor = block instanceof HTMLElement ? block : line;
				const lineTop = anchor.getBoundingClientRect().top;
				const blockHasTitle = block instanceof HTMLElement && Boolean(block.querySelector(".section-label"));
				const isSectionTitle = line.classList.contains("section-label");
				const isHeadline = line.matches("h1, h2, h3") || Boolean(line.closest("h1, h2, h3"));
				const revealStep = block instanceof HTMLElement
					? isSectionTitle
						? 0
						: isHeadline
							? blockHasTitle ? 1 : 0
							: blockHasTitle ? 2 : 1
					: 0;
				const blockProgress = Math.max(0, Math.min(1, (window.innerHeight * entryPoint - lineTop) / revealDistance));
				const progress = block instanceof HTMLElement
					? Math.max(0, Math.min(1, (blockProgress - revealStep * 0.08) / 0.82))
					: blockProgress;
				line.style.setProperty("--scroll-tone-opacity", String(progress));
				line.style.setProperty("--scroll-tone-lift", `${((1 - progress) * 0.75).toFixed(3)}rem`);
			});
		});
	};

	if (!reducedMotion.matches && toneSections.length) {
		window.addEventListener("scroll", () => {
			if (toneFrame) return;
			toneFrame = window.requestAnimationFrame(syncScrollTones);
		}, { passive: true });
		window.addEventListener("resize", syncScrollTones, { passive: true });
		syncScrollTones();
	}
</script>
