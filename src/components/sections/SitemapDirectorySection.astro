---
interface SitemapLink { label: string; href: string; note?: string }
interface SitemapGroup { label: string; links: SitemapLink[]; wide?: boolean }
interface Props { groups: SitemapGroup[] }
const { groups } = Astro.props;
---

<section class="bg-[#f6f4ef] px-5 py-20 text-[#11110f] sm:px-8 lg:px-10 lg:py-28">
	<div class="mx-auto max-w-[88rem]">
		<div class="mb-14 grid gap-6 border-b border-black/15 pb-10 lg:grid-cols-[0.75fr_1.25fr]">
			<p class="text-sm font-bold uppercase tracking-[0.12em] text-[#77736a]">Everything in one place</p>
			<h2 class="max-w-[17ch] text-[clamp(2.4rem,5vw,5rem)] font-bold leading-[0.94]">Find the page you need.</h2>
		</div>

		<div class="grid gap-x-12 gap-y-16 lg:grid-cols-2">
			{groups.map((group) => (
				<section id={group.label === "Agent diagnostics" ? "agent-diagnostics" : undefined} class:list={["border-t border-black/20 pt-6", group.wide && "lg:col-span-2"]}>
					<div class:list={["grid gap-8", group.wide && "lg:grid-cols-[0.38fr_1fr]"]}>
						<h3 class="text-[1.45rem] font-bold leading-none">{group.label}</h3>
						<div class:list={["grid gap-x-10", group.wide && "md:grid-cols-2"]}>
							{group.links.map((link, index) => (
								<a class="group grid grid-cols-[2rem_1fr_auto] items-start gap-3 border-b border-black/10 py-5 text-[#11110f] no-underline transition hover:border-black hover:bg-[#dfff42] hover:px-3" href={link.href}>
									<span class="pt-0.5 text-xs font-bold tabular-nums text-[#8a877f]">{String(index + 1).padStart(2, "0")}</span>
									<span>
										<strong class="block text-[1.05rem] leading-tight">{link.label}</strong>
										{link.note && <span class="mt-1 block text-sm font-bold leading-tight text-[#77736a] group-hover:text-black/65">{link.note}</span>}
									</span>
									<span aria-hidden="true" class="text-lg leading-none">↗</span>
								</a>
							))}
						</div>
					</div>
				</section>
			))}
		</div>
	</div>
</section>
