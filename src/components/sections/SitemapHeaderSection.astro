---
interface Props { bookingHref: string }
const { bookingHref } = Astro.props;
---

<header class="sticky top-0 z-50 grid h-[4.5rem] grid-cols-[1fr_auto] items-center border-b border-black/10 bg-[#f6f4ef]/95 px-5 backdrop-blur-xl sm:px-8 lg:grid-cols-[1fr_auto_1fr]">
	<a href="/" class="text-base font-black text-[#11110f] no-underline">ACTAI.STUDIO</a>
	<nav class="hidden items-center gap-8 text-[0.95rem] font-bold text-[#67645e] lg:flex" aria-label="Sitemap navigation">
		<a class="text-current no-underline transition hover:text-black" href="/">Home</a>
		<a class="text-current no-underline transition hover:text-black" href="/#results">Results</a>
		<a class="text-current no-underline transition hover:text-black" href="/#direction">About us</a>
		<a class="text-current no-underline transition hover:text-black" href="/contact">Contact</a>
	</nav>
	<a class="inline-flex h-11 items-center justify-center justify-self-end rounded-lg bg-[#11110f] px-5 text-sm font-bold text-white no-underline transition hover:bg-[#dfff42] hover:text-black" href={bookingHref}>BEGIN THE CONVERSATION</a>
</header>
