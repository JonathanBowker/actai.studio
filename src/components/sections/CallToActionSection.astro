---
interface Props { bookingHref: string }
const { bookingHref } = Astro.props;
---

<section class="stack-panel relative isolate min-h-[48rem] overflow-hidden px-6 py-16 text-white sm:px-10 lg:min-h-[58rem] lg:px-16 lg:py-20">
	<img
		class="absolute inset-0 -z-20 h-full w-full object-cover object-center"
		src="/images/hero-distorted-portrait.png"
		alt=""
		loading="lazy"
	/>
	<div class="absolute inset-0 -z-10 bg-black/15" aria-hidden="true"></div>

	<div class="reveal mx-auto grid min-h-[38rem] max-w-[96rem] content-start justify-items-center text-center lg:min-h-[48rem]">
		<p class="rounded-lg border border-white/80 bg-black/5 px-8 py-4 text-sm font-bold text-white backdrop-blur-[2px] sm:min-w-[23rem] sm:text-base">
			THE CONVERSATION
		</p>

		<h2 class="section-headline mt-16 text-[clamp(2.75rem,5vw,5rem)] text-white sm:mt-20">
			Let's talk agents.
		</h2>

		<div class="mt-44 grid justify-items-center gap-14 sm:mt-52">
			<h3 class="max-w-[34ch] text-[clamp(1.65rem,2.7vw,2.6rem)] font-bold leading-[1.1] tracking-[-0.025em] text-white">
				Talk to us, and find the value AI can deliver.
			</h3>
			<p class="max-w-[42rem] text-[clamp(1rem,1.45vw,1.35rem)] font-bold leading-[1.35] text-white">
				Request a 30-minute call with our directors to find where AI can create value for your business.
			</p>
			<a href={bookingHref} class="action-pill inline-flex min-h-12 w-full max-w-[23rem] items-center justify-center bg-white px-8 py-3 font-bold text-black no-underline transition hover:bg-[#dfff42]">
				Request a 30-minute call
			</a>
		</div>
	</div>
</section>
