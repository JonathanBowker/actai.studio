---
interface Props { bookingHref: string }
const { bookingHref } = Astro.props;
---
<section class="stack-panel overflow-hidden bg-[radial-gradient(circle_at_42%_10%,rgba(255,130,0,0.95),rgba(255,83,16,0.92)_26%,rgba(117,28,31,0.98)_78%),linear-gradient(120deg,#e60026,#ff6a00_45%,#6d1b21)] px-4 py-16 text-white sm:px-8 lg:px-10 lg:py-20">
					<div class="mx-auto grid max-w-[96rem] gap-12 p-5 sm:p-8 lg:grid-cols-8 lg:items-center lg:gap-x-6 lg:p-10">
						<div class="reveal grid content-center gap-7 lg:col-span-3 lg:col-start-2">
							<p class="w-fit rounded-lg bg-white/16 px-4 py-3 text-[0.9rem] font-bold text-white/82">THE CONVERSATION</p>
							<div class="grid gap-5">
								<h2 class="max-w-[16ch] text-left text-[clamp(2.2rem,4vw,4.25rem)] font-bold tracking-[-0.025em]">
									Talk to us, and find the value AI can deliver.
								</h2>
								<p class="max-w-[38rem] text-[clamp(1rem,1.35vw,1.25rem)] font-bold leading-[1.35] text-white/78">
									Request a 30-minute call with our directors to find where AI can create value for your business.
								</p>
							</div>
							<a href={bookingHref} class="action-pill inline-flex h-12 w-full items-center justify-center bg-white px-7 font-bold text-black no-underline transition hover:bg-[#dfff42] sm:w-fit">
								Request a 30-minute call
							</a>
						</div>
						<div class="reveal cta-line grid justify-start gap-0 text-[clamp(3.6rem,8.2vw,8.2rem)] font-bold leading-[0.86] tracking-[0] lg:col-span-3 lg:col-start-5 lg:justify-end">
							<div class="flex items-center gap-[0.12em]">
								<span>Let's</span>
								<svg class="cta-pill h-[0.9em] w-[0.9em]" viewBox="0 0 64 64" aria-hidden="true">
									<defs>
										<linearGradient id="cta-star-gradient-a" x1="4" x2="60" y1="4" y2="60" gradientUnits="userSpaceOnUse">
											<stop stop-color="#e60026" />
											<stop offset="0.48" stop-color="#ff6a00" />
											<stop offset="1" stop-color="#6d1b21" />
										</linearGradient>
									</defs>
									<path fill="url(#cta-star-gradient-a)" d="M31.7 3.5c1 0 1.8.6 2.1 1.5l5.5 17.1c.2.7.8 1.3 1.5 1.5L58 29.1c.9.3 1.5 1.1 1.5 2.1s-.6 1.8-1.5 2.1l-17.2 5.5c-.7.2-1.3.8-1.5 1.5l-5.5 17.2c-.3.9-1.1 1.5-2.1 1.5s-1.8-.6-2.1-1.5l-5.5-17.2c-.2-.7-.8-1.3-1.5-1.5L5.5 33.3c-.9-.3-1.5-1.1-1.5-2.1s.6-1.8 1.5-2.1l17.1-5.5c.7-.2 1.3-.8 1.5-1.5L29.6 5c.3-.9 1.1-1.5 2.1-1.5Z" />
									<path fill="url(#cta-star-gradient-a)" d="M49.8 4.4c.7 0 1.3.4 1.5 1.1l1.8 5.6c.1.4.4.7.8.8l5.6 1.8c.7.2 1.1.8 1.1 1.5s-.4 1.3-1.1 1.5l-5.6 1.8c-.4.1-.7.4-.8.8l-1.8 5.6c-.2.7-.8 1.1-1.5 1.1s-1.3-.4-1.5-1.1l-1.8-5.6c-.1-.4-.4-.7-.8-.8l-5.6-1.8c-.7-.2-1.1-.8-1.1-1.5s.4-1.3 1.1-1.5l5.6-1.8c.4-.1.7-.4.8-.8l1.8-5.6c.2-.7.8-1.1 1.5-1.1Z" />
								</svg>
							</div>
							<div class="flex items-center gap-[0.12em]">
								<svg class="cta-pill cta-pill-alt h-[0.9em] w-[0.9em]" viewBox="0 0 64 64" aria-hidden="true">
									<defs>
										<linearGradient id="cta-star-gradient-b" x1="4" x2="60" y1="4" y2="60" gradientUnits="userSpaceOnUse">
											<stop stop-color="#e60026" />
											<stop offset="0.48" stop-color="#ff6a00" />
											<stop offset="1" stop-color="#6d1b21" />
										</linearGradient>
									</defs>
									<path fill="url(#cta-star-gradient-b)" d="M31.7 3.5c1 0 1.8.6 2.1 1.5l5.5 17.1c.2.7.8 1.3 1.5 1.5L58 29.1c.9.3 1.5 1.1 1.5 2.1s-.6 1.8-1.5 2.1l-17.2 5.5c-.7.2-1.3.8-1.5 1.5l-5.5 17.2c-.3.9-1.1 1.5-2.1 1.5s-1.8-.6-2.1-1.5l-5.5-17.2c-.2-.7-.8-1.3-1.5-1.5L5.5 33.3c-.9-.3-1.5-1.1-1.5-2.1s.6-1.8 1.5-2.1l17.1-5.5c.7-.2 1.3-.8 1.5-1.5L29.6 5c.3-.9 1.1-1.5 2.1-1.5Z" />
									<path fill="url(#cta-star-gradient-b)" d="M49.8 4.4c.7 0 1.3.4 1.5 1.1l1.8 5.6c.1.4.4.7.8.8l5.6 1.8c.7.2 1.1.8 1.1 1.5s-.4 1.3-1.1 1.5l-5.6 1.8c-.4.1-.7.4-.8.8l-1.8 5.6c-.2.7-.8 1.1-1.5 1.1s-1.3-.4-1.5-1.1l-1.8-5.6c-.1-.4-.4-.7-.8-.8l-5.6-1.8c-.7-.2-1.1-.8-1.1-1.5s.4-1.3 1.1-1.5l5.6-1.8c.4-.1.7-.4.8-.8l1.8-5.6c.2-.7.8-1.1 1.5-1.1Z" />
								</svg>
								<span>talk</span>
							</div>
							<div>agents.</div>
						</div>
					</div>
			</section>
