<script>
	const getLayoutTop = (element) => {
		let top = 0;
		let node = element;
		while (node instanceof HTMLElement) {
			top += node.offsetTop;
			node = node.offsetParent;
		}
		return top;
	};

	const alignSectionTarget = (target) => {
		const header = document.querySelector(".site-header");
		const headerHeight = header instanceof HTMLElement ? header.offsetHeight : 0;
		const targetTop = getLayoutTop(target) - headerHeight;
		window.scrollTo({ top: Math.max(0, targetTop), behavior: "auto" });
	};

	document.querySelectorAll('.v3-page a[href^="#"]').forEach((anchor) => {
		anchor.addEventListener("click", (event) => {
			if (!(anchor instanceof HTMLAnchorElement)) return;
			const targetId = anchor.hash.slice(1);
			const target = document.getElementById(targetId);
			if (!(target instanceof HTMLElement)) return;
			event.preventDefault();
			history.pushState(null, "", anchor.hash);
			anchor.closest("details")?.removeAttribute("open");
			alignSectionTarget(target);
		});
	});

	if (window.location.hash) {
		const initialTarget = document.getElementById(window.location.hash.slice(1));
		if (initialTarget instanceof HTMLElement) window.addEventListener("load", () => alignSectionTarget(initialTarget), { once: true });
	}

	document.querySelectorAll("[data-air-carousel]").forEach((carousel) => {
		const slides = [...carousel.querySelectorAll("[data-air-slide]")];
		const dots = [...carousel.querySelectorAll("[data-air-dot]")];
		const descriptions = [...carousel.querySelectorAll("[data-air-description]")];
		const pauseButton = carousel.querySelector("[data-air-pause]");
		const reducedMotion = window.matchMedia("(prefers-reduced-motion: reduce)");
		const cycleDuration = 3200;
		const slideDuration = 920;
		const slideEasing = "cubic-bezier(0.22, 1, 0.36, 1)";
		let activeIndex = 0;
		let moving = false;
		let userPaused = false;
		let interactionPaused = false;
		let timer = 0;
		let timerStartedAt = 0;
		let timerRemaining = cycleDuration;
		let startX = null;
		let startY = null;

		carousel.style.setProperty("--air-cycle-duration", `${cycleDuration}ms`);

		const isVisible = () => {
			const bounds = carousel.getBoundingClientRect();
			return bounds.top < window.innerHeight && bounds.bottom > 0;
		};

		const isPaused = () => userPaused || interactionPaused || !isVisible();

		const clearTimer = () => {
			if (!timer) return;
			window.clearTimeout(timer);
			timer = 0;
		};

		const scheduleNext = (reset = true) => {
			if (reducedMotion.matches || isPaused()) return;
			if (timer && !reset) return;
			clearTimer();
			if (reset) timerRemaining = cycleDuration;
			timerStartedAt = window.performance.now();
			timer = window.setTimeout(() => {
				timer = 0;
				timerRemaining = cycleDuration;
				move(1, true);
			}, timerRemaining);
		};

		const pauseTimer = () => {
			if (!timer) return;
			const elapsed = window.performance.now() - timerStartedAt;
			timerRemaining = Math.max(120, timerRemaining - elapsed);
			clearTimer();
		};

		const syncPausedState = (resetTimer = false) => {
			const paused = isPaused();
			carousel.dataset.paused = String(paused);
			carousel.dataset.userPaused = String(userPaused);
			if (pauseButton instanceof HTMLButtonElement) {
				pauseButton.setAttribute("aria-pressed", String(userPaused));
				pauseButton.setAttribute("aria-label", userPaused ? "Play AIR carousel" : "Pause AIR carousel");
			}
			if (paused) {
				pauseTimer();
			} else {
				scheduleNext(resetTimer);
			}
		};

		const renderDescription = (indexToShow) => {
			descriptions.forEach((description, index) => {
				description.hidden = index !== indexToShow;
			});
		};

		const setActiveSlide = (indexToShow) => {
			slides.forEach((slide, index) => {
				slide.dataset.active = String(index === indexToShow);
				slide.setAttribute("aria-hidden", String(index !== indexToShow));
				slide.style.zIndex = String(index === indexToShow ? 2 : 1);
			});
		};

		const render = () => {
			slides.forEach((slide, index) => {
				slide.getAnimations().forEach((animation) => animation.cancel());
				slide.removeAttribute("data-sliding");
				slide.style.removeProperty("opacity");
				slide.style.removeProperty("transform");
				slide.style.removeProperty("filter");
			});
			setActiveSlide(activeIndex);
			renderControls(activeIndex);
			renderDescription(activeIndex);
		};

		const renderControls = (indexToShow, restartProgress = false) => {
			carousel.style.setProperty("--air-active-index", String(indexToShow));
			if (restartProgress) {
				const progress = carousel.querySelector(".air-active-pill .air-dot-progress");
				if (progress instanceof HTMLElement) {
					progress.style.animation = "none";
					progress.offsetHeight;
					progress.style.removeProperty("animation");
				}
			}
			dots.forEach((dot, index) => {
				const isActive = index === indexToShow;
				dot.dataset.active = String(isActive);
				dot.setAttribute("aria-current", isActive ? "true" : "false");
				dot.setAttribute("aria-pressed", String(isActive));
			});
		};

		const moveTo = (targetIndex, direction, resetTimer = true) => {
			if (targetIndex === activeIndex) return;
			const outgoing = slides[activeIndex];
			const incoming = slides[targetIndex];
			if (!(outgoing instanceof HTMLElement) || !(incoming instanceof HTMLElement)) return;

			if (moving) {
				slides.forEach((slide) => slide.getAnimations().forEach((animation) => animation.cancel()));
				slides.forEach((slide) => slide.removeAttribute("data-sliding"));
				moving = false;
			}

			if (reducedMotion.matches || typeof incoming.animate !== "function") {
				activeIndex = targetIndex;
				render();
				renderControls(activeIndex, resetTimer);
				syncPausedState(resetTimer);
				return;
			}

			moving = true;
			clearTimer();
			renderControls(targetIndex, false);
			renderDescription(targetIndex);
			const travel = direction > 0 ? 104 : -104;
			const incomingStart = `translateX(${travel}%) scale(1.015)`;
			const centre = "translateX(0) scale(1)";
			const outgoingEnd = `translateX(${-travel}%) scale(1)`;

			incoming.dataset.sliding = "true";
			outgoing.dataset.sliding = "true";
			incoming.style.opacity = "1";
			incoming.style.transform = incomingStart;
			incoming.style.zIndex = "4";
			outgoing.style.opacity = "1";
			outgoing.style.transform = centre;
			outgoing.style.zIndex = "3";

			const incomingAnimation = incoming.animate(
				[{ transform: incomingStart }, { transform: centre }],
				{ duration: slideDuration, easing: slideEasing, fill: "forwards" },
			);
			outgoing.animate(
				[
					{ transform: centre, filter: "brightness(1)" },
					{ transform: outgoingEnd, filter: "brightness(0.72)" },
				],
				{ duration: slideDuration, easing: slideEasing, fill: "forwards" },
			);

			incomingAnimation.finished.then(() => {
				activeIndex = targetIndex;
				slides.forEach((slide) => slide.getAnimations().forEach((animation) => animation.cancel()));
				setActiveSlide(activeIndex);
				renderDescription(activeIndex);
				incoming.style.opacity = "1";
				incoming.style.transform = centre;
				incoming.style.removeProperty("filter");
				outgoing.style.opacity = "0";
				outgoing.style.transform = outgoingEnd;
				outgoing.style.removeProperty("filter");
				renderControls(activeIndex, resetTimer);
				window.requestAnimationFrame(() => {
					incoming.removeAttribute("data-sliding");
					outgoing.removeAttribute("data-sliding");
					moving = false;
					syncPausedState(resetTimer);
				});
			});
		};

		const move = (direction, resetTimer = true) => {
			const targetIndex = (activeIndex + direction + slides.length) % slides.length;
			moveTo(targetIndex, direction, resetTimer);
		};

		dots.forEach((dot, index) => dot.addEventListener("click", (event) => {
			event.preventDefault();
			userPaused = true;
			clearTimer();
			timerRemaining = cycleDuration;
			let direction = index > activeIndex ? 1 : -1;
			if (activeIndex === slides.length - 1 && index === 0) direction = 1;
			if (index === activeIndex) {
				renderControls(activeIndex, false);
				syncPausedState(false);
				return;
			}
			moveTo(index, direction, false);
		}));

		if (pauseButton instanceof HTMLButtonElement) {
			pauseButton.addEventListener("click", () => {
				userPaused = !userPaused;
				syncPausedState(false);
			});
		}

		carousel.addEventListener("touchstart", (event) => {
			startX = event.touches[0]?.clientX ?? null;
			startY = event.touches[0]?.clientY ?? null;
			interactionPaused = true;
			syncPausedState(false);
		}, { passive: true });

		carousel.addEventListener("touchend", (event) => {
			const endX = event.changedTouches[0]?.clientX;
			const endY = event.changedTouches[0]?.clientY;
			if (startX === null || startY === null || endX === undefined || endY === undefined) return;
			const distanceX = startX - endX;
			const distanceY = startY - endY;
			const distance = Math.abs(distanceX) > Math.abs(distanceY) ? distanceX : distanceY;
			if (Math.abs(distance) > 28) move(distance > 0 ? 1 : -1, true);
			startX = null;
			startY = null;
			interactionPaused = false;
			syncPausedState(false);
		}, { passive: true });

		carousel.addEventListener("touchcancel", () => {
			startX = null;
			startY = null;
			interactionPaused = false;
			syncPausedState(false);
		}, { passive: true });
		window.addEventListener("scroll", () => syncPausedState(false), { passive: true });
		window.addEventListener("resize", () => syncPausedState(false), { passive: true });

		render();
		renderControls(activeIndex, true);
		syncPausedState(true);
	});

	document.querySelectorAll("[data-practice-carousel]").forEach((carousel) => {
		if (!(carousel instanceof HTMLElement) || carousel.dataset.initialised === "true") return;
		const track = carousel.querySelector("[data-practice-track]");
		if (!(track instanceof HTMLElement)) return;
		carousel.dataset.initialised = "true";

		const originalCards = [...track.children].filter((card) => card instanceof HTMLElement);
		originalCards.forEach((card) => {
			const clone = card.cloneNode(true);
			if (!(clone instanceof HTMLElement)) return;
			clone.setAttribute("aria-hidden", "true");
			clone.dataset.practiceClone = "true";
			track.append(clone);
		});

		const controls = carousel.parentElement;
		const previous = controls?.querySelector("[data-practice-previous]");
		const next = controls?.querySelector("[data-practice-next]");
		const reducedMotion = window.matchMedia("(prefers-reduced-motion: reduce)");
		const handheldLayout = window.matchMedia("(max-width: 720px), (pointer: coarse) and (max-width: 1180px)");
		const cardVideos = [...track.querySelectorAll("video")];
		cardVideos.forEach((video) => {
			const playbackRate = Number(video.dataset.playbackRate) || 1.5;
			video.defaultPlaybackRate = playbackRate;
			video.playbackRate = playbackRate;
		});
		const videoVisibility = new IntersectionObserver((entries) => {
			entries.forEach((entry) => {
				const video = entry.target;
				if (!(video instanceof HTMLVideoElement)) return;
				video.dataset.visible = String(entry.isIntersecting);
				if (entry.isIntersecting && !reducedMotion.matches) {
					video.muted = true;
					video.play().catch(() => {});
				} else video.pause();
			});
		}, { threshold: 0.1 });
		cardVideos.forEach((video) => videoVisibility.observe(video));
		reducedMotion.addEventListener("change", () => {
			cardVideos.forEach((video) => {
				if (reducedMotion.matches) video.pause();
				else if (video.dataset.visible === "true") video.play().catch(() => {});
			});
		});
		let pauseUntil = 0;
		let lastTick = performance.now();
		let scrollPosition = 0;
		let interacting = false;
		let arrowTarget = null;
		let arrowTimer;
		let centring = false;
		let arrowControlled = false;
		window.requestAnimationFrame(() => {
			const firstCard = originalCards[0];
			if (!(firstCard instanceof HTMLElement)) return;
			const gap = Number.parseFloat(getComputedStyle(track).gap) || 0;
			carousel.scrollLeft = (firstCard.offsetWidth + gap) * 0.48;
			scrollPosition = carousel.scrollLeft;
		});

		const loopWidth = () => {
			const firstClone = track.querySelector("[data-practice-clone]");
			return firstClone instanceof HTMLElement ? firstClone.offsetLeft - track.offsetLeft : track.scrollWidth / 2;
		};

		const normalise = () => {
			if (centring) return;
			const width = loopWidth();
			if (!width) return;
			while (carousel.scrollLeft >= width) carousel.scrollLeft -= width;
			while (carousel.scrollLeft < 0) carousel.scrollLeft += width;
		};

		const moveByCard = (direction) => {
			const firstCard = originalCards[0];
			if (!(firstCard instanceof HTMLElement)) return;
			const gap = Number.parseFloat(getComputedStyle(track).gap) || 0;
			const step = firstCard.offsetWidth + gap;
			const width = loopWidth();
			if (!width) return;
			const firstCentre = firstCard.offsetLeft - track.offsetLeft + firstCard.offsetWidth / 2 - carousel.clientWidth / 2;
			const position = arrowTarget ?? carousel.scrollLeft;
			let target = firstCentre + (Math.round((position - firstCentre) / step) + direction) * step;
			// Shift to an equivalent loop position before crossing the left edge.
			if (target < 0) {
				carousel.scrollLeft += width;
				target += width;
			} else if (position >= width && target >= width) {
				carousel.scrollLeft -= width;
				target -= width;
			}
			arrowControlled = true;
			centring = true;
			arrowTarget = target;
			window.clearTimeout(arrowTimer);
			carousel.scrollTo({ left: target, behavior: reducedMotion.matches ? "auto" : "smooth" });
			arrowTimer = window.setTimeout(() => {
				carousel.scrollLeft = target;
				centring = false;
				normalise();
				arrowTarget = carousel.scrollLeft;
				scrollPosition = carousel.scrollLeft;
			}, reducedMotion.matches ? 0 : 700);
		};

		previous?.addEventListener("click", () => moveByCard(-1));
		next?.addEventListener("click", () => moveByCard(1));

		carousel.addEventListener("scroll", normalise, { passive: true });
		carousel.addEventListener("pointerdown", () => {
			window.clearTimeout(arrowTimer);
			centring = false;
			arrowTarget = null;
			arrowControlled = false;
			interacting = true;
		});
		const endInteraction = () => {
			if (!interacting) return;
			interacting = false;
			pauseUntil = performance.now() + 3200;
		};
		window.addEventListener("pointerup", endInteraction);
		window.addEventListener("pointercancel", endInteraction);
		carousel.addEventListener("wheel", () => {
			window.clearTimeout(arrowTimer);
			centring = false;
			arrowTarget = null;
			arrowControlled = false;
			pauseUntil = performance.now() + 3200;
		}, { passive: true });

		const animatePracticeCarousel = (time) => {
			const delta = Math.min(34, time - lastTick);
			lastTick = time;
			const bounds = carousel.getBoundingClientRect();
			const isVisible = bounds.top < window.innerHeight && bounds.bottom > 0;
			if (!reducedMotion.matches && !interacting && !arrowControlled && isVisible && time >= pauseUntil) {
				// Retain fractional movement on browsers that round scrollLeft.
				const width = loopWidth();
				scrollPosition += delta * (handheldLayout.matches ? 0.035 : 0.045);
				if (width) scrollPosition %= width;
				carousel.scrollLeft = scrollPosition;
			} else {
				scrollPosition = carousel.scrollLeft;
			}
			window.requestAnimationFrame(animatePracticeCarousel);
		};
		window.requestAnimationFrame(animatePracticeCarousel);
	});
</script>
