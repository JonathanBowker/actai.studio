---
const stages = [
	{
		number: "01",
		title: "The call",
		copy: "Thirty minutes, recorded. We steer the conversation until we land on the real problem, not just notes.",
	},
	{
		number: "02",
		title: "The prep",
		copy: "If you choose to go ahead, we programme and prepare the agent on your brief, ready for the AIR session.",
	},
];

const airSlides = [
	{
		image: "/images/website-v3-air.webp",
		label: "(AIR)",
		copy: "We bring the agreed brief into the session.",
	},
	{
		image: "/images/website-v3-hero.webp",
		label: "Interaction 01",
		copy: "You discuss the process topic.",
	},
	{
		image: "/images/website-v3-governance.webp",
		label: "Interaction 02",
		copy: "The expert refines the definition.",
	},
	{
		image: "/images/use-case-art/misty-glass-landscape.jpg",
		label: "Interaction 03",
		copy: "The agent confirms it has understood.",
	},
	{
		image: "/images/use-case-art/orange-glass-figure.jpg",
		label: "Interaction 04",
		copy: "The agent starts the discovery process.",
	},
];

const useCases = [
	{
		sector: "Manufacturing & supply",
		title: "Operational knowledge, exactly where the team needs it.",
		image: "/images/use-case-art/neon-portrait-clean.webp",
		accent: "#6d42ff",
		position: "50% 42%",
		details: ["Production context", "Shift handovers", "Supplier actions"],
	},
	{
		sector: "Risk & compliance",
		title: "Clear review points, evidence and escalation.",
		image: "/images/use-case-art/neon-portrait-clean.webp",
		accent: "#d02ca4",
		position: "50% 42%",
		details: ["Review evidence", "Escalation routes", "Control ownership"],
	},
	{
		sector: "Professional services",
		title: "Expert context, ready for the next brief.",
		image: "/images/use-case-art/neon-portrait-clean.webp",
		accent: "#2548ff",
		position: "50% 42%",
		details: ["Brief context", "Expert handovers", "Client decisions"],
	},
	{
		sector: "Brand & media",
		title: "Content that stays useful and on brand.",
		image: "/images/use-case-art/neon-portrait-clean.webp",
		accent: "#ec3c8d",
		position: "50% 42%",
		details: ["Brand guidance", "Approval routes", "Channel context"],
	},
];

const useCaseColumns = [
	useCases.filter((_, index) => index % 2 === 0),
	useCases.filter((_, index) => index % 2 === 1),
];

const faqs = [
	{
		question: "What is Agent in the Room?",
		answer: "Agent in the Room is our live, expert-led discovery method. A prepared agent questions the room one decision at a time while our directors steer the conversation toward a clear, buildable brief.",
	},
	{
		question: "What happens in the first call?",
		answer: "We spend thirty minutes understanding where the business is losing time, consistency or control, and whether an agentic approach is the right response.",
	},
	{
		question: "Do we need an AI strategy first?",
		answer: "No. We start with the business problem, identify where AI can create measurable value, and shape the technology around that need.",
	},
	{
		question: "How do you keep agents governed?",
		answer: "We design around approved knowledge, explicit review points, escalation routes and clear human decisions from the start.",
	},
	{
		question: "What do you deliver?",
		answer: "Depending on the brief, we deliver a tested agent, the operating controls around it, and a clear plan for deployment, ownership and improvement.",
	},
	{
		question: "Who should join an AIR session?",
		answer: "The people who understand the work, make the decisions and will own the outcome. We keep the group focused enough to move quickly.",
	},
	{
		question: "Can you work with our existing technology?",
		answer: "Yes. We shape the solution around your systems, policies and approved platforms rather than forcing a separate technology stack.",
	},
	{
		question: "How long does the process take?",
		answer: "The discovery starts with a thirty-minute call. The timing from AIR session to deployment depends on the scope, integrations and governance required.",
	},
	{
		question: "Where do you work?",
		answer: "We work with teams across the UK and internationally, with AIR sessions held face to face wherever that best supports the conversation.",
	},
	{
		question: "How do we get started?",
		answer: "Request a thirty-minute call. We will read your note, understand the context and recommend the most useful next step.",
	},
];

const faqColumns = [
	faqs.filter((_, index) => index % 2 === 0),
	faqs.filter((_, index) => index % 2 === 1),
];
---

<div class="v3-page">
	<header class="site-header">
		<a class="brand" href="#top" aria-label="Act AI Studio home">
			<img src="/logos/ACT_Black.svg" alt="Act." width="87" height="43" />
		</a>

		<nav class="desktop-nav" aria-label="Primary navigation">
			<a href="#possibility">The possibility</a>
			<a href="#stages">The stages</a>
			<a href="#practice">The practice</a>
			<a href="#governance">The governance</a>
			<a href="#direction">The direction</a>
		</nav>

		<a class="nav-cta" href="/contact">Request a 30 minute call</a>

		<details class="mobile-nav">
			<summary aria-label="Open navigation"><span></span><span></span></summary>
			<nav aria-label="Mobile navigation">
				<a href="#possibility">The possibility</a>
				<a href="#stages">The stages</a>
				<a href="#practice">The practice</a>
				<a href="#governance">The governance</a>
				<a href="#direction">The direction</a>
				<a href="/contact">Request a 30 minute call</a>
			</nav>
		</details>
	</header>

	<main id="top">
		<section class="hero image-section" aria-labelledby="hero-heading">
			<div class="hero-content">
				<h1 id="hero-heading">Intelligence<br />needs direction</h1>
				<p>Act AI Studio finds where your business creates value and shapes AI to accelerate the delivery of it.</p>
				<a class="pill pill-light" href="#possibility">Our expert-driven approach</a>
			</div>
		</section>

		<section class="section section-light possibility" id="possibility" aria-labelledby="possibility-heading" data-scroll-tone-section data-scroll-tone-theme="ink" data-scroll-tone-entry="0.72">
			<div class="section-inner narrow-center">
				<p class="section-label">The possibility</p>
				<h2 id="possibility-heading">
					<span class="tone-heading-line" data-scroll-tone-line>You don't need to understand AI.</span>
					<span class="tone-heading-line" data-scroll-tone-line>We need to understand your business.</span>
				</h2>
				<p class="section-intro" data-scroll-tone-line>We start with how your business works, not with the technology. Then we shape practical agents around the places they can actually help, starting with Agent in the Room&trade; (AIR).</p>
			</div>
		</section>

		<section class="section section-dark stages" id="stages" aria-labelledby="stages-heading" data-scroll-tone-section>
			<div class="section-inner stages-inner">
				<div class="narrow-center">
					<p class="section-label section-label-dark">The stages</p>
					<h2 id="stages-heading" data-scroll-tone-line>Start with a conversation,<br />not a deck.</h2>
					<p class="section-intro muted-light" data-scroll-tone-line>It starts with a call. We record it, steer it, and by the end we know what the problem is. That becomes the brief.</p>
				</div>

				<div class="stage-grid">
					{stages.map((stage) => (
						<article class="stage-item" data-scroll-tone-line>
							<p class="stage-number">{stage.number}</p>
							<h3>{stage.title}</h3>
							<p>{stage.copy}</p>
						</article>
					))}
				</div>

				<article class="stage-item stage-feature" data-scroll-tone-line>
					<p class="stage-number">03</p>
					<h3>The AIR session</h3>
					<p>Face to face, wherever suits the conversation. One or two of our experts join your people, with the agent we've prepared. It questions the room one question at a time. You answer. We steer. AI-led, expert-driven.</p>
				</article>

				<div class="air-panel" aria-label="Agent in the Room interaction stages" aria-roledescription="carousel" data-air-carousel>
					{airSlides.map((slide, index) => (
						<article class="air-slide" data-air-slide aria-label={`Frame ${index + 1} of ${airSlides.length}`}>
							<img src={slide.image} alt="" />
							<div class="air-copy">
								<strong>{slide.label}</strong>
								<p>{slide.copy}</p>
							</div>
						</article>
					))}
					<div class="carousel-dots">
						{airSlides.map((_, index) => (
							<button type="button" aria-label={`Show frame ${index + 1}`} data-air-dot></button>
						))}
					</div>
				</div>

				<article class="stage-item stage-build" data-scroll-tone-line>
					<p class="stage-number">04</p>
					<h3>The build.</h3>
					<p>What we agree goes to our studio, where we build, test and deploy it.</p>
				</article>
				<a class="pill pill-light stage-booking" href="/contact">Request a 30 minute call</a>
			</div>
		</section>

		<section class="section section-light practice" id="practice" aria-labelledby="practice-heading" data-scroll-tone-section data-scroll-tone-theme="ink">
			<div class="section-inner">
				<div class="narrow-center practice-heading">
					<p class="section-label">The practice</p>
					<h2 id="practice-heading" data-scroll-tone-line>Where AI earns its place.</h2>
				</div>

				<div class="practice-layout">
					<div class="practice-copy">
						<p data-scroll-tone-line>What matters is where AI creates value and where people stay in control.</p>
						<p data-scroll-tone-line>Agents bring capability, which builds business capacity.</p>
					</div>
					<div class="use-case-grid" aria-label="Business use cases">
						{useCaseColumns.map((column) => (
							<div class="use-case-column" data-practice-column>
								{[false, true].map((duplicate) => (
									<div class="use-case-sequence" data-practice-loop-start={duplicate ? "true" : undefined} aria-hidden={duplicate ? "true" : undefined}>
										{column.map((useCase) => {
											const index = useCases.indexOf(useCase);
											return (
								<article class:list={["use-case", index === 0 || index === 3 ? "use-case-tall" : ""]} style={`--accent:${useCase.accent};--position:${useCase.position};--image:url(${useCase.image})`}>
													<div class="use-case-art" aria-hidden="true"></div>
													<div class="use-case-meta"><span>Use case</span><span>{String(index + 1).padStart(2, "0")} / 04</span></div>
													<div class="use-case-body">
														<p>{useCase.sector}</p>
														<h3>{useCase.title}</h3>
													</div>
													<div class="use-case-details">
														{useCase.details.map((detail) => <span>{detail}</span>)}
													</div>
												</article>
											);
										})}
									</div>
								))}
							</div>
						))}
					</div>
				</div>
			</div>
		</section>

		<section class="section section-dark governance" id="governance" aria-labelledby="governance-heading" data-scroll-tone-section>
			<div class="section-inner">
				<div class="narrow-center governance-heading">
					<p class="section-label section-label-dark">The governance</p>
					<h2 id="governance-heading" data-scroll-tone-line>Your policies,<br />your boundaries.</h2>
				</div>

				<div class="governance-layout">
					<div class="governance-copy">
						<p data-scroll-tone-line>We shape the agent around approved knowledge, review points and escalation routes.</p>
						<p data-scroll-tone-line>Every agent stays governed by your policies and clear human decisions.</p>
					</div>
					<img src="/images/website-v3-governance.webp" alt="Transparent human profile with liquid gold highlights" width="1254" height="1254" />
				</div>
			</div>
		</section>

		<section class="section section-light direction" id="direction" aria-labelledby="direction-heading" data-scroll-tone-section data-scroll-tone-theme="ink">
			<div class="section-inner">
				<div class="narrow-center direction-heading">
					<p class="section-label">The direction</p>
					<h2 id="direction-heading" data-scroll-tone-line>We direct your AI,<br />and deliver the results.</h2>
					<p class="section-intro" data-scroll-tone-line>AI and creative thinking, backed by practice, driven by outcomes, not reports.</p>
				</div>

				<div class="director-grid">
					<article data-scroll-tone-line>
						<h3>Jonny Bowker</h3>
						<p class="director-role">AI Director | Strategy</p>
						<p>Jonny Bowker is a Law Society of Scotland accredited AI Expert and practitioner. He has worked across Fortune 500 companies and mid-caps, spanning many sectors and functions. Through his Agent in the Room&trade; methodology, he turns business problems into clear briefs and directs what gets built.</p>
						<strong>Finds the problem worth solving.</strong>
					</article>
					<article data-scroll-tone-line>
						<h3>Mark Chatelier</h3>
						<p class="director-role">AI Director | Discovery</p>
						<p>Mark Chatelier is an AI generalist who leads discovery through creative thinking and direction, drawing on two decades leading creative teams on global accounts including HSBC, Audi and Vodafone. He listens first, then leads the conversation toward the real problem, applying the same discipline wherever it actually sits.</p>
						<strong>Shapes the brief before build starts.</strong>
					</article>
				</div>
			</div>
		</section>

		<section class="section image-section conversation" id="conversation" aria-labelledby="conversation-heading" data-scroll-tone-section>
			<div class="conversation-content narrow-center">
				<p class="section-label section-label-dark">The conversation</p>
				<h2 id="conversation-heading" data-scroll-tone-line>Let's talk agents.</h2>
				<p class="conversation-lead" data-scroll-tone-line>Talk to us, and find the value AI can deliver.</p>
				<p data-scroll-tone-line>Request a 30-minute call with our directors to find where AI can create value for your business.</p>
				<a class="pill pill-light" href="/contact">Request a 30 minute call</a>
			</div>
		</section>

		<section class="section section-light faq" id="faq" aria-labelledby="faq-heading">
			<div class="section-inner">
				<div class="narrow-center">
					<p class="section-label">FAQ</p>
					<h2 id="faq-heading" class="visually-hidden">Frequently asked questions</h2>
				</div>

				<div class="faq-grid">
					{faqColumns.map((column) => (
						<div class="faq-column">
							{column.map((faq) => (
								<details>
									<summary>{faq.question}<span aria-hidden="true">+</span></summary>
									<p>{faq.answer}</p>
								</details>
							))}
						</div>
					))}
				</div>
			</div>
		</section>
	</main>

	<footer class="site-footer" id="footer">
		<div class="footer-grid">
			<div class="footer-primary">
				<img src="/logos/ACT_White.svg" alt="Act." width="87" height="43" />
				<a class="pill pill-light footer-cta" href="/contact">Request a 30 minute call</a>
				<p>&copy; 2026 Advanced Analytica Limited.<br />All Rights Reserved.</p>
			</div>
			<nav aria-label="Information">
				<strong>Information</strong>
				<a href="#top">Home</a>
				<a href="#possibility">The possibility</a>
				<a href="#stages">The stages</a>
				<a href="#practice">The practice</a>
				<a href="#governance">The governance</a>
				<a href="#direction">The direction</a>
				<a href="#faq">FAQ</a>
				<a href="/sitemap">Site map</a>
				<a href="/privacy">Privacy</a>
			</nav>
			<div class="footer-about">
				<strong>Advanced Analytica</strong>
				<p>Act AI Studio is the agentic AI practice of Advanced Analytica Limited. We help organisations identify where AI creates value, direct what gets built and keep every agent governed by human decisions.</p>
			</div>
			<div class="footer-social">
				<a href="https://www.linkedin.com/company/advanced-analytica/" rel="noreferrer" target="_blank">LinkedIn</a>
			</div>
		</div>
		<div class="footer-wordmark" aria-hidden="true">
			<img src="/logos/ACT_White.svg" alt="" />
		</div>
	</footer>
</div>

<style>
	:global(html) {
		scroll-padding-top: 78px;
	}

	:global(body) {
		background: #10100f;
	}

	.v3-page {
		--paper: #f5f4f2;
		--ink: #10100f;
		--dark: #10100f;
		--round: 48px;
		background: var(--dark);
		color: var(--ink);
		font-family: "MG12", "Helvetica Neue", Arial, sans-serif;
		overflow: clip;
	}

	.v3-page * {
		font-family: "MG12", "Helvetica Neue", Arial, sans-serif !important;
	}

	a {
		color: inherit;
		text-decoration: none;
	}

	.site-header {
		height: 78px;
		padding: 0 30px;
		display: grid;
		grid-template-columns: 150px 1fr auto;
		align-items: center;
		gap: 28px;
		background: rgba(250, 250, 248, 0.98);
		border-bottom: 1px solid rgba(16, 16, 15, 0.13);
		position: relative;
		z-index: 50;
	}

	.brand,
	.brand img {
		display: block;
	}

	.brand img {
		width: 84px;
		height: auto;
	}

	.desktop-nav {
		display: flex;
		justify-content: center;
		gap: 36px;
		font-family: "PP Neue Montreal", sans-serif;
		font-size: 15px;
	}

	.desktop-nav a,
	.site-footer a {
		transition: opacity 180ms ease;
	}

	.desktop-nav a:hover,
	.site-footer a:hover {
		opacity: 0.58;
	}

	.nav-cta,
	.pill {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		min-height: 44px;
		padding: 0 24px;
		border: 1px solid currentColor;
		border-radius: 999px;
		font-family: "PP Neue Montreal", sans-serif;
		font-size: 14px;
		font-weight: 700;
		line-height: 1;
		transition: transform 180ms ease, background 180ms ease, color 180ms ease;
	}

	.nav-cta:hover,
	.pill:hover {
		transform: translateY(-2px);
	}

	.nav-cta {
		background: #fff;
	}

	.mobile-nav {
		display: none;
	}

	.image-section {
		background-image: url("/images/website-v3-hero.webp");
		background-position: center;
		background-size: cover;
	}

	.hero {
		min-height: 880px;
		display: grid;
		place-items: center;
		position: relative;
		color: #fff;
		isolation: isolate;
	}

	.hero::before,
	.conversation::before {
		content: "";
		position: absolute;
		inset: 0;
		background: rgba(23, 12, 43, 0.08);
		z-index: -1;
	}

	.hero-content {
		width: min(920px, calc(100% - 48px));
		margin-top: -15px;
		text-align: center;
	}

	h1,
	h2,
	h3,
	p {
		margin-top: 0;
	}

	h1,
	h2,
	h3 {
		letter-spacing: 0;
	}

	h1 {
		margin-bottom: 38px;
		font-size: 104px;
		font-weight: 500;
		line-height: 0.88;
	}

	.hero-content > p {
		max-width: 670px;
		margin: 0 auto 34px;
		font-size: 25px;
		line-height: 1.22;
	}

	.pill-light {
		border-color: #fff;
		background: #fff;
		color: var(--ink);
	}

	.section {
		position: relative;
		margin-top: calc(var(--round) * -1);
		border-radius: var(--round) var(--round) 0 0;
		z-index: 2;
	}

	.section + .section {
		z-index: 3;
	}

	.section-light {
		background: var(--paper);
		color: var(--ink);
	}

	.section-dark {
		background: var(--dark);
		color: #fff;
	}

	.section-inner {
		width: min(1440px, calc(100% - 96px));
		margin: 0 auto;
	}

	.narrow-center {
		max-width: 1050px;
		margin-inline: auto;
		text-align: center;
	}

	.section-label {
		width: fit-content;
		min-width: 190px;
		margin: 0 auto 62px;
		padding: 12px 28px;
		border: 1px solid rgba(16, 16, 15, 0.76);
		border-radius: 4px;
		font-family: "PP Neue Montreal", sans-serif;
		font-size: 16px;
		font-weight: 700;
		line-height: 1;
		text-align: center;
		text-transform: uppercase;
	}

	.section-label-dark {
		border-color: rgba(255, 255, 255, 0.66);
	}

	.section h2 {
		font-size: 82px;
		font-weight: 500;
		line-height: 0.96;
	}

	.section-intro {
		max-width: 720px;
		margin: 44px auto 0;
		font-family: "PP Neue Montreal", sans-serif;
		font-size: 20px;
		line-height: 1.45;
	}

	.muted-light {
		color: rgba(255, 255, 255, 0.78);
	}

	.possibility {
		padding: 160px 0 210px;
	}

	.possibility .narrow-center {
		max-width: 1150px;
	}

	.possibility h2 {
		font-size: 92px;
	}

	.tone-heading-line {
		display: block;
	}

	.stages {
		padding: 150px 0 195px;
	}

	.stages-inner {
		max-width: 1280px;
	}

	.stages .narrow-center {
		max-width: 980px;
	}

	.stage-grid {
		display: grid;
		grid-template-columns: repeat(2, minmax(0, 1fr));
		gap: 70px;
		margin-top: 130px;
	}

	.stage-item {
		padding-top: 32px;
		border-top: 1px solid rgba(255, 255, 255, 0.58);
		text-align: center;
	}

	.stage-number {
		margin-bottom: 18px;
		font-family: "PP Neue Montreal", sans-serif;
		font-size: 15px;
		font-weight: 700;
	}

	.stage-item h3 {
		margin-bottom: 24px;
		font-size: 38px;
		font-weight: 500;
		line-height: 1;
	}

	.stage-item > p:last-child {
		max-width: 500px;
		margin: 0 auto;
		color: rgba(255, 255, 255, 0.76);
		font-family: "PP Neue Montreal", sans-serif;
		font-size: 18px;
		line-height: 1.45;
	}

	.stage-feature {
		width: min(780px, 100%);
		margin: 105px auto 75px;
	}

	.air-panel {
		aspect-ratio: 2.4 / 1;
		position: relative;
		overflow: hidden;
		border-radius: 20px;
		isolation: isolate;
		touch-action: pan-y pinch-zoom;
	}

	.air-panel::after {
		content: "";
		position: absolute;
		inset: 0;
		background: rgba(38, 38, 34, 0.32);
		z-index: -1;
	}

	.air-slide {
		position: absolute;
		inset: 0;
		opacity: 0;
		transform: translateY(100%) scale(1.025);
		transition: opacity 420ms ease, transform 820ms cubic-bezier(0.16, 1, 0.3, 1), filter 420ms ease;
		will-change: transform, opacity;
	}

	.air-slide[data-active="true"] {
		opacity: 1;
