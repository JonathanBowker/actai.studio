---
const stages = [
	{
		number: "01",
		title: "The call",
		copy: "Thirty minutes, recorded. We steer the conversation until we land on the real problem, not just notes.",
	},
	{
		number: "02",
		title: "The prep",
		copy: "If you choose to go ahead, we programme and prepare the agent on your brief, ready for the AIR session.",
	},
	{
		number: "03",
		title: "The AIR session",
		copy: "Face to face, wherever suits the conversation. One or two of our experts join your people, with the agent we've prepared. It questions the room one question at a time. You answer. We steer. AI-led, expert-driven.",
	},
	{
		number: "04",
		title: "The build.",
		copy: "What we agree goes to our studio, where we build, test and deploy it.",
	},
];

const airSlides = [
	{
		image: "/images/website-v3-air.webp",
		label: "(AIR)",
		navNumber: "01.",
		navName: "Seed",
		copy: "We bring the agreed brief into the session.",
		description: "we bring a shortlisted issue into the room, already seeded with business context and the right design tree started.",
	},
	{
		image: "/images/website-v3-hero.webp",
		label: "Interaction 01",
		navNumber: "02.",
		navName: "Shape",
		copy: "You discuss the process topic.",
		description: "the room talks through the concept together, the agent asking what's needed to grow the design tree, decision by decision.",
	},
	{
		image: "/images/website-v3-governance.webp",
		label: "Interaction 02",
		navNumber: "03.",
		navName: "Grill",
		copy: "The expert refines the definition.",
		description: "the agent cross-examines the logic using established decision theory, naming contradictions and gaps, until they are appropriately filled.",
	},
	{
		image: "/images/use-case-art/misty-glass-landscape.jpg",
		label: "Interaction 03",
		navNumber: "04.",
		navName: "Lock",
		copy: "The agent confirms it has understood.",
		description: "the agent states back what's been agreed, the room confirms by consensus, and the whole design tree locks ready for build in the studio.",
	},
];

const useCases = [
	{
		sector: "Manufacturing & supply",
		title: "Operational knowledge, exactly where the team needs it.",
		image: "/images/use-case-art/neon-portrait-clean.webp",
		accent: "#6d42ff",
		position: "50% 42%",
		details: ["Production context", "Shift handovers", "Supplier actions"],
	},
	{
		sector: "Risk & compliance",
		title: "Clear review points, evidence and escalation.",
		image: "/images/use-case-art/neon-portrait-clean.webp",
		accent: "#d02ca4",
		position: "50% 42%",
		details: ["Review evidence", "Escalation routes", "Control ownership"],
	},
	{
		sector: "Professional services",
		title: "Expert context, ready for the next brief.",
		image: "/images/use-case-art/neon-portrait-clean.webp",
		accent: "#2548ff",
		position: "50% 42%",
		details: ["Brief context", "Expert handovers", "Client decisions"],
	},
	{
		sector: "Brand & media",
		title: "Content that stays useful and on brand.",
		image: "/images/use-case-art/neon-portrait-clean.webp",
		accent: "#ec3c8d",
		position: "50% 42%",
		details: ["Brand guidance", "Approval routes", "Channel context"],
	},
	{
		sector: "Land & estates",
		title: "Make estate knowledge easier to act on.",
		image: "/images/use-case-art/neon-portrait-clean.webp",
		accent: "#7452ff",
		position: "50% 42%",
		details: ["Asset context", "Maintenance records", "Local rules"],
	},
	{
		sector: "Finance & banking",
		title: "Keep reporting moving without losing control.",
		image: "/images/use-case-art/neon-portrait-clean.webp",
		accent: "#dd3295",
		position: "50% 42%",
		details: ["Board packs", "Variance notes", "Approval trails"],
	},
	{
		sector: "Technology & software",
		title: "Turn product knowledge into better support.",
		image: "/images/use-case-art/neon-portrait-clean.webp",
		accent: "#3158ff",
		position: "50% 42%",
		details: ["Product notes", "Support patterns", "Release context"],
	},
	{
		sector: "Consulting & operations",
		title: "Make delivery knowledge repeatable.",
		image: "/images/use-case-art/neon-portrait-clean.webp",
		accent: "#ba38bc",
		position: "50% 42%",
		details: ["Delivery playbooks", "Client context", "Repeatable steps"],
	},
];

const faqs = [
	{
		question: "What is Agent in the Room?",
		answer: "Agent in the Room is our live, expert-led discovery method. A prepared agent questions the room one decision at a time while our directors steer the conversation toward a clear, buildable brief.",
	},
	{
		question: "What happens in the first call?",
		answer: "We spend thirty minutes understanding where the business is losing time, consistency or control, and whether an agentic approach is the right response.",
	},
	{
		question: "Do we need an AI strategy first?",
		answer: "No. We start with the business problem, identify where AI can create measurable value, and shape the technology around that need.",
	},
	{
		question: "How do you keep agents governed?",
		answer: "We design around approved knowledge, explicit review points, escalation routes and clear human decisions from the start.",
	},
	{
		question: "What do you deliver?",
		answer: "Depending on the brief, we deliver a tested agent, the operating controls around it, and a clear plan for deployment, ownership and improvement.",
	},
	{
		question: "Who should join an AIR session?",
		answer: "The people who understand the work, make the decisions and will own the outcome. We keep the group focused enough to move quickly.",
	},
	{
		question: "Can you work with our existing technology?",
		answer: "Yes. We shape the solution around your systems, policies and approved platforms rather than forcing a separate technology stack.",
	},
	{
		question: "How long does the process take?",
		answer: "The discovery starts with a thirty-minute call. The timing from AIR session to deployment depends on the scope, integrations and governance required.",
	},
	{
		question: "Where do you work?",
		answer: "We work with teams across the UK and internationally, with AIR sessions held face to face wherever that best supports the conversation.",
	},
	{
		question: "How do we get started?",
		answer: "Request a thirty-minute call. We will read your note, understand the context and recommend the most useful next step.",
	},
];

const faqColumns = [
	faqs.filter((_, index) => index % 2 === 0),
	faqs.filter((_, index) => index % 2 === 1),
];
---

<div class="v3-page">
	<header class="site-header">
		<a class="brand" href="#top" aria-label="Act AI Studio home">
			<img src="/logos/ACT_White.svg" alt="Act." width="87" height="43" />
		</a>

		<nav class="desktop-nav" aria-label="Primary navigation">
			<a href="#opportunity">The opportunity</a>
			<a href="#stages">The method</a>
			<a href="#practice">The practice</a>
			<a href="#governance">The governance</a>
			<a href="#direction">The direction</a>
			<a href="#footer">The company</a>
		</nav>

		<a class="nav-cta" href="/contact">Request a 30 minute call</a>

		<details class="mobile-nav">
			<summary aria-label="Open navigation"><span></span><span></span></summary>
			<nav aria-label="Mobile navigation">
				<a href="#opportunity">The opportunity</a>
				<a href="#stages">The method</a>
				<a href="#practice">The practice</a>
				<a href="#governance">The governance</a>
				<a href="#direction">The direction</a>
				<a href="#footer">The company</a>
				<a href="/contact">Request a 30 minute call</a>
			</nav>
		</details>
	</header>

	<main id="top">
		<section class="hero image-section" aria-labelledby="hero-heading">
			<div class="hero-content">
				<h1 id="hero-heading">Intelligence<br />needs direction</h1>
				<p>Act AI Studio finds where your business creates value and shapes AI to accelerate the delivery of it.</p>
				<a class="pill pill-light" href="#opportunity">Our expert-driven approach</a>
			</div>
		</section>

		<section class="section section-light possibility" id="opportunity" aria-labelledby="opportunity-heading" data-scroll-tone-section data-scroll-tone-entry="1.02">
			<div class="section-inner narrow-center">
				<p class="section-label">The opportunity</p>
				<h2 id="opportunity-heading">
					<span class="tone-heading-line" data-scroll-tone-line>You don't need to understand AI.</span>
					<span class="tone-heading-line" data-scroll-tone-line>We need to understand your business.</span>
				</h2>
				<p class="section-intro possibility-intro" data-scroll-tone-line data-scroll-tone-step="0.65">
					<span>We start with how your business works, not with the technology.</span>
					<span>Then we shape practical agents around the places they can</span>
					<span>
						actually help, starting with Agent in the Room&trade;
						<span class="air-mark" aria-label="AIR">
							<span class="air-mark-bracket air-mark-bracket-outer" aria-hidden="true">(</span>
							<span class="air-mark-bracket air-mark-bracket-inner" aria-hidden="true">(</span>
							<span class="air-mark-letters" aria-hidden="true">AIR</span>
							<span class="air-mark-bracket air-mark-bracket-inner" aria-hidden="true">)</span>
							<span class="air-mark-bracket air-mark-bracket-outer" aria-hidden="true">)</span>
						</span>.
					</span>
				</p>
			</div>
		</section>

		<section class="section section-dark stages" id="stages" aria-labelledby="stages-heading" data-scroll-tone-section>
			<div class="section-inner stages-inner">
				<div class="narrow-center">
					<p class="section-label section-label-dark">The method</p>
					<h2 id="stages-heading" data-scroll-tone-line>Start with a conversation,<br />not a deck.</h2>
					<p class="section-intro muted-light" data-scroll-tone-line>It starts with a call. We record it, steer it, and by the end we know what the problem is. That becomes the brief.</p>
				</div>

				<div class="stage-grid">
					{stages.map((stage) => (
						<article class="stage-item" data-scroll-tone-line>
							<p class="stage-number">{stage.number}</p>
							<h3>{stage.title}</h3>
							<p>{stage.copy}</p>
						</article>
					))}
				</div>

				<div class="air-carousel" aria-label="Agent in the Room interaction stages" aria-roledescription="carousel" data-air-carousel>
					<div class="air-panel">
						{airSlides.map((slide, index) => (
							<article class="air-slide" id={`air-slide-${index + 1}`} data-air-slide aria-label={`Frame ${index + 1} of ${airSlides.length}`}>
								<img src={slide.image} alt="" />
								<div class="air-copy">
									<strong>{slide.label}</strong>
									<p>{slide.copy}</p>
								</div>
							</article>
						))}
					</div>
					<div class="carousel-dots" aria-label="Choose an AIR frame">
						{airSlides.map((slide, index) => (
							<button type="button" aria-label={`Show frame ${index + 1}: ${slide.navName}`} aria-controls={`air-slide-${index + 1}`} aria-pressed={index === 0 ? "true" : "false"} data-air-dot>
								<span>{slide.navNumber}</span>
								{slide.navName && <span class="air-nav-name">{slide.navName}</span>}
							</button>
						))}
					</div>
					<div class="air-descriptions" aria-live="polite">
						{airSlides.map((slide, index) => (
							<p data-air-description hidden={index !== 0}>
								<strong>{slide.navName}:</strong> {slide.description}
							</p>
						))}
					</div>
				</div>
			</div>
		</section>

		<section class="section section-light practice" id="practice" aria-labelledby="practice-heading" data-scroll-tone-section>
			<div class="section-inner">
				<div class="narrow-center practice-heading">
					<p class="section-label">The practice</p>
					<h2 id="practice-heading" data-scroll-tone-line>Where AI earns<br />its place.</h2>
				</div>

				<div class="practice-layout">
					<div class="practice-copy">
						<p data-scroll-tone-line>Agents can increase business capacity by orders of magnitude.</p>
						<p data-scroll-tone-line>What matters is where they create value and how people stay in control.</p>
					</div>
					<div class="use-case-carousel" aria-label="Business use cases" aria-roledescription="carousel" data-practice-carousel>
						<div class="use-case-track" data-practice-track>
							{useCases.map((useCase, index) => (
								<article class="use-case" style={`--accent:${useCase.accent};--position:${useCase.position};--image:url(${useCase.image})`}>
									<div class="use-case-art" aria-hidden="true"></div>
									<div class="use-case-meta"><span>Use case</span><span>{String(index + 1).padStart(2, "0")} / {String(useCases.length).padStart(2, "0")}</span></div>
									<div class="use-case-body">
										<p>{useCase.sector}</p>
										<h3>{useCase.title}</h3>
									</div>
									<div class="use-case-details">
										{useCase.details.map((detail) => <span>{detail}</span>)}
									</div>
								</article>
							))}
						</div>
					</div>
					<div class="practice-controls">
						<button type="button" aria-label="Previous use case" data-practice-previous>&larr;</button>
						<button type="button" aria-label="Next use case" data-practice-next>&rarr;</button>
					</div>
				</div>
			</div>
		</section>

		<section class="section section-dark governance" id="governance" aria-labelledby="governance-heading" data-scroll-tone-section>
			<div class="section-inner">
				<div class="narrow-center governance-heading">
					<p class="section-label section-label-dark">The governance</p>
					<h2 id="governance-heading" data-scroll-tone-line>Your policies,<br />your boundaries.</h2>
				</div>

				<div class="governance-layout">
					<div class="governance-copy">
						<p data-scroll-tone-line>We embed agents with approved policies, review points and escalation routes. Every agent remains governed by your control procedures and human decisions.</p>
					</div>
					<figure class="governance-visual" aria-label="Governance areas surrounding an AI agent">
						<img class="governance-image governance-image--primary" src="/images/website-v3-governance.webp" alt="Transparent human profile with liquid gold highlights" width="1254" height="1254" />
						<img class="governance-image governance-image--left" src="/images/website-v3-governance.webp" alt="" width="1254" height="1254" />
						<img class="governance-image governance-image--right" src="/images/website-v3-governance.webp" alt="" width="1254" height="1254" />
						<img class="governance-image governance-image--small-left" src="/images/website-v3-governance.webp" alt="" width="1254" height="1254" />
						<img class="governance-image governance-image--small-right" src="/images/website-v3-governance.webp" alt="" width="1254" height="1254" />
						<span class="governance-tag governance-tag--security">Information Security</span>
						<span class="governance-tag governance-tag--data">Data Protection</span>
						<span class="governance-tag governance-tag--brand">Brand Guidelines</span>
						<span class="governance-tag governance-tag--esg">ESG</span>
						<span class="governance-tag governance-tag--employment">Employment</span>
						<span class="governance-tag governance-tag--regulations">Regulations</span>
						<span class="governance-tag governance-tag--ai">AI</span>
						<span class="governance-tag governance-tag--legal">Legal</span>
						<span class="governance-tag governance-tag--risk">Risk</span>
					</figure>
				</div>
			</div>
		</section>

		<section class="section section-light direction" id="direction" aria-labelledby="direction-heading" data-scroll-tone-section>
			<div class="section-inner">
				<div class="narrow-center direction-heading">
					<p class="section-label">The direction</p>
					<h2 id="direction-heading" data-scroll-tone-line>We direct your AI,<br />and deliver the results.</h2>
					<p class="section-intro" data-scroll-tone-line>AI led by creative thinking, backed by technical practice, driven by outcomes, not reports.</p>
				</div>

				<div class="director-grid">
					<article data-scroll-tone-line>
						<h3>Jonny Bowker</h3>
						<p class="director-role">AI Director | Strategy</p>
						<p>Jonny Bowker is a Law Society of Scotland accredited AI Expert and practitioner. He has worked across Fortune 500 companies and mid-caps, spanning many sectors and functions. Through his Agent in the Room&trade; methodology, he turns business problems into clear briefs and directs what gets built.</p>
						<strong>Finds the problem worth solving.</strong>
					</article>
					<article data-scroll-tone-line>
						<h3>Mark Chatelier</h3>
						<p class="director-role">AI Director | Discovery</p>
						<p>Mark Chatelier is an AI generalist who leads discovery through creative thinking and direction, drawing on two decades leading creative teams on global accounts including HSBC, Audi and Vodafone. He listens first, then leads the conversation toward the real problem, applying the same discipline wherever it actually sits.</p>
						<strong>Shapes the brief before build starts.</strong>
					</article>
				</div>
			</div>
		</section>

		<section class="section image-section conversation" id="conversation" aria-labelledby="conversation-heading" data-scroll-tone-section>
			<div class="conversation-content narrow-center">
				<p class="section-label section-label-dark">The conversation</p>
				<h2 id="conversation-heading" data-scroll-tone-line>Let's talk agents.</h2>
				<p class="conversation-lead" data-scroll-tone-line>What follows could change your business - <em>forever</em></p>
				<p data-scroll-tone-line>Request a 30-minute call with our directors to find where AI can create value for your business.</p>
				<a class="pill pill-light" href="/contact">Request a 30 minute call</a>
			</div>
		</section>

		<section class="section section-light faq" id="faq" aria-labelledby="faq-heading">
			<div class="section-inner">
				<div class="narrow-center">
					<p class="section-label">FAQ</p>
					<h2 id="faq-heading" class="visually-hidden">Frequently asked questions</h2>
				</div>

				<div class="faq-grid">
					{faqColumns.map((column) => (
						<div class="faq-column">
							{column.map((faq) => (
								<details>
									<summary>{faq.question}<span aria-hidden="true">+</span></summary>
									<p>{faq.answer}</p>
								</details>
							))}
						</div>
					))}
				</div>
			</div>
		</section>
	</main>

	<footer class="site-footer" id="footer">
		<div class="footer-grid">
			<div class="footer-primary">
				<img src="/logos/ACT_White.svg" alt="Act." width="87" height="43" />
			</div>
			<nav aria-label="Information">
				<strong>Information</strong>
				<a href="#top">Home</a>
				<a href="#opportunity">The opportunity</a>
				<a href="#stages">The method</a>
				<a href="#practice">The practice</a>
				<a href="#governance">The governance</a>
				<a href="#direction">The direction</a>
				<a href="#faq">FAQ</a>
				<a href="/sitemap">Site map</a>
				<a href="/privacy">Privacy</a>
			</nav>
			<div class="footer-about">
				<strong>Advanced Analytica</strong>
				<div class="footer-about-copy">
					<p>MOVE FAST. STAY SAFE.</p>
					<p>Act AI Studio is the outreach and AI engagement arm of Advanced Analytica, a UK-based business.</p>
					<p>Most businesses are sitting on knowledge they can't use at speed. The people who hold it are busy, the documents that contain it are static, and the processes built around it weren't designed for AI.</p>
					<p>Advanced Analytica turns that knowledge into governed agentic systems that work in production. We bring the strategy, the specification, and the AI skills, so the business can move fast and stay safe.</p>
				</div>
			</div>
			<div class="footer-social">
				<a href="https://www.linkedin.com/company/advancedanalytica/" rel="noreferrer" target="_blank" aria-label="Advanced Analytica on LinkedIn">
					<img src="/icons/linkedin.svg" alt="" width="48" height="48" />
				</a>
			</div>
		</div>
		<div class="footer-wordmark" aria-hidden="true">
			<img src="/logos/ACT_White.svg" alt="" />
		</div>
	</footer>
</div>

<style>
	:global(html) {
		scroll-padding-top: 78px;
	}

	:global(body) {
		background: #10100f;
	}

	.v3-page {
		--paper: #050505;
		--ink: #f7f7f5;
		--dark: #10100f;
		--round: 48px;
		--grid-gap: 20px;
		--grid-gutter: clamp(24px, 4.167vw, 80px);
		background: var(--dark);
		color: var(--ink);
		font-family: "MG12", "Helvetica Neue", Arial, sans-serif;
		overflow: clip;
	}

	.v3-page * {
		font-family: "MG12", "Helvetica Neue", Arial, sans-serif !important;
	}

	a {
		color: inherit;
		text-decoration: none;
	}

	.site-header {
		height: 80px;
		padding: 0 var(--grid-gutter);
		display: grid;
		grid-template-columns: 1fr auto 1fr;
		align-items: center;
		gap: 28px;
		background: rgba(7, 7, 7, 0.96);
		border-bottom: 1px solid rgba(255, 255, 255, 0.14);
		color: #fff;
		position: sticky;
		top: 0;
		z-index: 50;
	}

	.brand,
	.brand img {
		display: block;
	}

	.brand img {
		width: 84px;
		height: auto;
	}

	.desktop-nav {
		display: flex;
		justify-content: center;
		gap: 36px;
		font-family: var(--font-sans);
		font-size: 15px;
		color: #999;
	}

	.desktop-nav a,
	.site-footer a {
		transition: opacity 180ms ease;
	}

	.desktop-nav a:hover,
	.site-footer a:hover {
		opacity: 0.58;
	}

	.nav-cta,
	.pill {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		min-height: 44px;
		padding: 0 24px;
		border: 1px solid currentColor;
		border-radius: 999px;
		font-family: var(--font-sans);
		font-size: 14px;
		font-weight: 700;
		line-height: 1;
		transition: transform 180ms ease, background 180ms ease, color 180ms ease;
	}

	.nav-cta:hover,
	.pill:hover {
		transform: translateY(-2px);
	}

	.nav-cta {
		justify-self: end;
		border-color: rgba(255, 255, 255, 0.75);
		background: transparent;
		color: #fff;
	}

	.mobile-nav {
		display: none;
	}

	.image-section {
		background-image: url("/images/website-v3-governance.webp");
		background-position: center;
		background-size: cover;
	}

	.hero {
		--section-stack-hold: 0px;
		height: calc(100svh - 112px);
		min-height: 704px;
		max-height: 1366px;
		display: grid;
		place-items: center;
		position: relative;
		color: #fff;
		transform: translate3d(0, var(--section-stack-hold), 0);
		will-change: transform;
		isolation: isolate;
	}

	.hero::before,
	.conversation::before {
		content: "";
		position: absolute;
		inset: 0;
		background: rgba(23, 12, 43, 0.08);
		z-index: -1;
	}

	.hero-content {
		width: min(920px, calc(100% - 48px));
		margin-top: -15px;
		text-align: center;
	}

	h1,
	h2,
	h3,
	p {
		margin-top: 0;
	}

	h1,
	h2,
	h3 {
		letter-spacing: -0.025em;
	}

	h1 {
