const faqs = [
	{
		question: "What is Agent in the Room?",
		answer: "Agent in the Room is our live, expert-led discovery method. A prepared agent questions the room one decision at a time while our directors steer the conversation toward a clear, buildable brief.",
	},
	{
		question: "What happens in the first call?",
		answer: "We spend thirty minutes understanding where the business is losing time, consistency or control, and whether an agentic approach is the right response.",
	},
	{
		question: "Do we need an AI strategy first?",
		answer: "No. We start with the business problem, identify where AI can create measurable value, and shape the technology around that need.",
	},
	{
		question: "How do you keep agents governed?",
		answer: "We design around approved knowledge, explicit review points, escalation routes and clear human decisions from the start.",
	},
	{
		question: "What do you deliver?",
		answer: "Depending on the brief, we deliver a tested agent, the operating controls around it, and a clear plan for deployment, ownership and improvement.",
	},
	{
		question: "Who should join an AIR session?",
		answer: "The people who understand the work, make the decisions and will own the outcome. We keep the group focused enough to move quickly.",
	},
	{
		question: "Can you work with our existing technology?",
		answer: "Yes. We shape the solution around your systems, policies and approved platforms rather than forcing a separate technology stack.",
	},
	{
		question: "How long does the process take?",
		answer: "The discovery starts with a thirty-minute call. The timing from AIR session to deployment depends on the scope, integrations and governance required.",
	},
	{
		question: "Where do you work?",
		answer: "We work with teams across the UK and internationally, with AIR sessions held face to face wherever that best supports the conversation.",
	},
	{
		question: "How do we get started?",
		answer: "Request a thirty-minute call. We will read your note, understand the context and recommend the most useful next step.",
	},
];

const faqColumns = [
	faqs.filter((_, index) => index % 2 === 0),
	faqs.filter((_, index) => index % 2 === 1),
];
---

<div class="v3-page">
	<header class="site-header">
		<a class="brand" href="#top" aria-label="Act AI Studio home">
			<img src="/act-logo.svg" alt="Act." width="1200" height="501" />
		</a>

		<nav class="desktop-nav" aria-label="Primary navigation">
			<a href="#opportunity">The Opportunity</a>
			<a href="#stages">The Method</a>
			<a href="#practice">The Practice</a>
			<a href="#governance">The Governance</a>
			<a href="#direction">The Direction</a>
			<a href="#footer">The Company</a>
		</nav>

		<a class="nav-cta" href="/contact">Request a 30 minute call</a>

		<details class="mobile-nav">
			<summary aria-label="Open navigation"><span></span><span></span></summary>
			<nav aria-label="Mobile navigation">
				<a href="#opportunity">The Opportunity</a>
				<a href="#stages">The Method</a>
				<a href="#practice">The Practice</a>
				<a href="#governance">The Governance</a>
				<a href="#direction">The Direction</a>
				<a href="#footer">The Company</a>
				<a href="/contact">Request a 30 minute call</a>
			</nav>
		</details>
	</header>

	<main id="top">
		<section class="hero image-section" aria-labelledby="hero-heading">
			<video class="hero-video" autoplay muted loop playsinline preload="metadata" poster="/images/website-v3-governance.webp" aria-hidden="true">
				<source src="/videos/hero-shadow-eyes.mp4" type="video/mp4" />
			</video>
			<div class="hero-content">
				<h1 id="hero-heading">Intelligence<br />needs direction.</h1>
				<p>Act AI Studio finds where your business creates value and shapes AI to accelerate the delivery of it.</p>
				<a class="pill pill-light" href="#air">Our expert-driven approach</a>
			</div>
		</section>

		<section class="section section-light possibility" id="opportunity" aria-labelledby="opportunity-heading" data-scroll-tone-section data-scroll-tone-entry="1.02">
			<div class="section-inner narrow-center" data-scroll-tone-block>
				<p class="section-label" data-scroll-tone-line>The Opportunity</p>
				<h2 id="opportunity-heading">
					<span class="tone-heading-line" data-scroll-tone-line>You don't need to know AI.</span>
					<span class="tone-heading-line" data-scroll-tone-line>We need to know your business.</span>
				</h2>
					<p class="section-intro possibility-intro" data-scroll-tone-line data-scroll-tone-step="0.65">
						<span>We start with how your business works, not with the technology.</span>
						<span>Then we shape practical agents around the places they can</span>
						<span>
							actually help, starting with <strong class="text-highlight">Agent in the Room&trade; (AIR)</strong>.
						</span>
					</p>
			</div>
		</section>

		<section class="section section-dark stages" id="stages" aria-labelledby="stages-heading" data-scroll-tone-section>
			<div class="section-inner stages-inner">
					<div class="narrow-center" data-scroll-tone-block>
						<p class="section-label section-label-dark" data-scroll-tone-line>The Method</p>
						<h2 id="stages-heading" data-scroll-tone-line>Start with a conversation.<br />Not a Deck.</h2>
						<p class="section-intro muted-light" data-scroll-tone-line>It starts with a call. We record it, steer it, and by the end we know what the problem is. <strong class="text-highlight">That becomes the brief.</strong></p>
					</div>

					<div class="stage-grid">
						{stages.map((stage) => (
							<article class="stage-item" data-scroll-tone-line>
								<div class="stage-title">
									<p class="stage-number">{stage.number}</p>
									<h3>{stage.title}</h3>
								</div>
								<p>{stage.copy}</p>
							</article>
						))}
				</div>

				<div class="air-header" id="air" data-scroll-tone-block>
					<h3 data-scroll-tone-line>Agent in the Room&trade;</h3>
					<p data-scroll-tone-line>A structured, face-to-face working session with our experts and an AI agent prepared for your business. Together, we turn conversation into a clear brief.</p>
				</div>

				<div class="air-carousel" aria-label="Agent in the Room interaction stages" aria-roledescription="carousel" data-air-carousel>
					<div class="air-panel">
						{airSlides.map((slide, index) => (
							<article class="air-slide" id={`air-slide-${index + 1}`} data-air-slide aria-label={`Frame ${index + 1} of ${airSlides.length}`}>
								<img src={slide.image} alt="" />
								<div class="air-copy">
									<strong>{slide.label}</strong>
									<p>{slide.copy}</p>
								</div>
							</article>
						))}
					</div>
					<div class="air-controls">
						<div class="carousel-dots" aria-label="Choose an AIR frame">
							<span class="air-active-pill" aria-hidden="true"><span class="air-dot-progress"></span></span>
							{airSlides.map((slide, index) => (
								<button type="button" aria-label={`Show frame ${index + 1}: ${slide.navName}`} aria-controls={`air-slide-${index + 1}`} aria-pressed={index === 0 ? "true" : "false"} data-air-dot>
									<span class="air-nav-label">
										<span class="air-nav-number">{slide.navNumber}</span>
										{slide.navName && <span class="air-nav-name">{slide.navName}</span>}
									</span>
								</button>
							))}
						</div>
						<button class="air-pause" type="button" aria-label="Pause AIR carousel" aria-pressed="false" data-air-pause>
							<span class="air-pause-bars" aria-hidden="true"></span>
						</button>
					</div>
					<div class="air-descriptions" aria-live="polite">
						{airSlides.map((slide, index) => (
							<p data-air-description hidden={index !== 0}>
								<strong>{slide.navName}:</strong> {slide.description}
							</p>
						))}
					</div>
				</div>
			</div>
		</section>

		<section class="section section-light practice" id="practice" aria-labelledby="practice-heading" data-scroll-tone-section>
			<div class="section-inner">
				<div class="narrow-center practice-heading" data-scroll-tone-block>
					<p class="section-label" data-scroll-tone-line>The Practice</p>
					<h2 id="practice-heading" data-scroll-tone-line>Where AI earns<br />its place.</h2>
				</div>

					<div class="practice-layout">
						<div class="practice-copy" data-scroll-tone-block>
							<p data-scroll-tone-line>Agents can increase business capacity by orders of magnitude. What matters is where they create value and how <strong class="text-highlight">people stay in control.</strong></p>
						</div>
					<div class="use-case-carousel" aria-label="Business use cases" aria-roledescription="carousel" data-practice-carousel>
						<div class="use-case-track" data-practice-track>
							{useCases.map((useCase, index) => (
								<article class:list={["use-case", { "use-case--extended": "artScale" in useCase }]} style={`--accent:${useCase.accent};--position:${useCase.position};--image:url(${useCase.image});--image-size:${"imageSize" in useCase ? useCase.imageSize : "cover"};--art-scale:${"artScale" in useCase ? useCase.artScale : 1};--art-offset-x:${"artOffsetX" in useCase ? useCase.artOffsetX : "0%"}`}>
									<div class="use-case-art" aria-hidden="true">
										{"video" in useCase && <video class="use-case-video" src={useCase.video} data-playback-rate={"videoPlaybackRate" in useCase ? useCase.videoPlaybackRate : 1.5} poster={useCase.image} muted loop playsinline preload="metadata" />}
									</div>
									<div class="use-case-meta"><div class="use-case-agent-title">{"agentTitleLines" in useCase ? <>{useCase.agentTitleLines[0]}<span class="use-case-agent-line">{useCase.agentTitleLines[1]}</span></> : useCase.sector.includes(" & ") ? <>{useCase.sector.split(" & ")[0]} &<span class="use-case-agent-line">{useCase.sector.split(" & ")[1]} Agent</span></> : <>Professional<span class="use-case-agent-line">Services Agent</span></>}</div><span class="use-case-count">{String(index + 1).padStart(2, "0")} / {String(useCases.length).padStart(2, "0")}</span></div>
									<div class="use-case-body">
										<h3>{useCase.title}</h3>
									</div>
									<div class="use-case-details">
										<div class="use-case-tag-row">{useCase.details.slice(0, 2).map((detail) => <span>{detail}</span>)}</div>
										<div class="use-case-tag-row"><span>{useCase.details[2]}</span></div>
									</div>
								</article>
							))}
						</div>
					</div>
					<div class="practice-controls">
						<button type="button" aria-label="Previous use case" data-practice-previous>&lt;</button>
						<button type="button" aria-label="Next use case" data-practice-next>&gt;</button>
					</div>
				</div>
			</div>
		</section>

		<section class="section section-dark governance" id="governance" aria-labelledby="governance-heading" data-scroll-tone-section>
			<div class="section-inner">
				<div class="narrow-center governance-heading" data-scroll-tone-block>
					<p class="section-label section-label-dark" data-scroll-tone-line>The Governance</p>
					<h2 id="governance-heading" data-scroll-tone-line>Your Policies.<br />Your Boundaries.</h2>
				</div>

				<div class="governance-layout">
					<div class="governance-copy" data-scroll-tone-block>
						<p data-scroll-tone-line>We embed agents with approved policies, review points and escalation routes. Every agent remains governed by your control procedures and human decisions.</p>
					</div>
					<figure class="governance-visual" aria-label="Governance areas surrounding an AI agent">
						<img class="governance-image governance-image--primary" src="/images/website-v3-governance.webp" alt="Transparent human profile with liquid gold highlights" width="1254" height="1254" />
						<img class="governance-image governance-image--left" src="/images/website-v3-governance.webp" alt="" width="1254" height="1254" />
						<img class="governance-image governance-image--right" src="/images/website-v3-governance.webp" alt="" width="1254" height="1254" />
						<img class="governance-image governance-image--small-left" src="/images/website-v3-governance.webp" alt="" width="1254" height="1254" />
						<img class="governance-image governance-image--small-right" src="/images/website-v3-governance.webp" alt="" width="1254" height="1254" />
						<span class="governance-tag governance-tag--security">Information Security</span>
						<span class="governance-tag governance-tag--data">Data Protection</span>
						<span class="governance-tag governance-tag--brand">Brand Guidelines</span>
						<span class="governance-tag governance-tag--esg">ESG</span>
						<span class="governance-tag governance-tag--employment">Employment</span>
						<span class="governance-tag governance-tag--regulations">Regulations</span>
						<span class="governance-tag governance-tag--ai">AI</span>
						<span class="governance-tag governance-tag--legal">Legal</span>
						<span class="governance-tag governance-tag--risk">Risk</span>
					</figure>
				</div>
			</div>
		</section>

		<section class="section section-light direction" id="direction" aria-labelledby="direction-heading" data-scroll-tone-section>
			<div class="section-inner">
					<div class="narrow-center direction-heading" data-scroll-tone-block>
						<p class="section-label section-label-dark" data-scroll-tone-line>The Direction</p>
						<h2 id="direction-heading" data-scroll-tone-line>We direct your AI.<br />We deliver the results.</h2>
						<p class="section-intro muted-light" data-scroll-tone-line>
							<span>AI led by creative thinking, backed by technical practice,</span>
							<span>driven by <strong class="text-highlight">outcomes, not reports.</strong></span>
						</p>
					</div>

				<div class="director-grid">
					<article data-scroll-tone-line>
						<h3>Jonny Bowker</h3>
						<p class="director-role">AI Director | Strategy</p>
						<p>Jonny Bowker is a Law Society of Scotland accredited AI Expert and practitioner. He has worked across Fortune 500 companies and mid-caps, spanning many sectors and functions. Through his Agent in the Room&trade; methodology, he turns business problems into clear briefs and directs what gets built.</p>
						<strong>Finds the problem worth solving.</strong>
					</article>
					<article data-scroll-tone-line>
						<h3>Mark Chatelier</h3>
						<p class="director-role">AI Director | Discovery</p>
						<p>Mark Chatelier is an AI generalist who leads discovery through creative thinking and direction, drawing on two decades leading creative teams on global accounts including HSBC, Audi and Vodafone. He listens first, then leads the conversation toward the real problem, applying the same discipline wherever it actually sits.</p>
						<strong>Shapes the brief before build starts.</strong>
					</article>
				</div>
			</div>
		</section>

		<section class="section image-section conversation" id="conversation" aria-labelledby="conversation-heading" data-scroll-tone-section>
			<div class="conversation-content narrow-center" data-scroll-tone-block>
				<p class="section-label section-label-dark" data-scroll-tone-line>The Conversation</p>
				<h2 id="conversation-heading" data-scroll-tone-line>Let's talk agents.</h2>
				<p class="conversation-lead" data-scroll-tone-line>What follows could change your business - <em>forever</em></p>
				<a class="pill pill-light" href="/contact">Request a 30 minute call</a>
			</div>
		</section>

		<section class="section section-light faq" id="faq" aria-labelledby="faq-heading">
			<div class="section-inner">
				<div class="narrow-center">
					<p class="section-label">FAQ</p>
					<h2 id="faq-heading" class="visually-hidden">Frequently asked questions</h2>
				</div>

				<div class="faq-grid">
					{faqColumns.map((column) => (
						<div class="faq-column">
							{column.map((faq) => (
								<details>
									<summary>{faq.question}<span aria-hidden="true">+</span></summary>
									<p>{faq.answer}</p>
								</details>
							))}
						</div>
					))}
				</div>
			</div>
		</section>
	</main>

	<footer class="site-footer" id="footer">
		<div class="footer-grid">
			<div class="footer-primary">
				<blockquote class="footer-quote">
					&ldquo;Just because it&rsquo;s a serious topic, it doesn&rsquo;t mean you have to be serious about the way you talk about it.&rdquo;
					<cite>John Humphrys</cite>
				</blockquote>
			</div>
			<nav aria-label="Information">
				<strong>Information</strong>
				<a href="/contact">Contact</a>
				<a href="/privacy">Privacy</a>
			</nav>
			<div class="footer-about">
				<strong>Advanced Analytica</strong>
				<div class="footer-about-copy">
					<p>MOVE FAST. STAY SAFE.</p>
					<p>Act AI Studio is the outreach and AI engagement arm of Advanced Analytica, a UK-based business.</p>
					<p>Most businesses are sitting on knowledge they can't use at speed. The people who hold it are busy, the documents that contain it are static, and the processes built around it weren't designed for AI.</p>
					<p>Advanced Analytica turns that knowledge into governed agentic systems that work in production. We bring the strategy, the specification, and the AI skills, so the business can move fast and stay safe.</p>
				</div>
			</div>
			<div class="footer-social">
				<a href="https://www.linkedin.com/company/advancedanalytica/" rel="noreferrer" target="_blank" aria-label="Advanced Analytica on LinkedIn">
					<img src="/icons/linkedin.svg" alt="" width="48" height="48" />
				</a>
			</div>
		</div>
		<div class="footer-wordmark" aria-hidden="true">
			<img src="/logos/ACT_White.svg" alt="" />
		</div>
	</footer>
</div>

<style>
	:global(html) {
		scroll-padding-top: 78px;
		overflow-x: hidden;
	}

	:global(body) {
		background: #101010;
		overflow-x: hidden;
	}

	.v3-page {
		--act-black: #101010;
		--act-dark-grey: #171719;
		--act-deep-grey: #111113;
		--act-white: #fcfcfc;
		--act-light-text: #8d8d95;
		--act-muted-text: #85858d;
		--act-white-rgb: 252 252 252;
		--act-light-rgb: 141 141 149;
		--paper: var(--act-black);
		--ink: var(--act-white);
		--dark: var(--act-black);
		--section-very-dark: var(--act-black);
		--section-dark: var(--act-dark-grey);
		--round: 48px;
		--grid-gap: 20px;
		--grid-gutter: clamp(24px, 4.167vw, 80px);
		--mobile-gutter: 32px;
		--section-pad-top: clamp(5.25rem, 5.208vw, 6.25rem);
		--section-pad-bottom: calc(var(--section-pad-top) * 2);
		--section-overlap: 0px;
		--type-display: clamp(3.35rem, 4.85vw, 5.75rem);
		--type-subhead: clamp(1.125rem, 1.354vw, 1.625rem);
		--type-intro: var(--type-subhead);
		--type-body-large: clamp(1rem, 1.1458vw, 1.375rem);
		--type-label: clamp(1rem, 1.25vw, 1.5rem);
		--type-small: clamp(0.875rem, 0.7813vw, 0.9375rem);
		--type-stage-title: var(--type-subhead);
		--tracking-heading: 0;
		--tracking-copy: -0.025em;
		--leading-subhead: 1.3;
		--glass-surface: linear-gradient(135deg, rgb(var(--act-white-rgb) / 0.26), rgb(var(--act-white-rgb) / 0.08) 42%, rgb(var(--act-white-rgb) / 0.18));
		--glass-rim: rgb(var(--act-white-rgb) / 0.2);
		--glass-shadow: inset 0 1px 0 rgb(var(--act-white-rgb) / 0.52), inset 0 -18px 42px rgb(var(--act-white-rgb) / 0.08), 0 18px 44px rgb(0 0 0 / 0.22);
		background: var(--dark);
		color: var(--ink);
		font-family: "MG12", "Helvetica Neue", Arial, sans-serif;
		overflow: clip;
		max-width: 100%;
	}

	.v3-page * {
		font-family: "MG12", "Helvetica Neue", Arial, sans-serif !important;
	}

	.v3-page :where(p, a, button, summary, figcaption, span, strong, cite, li) {
		letter-spacing: var(--tracking-copy);
	}

	.text-highlight {
		color: var(--act-white);
		font-weight: inherit;
	}

	a {
		color: inherit;
		text-decoration: none;
	}

	.site-header {
		height: 80px;
		padding: 0 var(--grid-gutter);
		display: grid;
		grid-template-columns: 1fr auto 1fr;
		align-items: center;
		gap: 28px;
		background: var(--act-white);
		border-bottom: 1px solid rgb(16 16 16 / 0.14);
		color: var(--act-black);
		position: sticky;
		top: 0;
		z-index: 50;
	}

	.brand,
	.brand img {
		display: block;
	}

	.brand img {
		width: auto;
		height: 35px;
		filter: brightness(0) saturate(100%);
	}

	.desktop-nav {
		display: flex;
		justify-content: center;
		gap: 36px;
		font-family: var(--font-sans);
		font-size: 15px;
		color: var(--act-black);
	}

	.desktop-nav a,
	.site-footer a {
		transition: opacity 180ms ease;
	}

	.desktop-nav a:hover,
	.site-footer a:hover {
		opacity: 0.58;
	}

	.nav-cta,
	.pill {
		--button-font-size: 14px;
		max-width: 100%;
		min-width: 0;
		display: inline-flex;
		align-items: center;
		justify-content: center;
		min-height: 44px;
		padding: 0 24px;
		border: 1px solid currentColor;
		border-radius: 999px;
		font-family: var(--font-sans);
		font-size: var(--button-font-size);
		font-weight: 700;
		line-height: 1;
		text-align: center;
		white-space: normal;
		transition: transform 180ms ease, background 180ms ease, color 180ms ease;
	}

	.nav-cta:hover,
	.pill:hover {
		transform: translateY(-2px);
	}

	.pill {
		--button-font-size: 18px;
	}

	.nav-cta {
		--button-font-size: 13px;
		justify-self: end;
		border-color: var(--act-black);
		background: transparent;
		color: var(--act-black);
	}

	.mobile-nav {
		display: none;
	}

	.image-section {
		background-image: url("/images/website-v3-governance.webp");
		background-position: center;
		background-size: cover;
	}

	.hero {
		height: calc(100svh - 112px);
		min-height: 704px;
		max-height: 1366px;
		display: grid;
		place-items: center;
		align-items: end;
		justify-items: center;
		box-sizing: border-box;
		padding: var(--section-pad-top) 0 var(--section-pad-bottom);
		position: relative;
		color: var(--act-white);
		isolation: isolate;
	}

	.hero::before,
	.conversation::before {
		content: "";
		position: absolute;
		inset: 0;
		background: rgb(2 2 3 / 0.32);
		z-index: -1;
	}

	.hero-video {
		width: 100%;
		height: 100%;
		position: absolute;
		inset: 0;
		object-fit: cover;
		object-position: center;
		z-index: -2;
	}

	.hero-content {
		width: min(1180px, calc(100% - 48px));
		text-align: center;
	}

	h1,
	h2,
	h3,
	p {
		margin-top: 0;
	}

	h1,
	h2,
	h3 {
		letter-spacing: var(--tracking-heading);
	}

	h1 {
		margin-bottom: 42px;
		font-size: calc(var(--type-display) * 1.2);
		font-weight: 700;
		line-height: 1.05;
		overflow-wrap: break-word;
	}

	.hero-content > p {
		max-width: 760px;
		margin: 0 auto clamp(5rem, 4.583vw, 5.5rem);
		color: var(--act-white);
	}

	.hero-content .pill {
		min-width: 350px;
		height: 60px;
	}

	.pill-light {
		border-color: var(--act-white);
		background: var(--act-white);
		color: var(--act-black);
	}

	.section {
		position: relative;
	}

	.possibility {
		z-index: 3;
	}

	.stages {
		z-index: 4;
	}

	.practice {
		z-index: 5;
	}

	.governance {
		z-index: 6;
	}

	.direction {
		z-index: 7;
	}

	.conversation {
		z-index: 8;
	}

	.faq {
		z-index: 9;
	}

	.section-light {
		background: var(--section-very-dark);
		color: var(--act-white);
	}

	.section-dark {
		background: var(--section-dark);
		color: var(--act-white);
	}

	.section-inner {
		width: min(1760px, calc(100% - (var(--grid-gutter) * 2)));
		margin: 0 auto;
		display: grid;
		grid-template-columns: repeat(12, minmax(0, 1fr));
		column-gap: var(--grid-gap);
	}

	.section-inner > *,
	.stage-grid > *,
	.director-grid > *,
	.faq-grid > * {
		min-width: 0;
	}

	.narrow-center {
		width: 100%;
		max-width: none;
		margin-inline: 0;
		grid-column: 2 / 12;
		text-align: center;
	}

	.section-label {
		width: fit-content;
		min-width: 0;
		margin: 0 auto 54px;
		padding: 0;
		border: 0;
		font-family: var(--font-sans);
		font-size: var(--type-label);
		font-weight: 700;
		letter-spacing: 0;
		line-height: 1.08;
		text-align: center;
		text-transform: none;
		color: var(--act-muted-text);
	}

	.section-label-dark {
		color: var(--act-muted-text);
	}

	.section-label,
	.section-label * {
		letter-spacing: 0;
	}

	.section h2 {
		font-size: var(--type-display);
		font-weight: 700;
		line-height: 1.05;
		letter-spacing: var(--tracking-heading);
	}

	.section-intro {
		max-width: 1260px;
		margin: 42px auto 0;
		font-family: var(--font-sans);
		color: var(--act-light-text);
	}

	.section-intro,
	.hero-content > p,
	.air-header p,
	.practice-copy p,
	.governance-copy p,
	.conversation-lead {
		font-size: var(--type-subhead);
		font-weight: 500;
		letter-spacing: var(--tracking-copy);
		line-height: var(--leading-subhead);
		text-wrap: balance;
	}

	.muted-light {
		color: var(--act-light-text);
	}

	.possibility {
		padding: var(--section-pad-top) 0 var(--section-pad-bottom);
	}

	.possibility .narrow-center {
		max-width: none;
	}

	.possibility .section-inner.narrow-center {
		width: min(1660px, calc(100% - clamp(96px, 10vw, 220px)));
		display: block;
		margin-inline: auto;
	}

	.possibility h2 {
		font-size: var(--type-display);
		text-wrap: balance;
	}

	.possibility .section-label {
		margin-bottom: 72px;
	}

	.possibility-intro {
		max-width: 1500px;
		margin-top: 62px;
		color: var(--act-light-text);
	}

	.possibility-intro > span {
		display: block;
	}

	.tone-heading-line {
		display: block;
	}

	.stages {
		padding: var(--section-pad-top) 0 var(--section-pad-bottom);
	}

	.stages-inner {
		max-width: 1760px;
	}

	.stages .narrow-center {
		max-width: none;
	}

	.stages .section-intro {
		max-width: 62ch;
		margin-inline: auto;
		text-wrap: balance;
	}

	.stage-grid {
		display: grid;
		grid-template-columns: repeat(2, minmax(0, 1fr));
		column-gap: 80px;
		row-gap: 0;
		grid-column: 3 / 11;
		margin-top: 130px;
	}

	.stage-item {
		display: grid;
		grid-template-columns: 140px minmax(0, 1fr);
		column-gap: 32px;
		align-content: start;
		padding: 34px 0 72px;
		border-top: 1px solid rgb(var(--act-white-rgb) / 0.24);
		text-align: left;
	}

	.stage-title {
		grid-column: 1;
		display: flex;
		flex-direction: column;
		gap: 0;
		font-family: var(--font-sans);
		font-size: var(--type-stage-title);
		font-weight: 700;
		line-height: 1.08;
	}

	.stage-number {
		margin: 0;
		font: inherit;
	}

	.stage-item h3 {
		margin: 0;
		font: inherit;
	}

	.stage-item > p:last-child {
		grid-column: 2;
		max-width: 540px;
		margin: 0;
		color: rgb(var(--act-light-rgb) / 0.96);
		font-family: var(--font-sans);
		font-size: var(--type-body-large);
		letter-spacing: var(--tracking-copy);
		line-height: 1.3;
	}

	.air-carousel {
		grid-column: 3 / 11;
		min-width: 0;
	}

	.air-header {
		grid-column: 3 / 11;
		margin: 58px auto 86px;
		text-align: center;
	}

	.air-header h3 {
		margin: 0;
		color: var(--act-white);
		font-size: clamp(2rem, 2.5vw, 3rem);
		font-weight: 700;
		letter-spacing: var(--tracking-copy);
		line-height: 1.02;
	}

	.air-header p {
		max-width: 760px;
		margin: 28px auto 0;
		color: var(--act-light-text);
	}

	.air-panel {
		aspect-ratio: 16 / 9;
		position: relative;
		overflow: hidden;
		border-radius: 22px;
		isolation: isolate;
		touch-action: pan-y pinch-zoom;
	}

	.air-panel::after {
		content: "";
		position: absolute;
		inset: 0;
		background: rgba(38, 38, 34, 0.32);
		z-index: -1;
	}

	.air-slide {
		position: absolute;
		inset: 0;
		opacity: 0;
		transform: translateX(100%) scale(1.025);
		transition: opacity 420ms ease, transform 820ms cubic-bezier(0.16, 1, 0.3, 1), filter 420ms ease;
		will-change: transform, opacity;
	}

	.air-slide[data-active="true"] {
		opacity: 1;
		transform: translateX(0) scale(1);
	}

	.air-slide[data-sliding="true"] {
		transition: none;
	}

	.air-slide img {
		width: 100%;
		height: 100%;
		position: absolute;
		inset: 0;
		object-fit: cover;
		z-index: -2;
	}

	.air-copy {
		height: 100%;
		display: grid;
		place-content: center;
		gap: 28px;
		padding: 40px;
		text-align: center;
		transition: opacity 360ms ease;
	}

	.air-copy strong {
		font-size: clamp(2.75rem, 3.9583vw, 4.75rem);
		font-weight: 500;
		line-height: 1;
	}

	.air-copy p {
		margin: 0;
		font-size: clamp(2rem, 2.5vw, 3rem);
		line-height: 0.98;
	}

	.air-controls {
		width: min(100%, 560px);
		max-width: 100%;
		display: flex;
		align-items: center;
		gap: 8px;
		margin: 42px auto 0;
		padding: 8px;
		border-radius: 9999px;
		border: 1px solid var(--glass-rim);
		background: rgb(16 16 16 / 0.72);
		box-shadow:
			inset 0 1px 0 rgb(var(--act-white-rgb) / 0.26),
			inset 0 -1px 0 rgb(0 0 0 / 0.26),
			0 18px 44px rgb(0 0 0 / 0.18);
		backdrop-filter: blur(22px) saturate(1.4);
		position: relative;
		z-index: 5;
	}

	.carousel-dots {
		flex: 1;
		height: 40px;
		display: grid;
		grid-template-columns: repeat(4, minmax(0, 1fr));
		align-items: center;
		border-radius: 9999px;
		position: relative;
	}

	.carousel-dots button {
		min-width: 0;
		height: 40px;
		display: flex;
		align-items: center;
		justify-content: center;
		padding: 0 10px;
		border: 0;
		border-radius: 9999px;
		background: transparent;
		color: var(--act-light-text);
		font: inherit;
		font-size: 14px;
		font-weight: 700;
		cursor: pointer;
		overflow: hidden;
		position: relative;
		z-index: 2;
		touch-action: manipulation;
		transition: background 180ms ease, color 180ms ease;
	}

	.air-active-pill {
		width: calc(100% / 4);
		position: absolute;
		inset-block: 0;
		left: 0;
		overflow: hidden;
		border-radius: 9999px;
		border: 0;
		background: linear-gradient(90deg, var(--act-black) 0%, rgb(6 6 8 / 0.98) 58%, rgb(var(--act-white-rgb) / 0.14) 100%);
		box-shadow: inset 0 1px 0 rgb(var(--act-white-rgb) / 0.16), 0 8px 24px rgb(0 0 0 / 0.18);
		transform: translateX(calc(var(--air-active-index, 0) * 100%));
		transition: transform 920ms cubic-bezier(0.22, 1, 0.36, 1);
		z-index: 1;
	}

	.air-dot-progress {
		position: absolute;
		inset: 0;
		display: block;
		background: linear-gradient(90deg, rgb(var(--act-white-rgb) / 0.32), rgb(var(--act-white-rgb) / 0.46));
		transform: scaleX(0);
		transform-origin: left center;
	}

	.air-nav-label {
		position: relative;
		z-index: 1;
		white-space: nowrap;
	}

	.air-nav-label {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		gap: 5px;
	}

	.air-nav-name {
		margin-left: 0;
	}

	.carousel-dots button[data-active="true"] {
		color: var(--act-white);
	}

	.air-active-pill .air-dot-progress {
		animation: air-progress var(--air-cycle-duration, 3200ms) linear forwards;
	}

	.air-carousel[data-paused="true"] .air-dot-progress {
		animation-play-state: paused;
	}

	.air-carousel[data-user-paused="true"] .air-dot-progress {
		opacity: 0;
		animation: none;
	}

	.carousel-dots button:hover,
	.carousel-dots button:focus-visible {
		color: var(--act-white);
	}

	.carousel-dots button:focus-visible {
		outline: 2px solid var(--act-white);
		outline-offset: 3px;
	}

	.air-pause {
		width: 40px;
		height: 40px;
		display: grid;
		place-items: center;
		border: 0;
		border-radius: 9999px;
		background: linear-gradient(135deg, rgb(2 2 3 / 0.98), rgb(24 24 28 / 0.86));
		box-shadow: inset 0 1px 0 rgb(var(--act-white-rgb) / 0.16), 0 10px 26px rgb(0 0 0 / 0.25);
		color: var(--act-white);
		cursor: pointer;
		touch-action: manipulation;
		transition: background 180ms ease, border-color 180ms ease, transform 180ms ease;
	}

	.air-pause:hover,
	.air-pause:focus-visible {
		background: rgb(40 40 44 / 0.98);
		outline: none;
		transform: translateY(-1px);
	}

	.air-pause:focus-visible {
		box-shadow: 0 0 0 3px rgb(var(--act-white-rgb) / 0.72);
	}

	.air-pause-bars {
		width: 14px;
		height: 18px;
		display: block;
		position: relative;
	}

	.air-pause-bars::before,
	.air-pause-bars::after {
		content: "";
		width: 5px;
		height: 18px;
		position: absolute;
		top: 0;
		border-radius: 3px;
		background: var(--act-white);
	}

	.air-pause-bars::before {
		left: 0;
	}

	.air-pause-bars::after {
		right: 0;
	}

	.air-carousel[data-paused="true"] .air-pause-bars::before {
		width: 0;
		height: 0;
		left: 2px;
		top: 0;
		border-top: 9px solid transparent;
		border-bottom: 9px solid transparent;
		border-left: 13px solid var(--act-white);
		border-radius: 0;
		background: transparent;
	}

	.air-carousel[data-paused="true"] .air-pause-bars::after {
		display: none;
	}

	@keyframes air-progress {
		from {
			transform: scaleX(0);
		}

		to {
			transform: scaleX(1);
		}
	}

	.air-descriptions {
		min-height: 52px;
		margin: 30px auto 0;
		text-align: center;
	}

	.air-descriptions p {
		max-width: 780px;
		margin: 0 auto;
		color: var(--act-light-text);
		font-family: var(--font-sans);
		font-size: var(--type-body-large);
		letter-spacing: var(--tracking-copy);
		line-height: 1.3;
		text-wrap: balance;
	}

	.air-descriptions p[hidden] {
		display: none;
	}

	.air-descriptions strong {
		color: var(--act-white);
		font-weight: 700;
	}

	.practice {
		padding: var(--section-pad-top) 0 var(--section-pad-bottom);
	}

	.practice-heading {
		max-width: none;
	}

	.practice .section-inner,
	.governance .section-inner {
		max-width: 1760px;
	}

	.practice-layout {
		display: grid;
		grid-template-columns: repeat(10, minmax(0, 1fr));
		column-gap: var(--grid-gap);
		grid-column: 1 / 13;
		align-items: start;
		margin-top: 68px;
	}

	.practice-copy {
		max-width: none;
		grid-column: 2 / 10;
		text-align: center;
	}

	.practice-copy p {
		color: rgb(var(--act-light-rgb) / 0.92);
	}

	.practice-copy p + p {
		margin-top: 12px;
		color: var(--act-light-text);
	}

	.use-case-carousel {
		width: 100vw;
		position: relative;
		left: 50%;
		overflow-x: auto;
		overflow-y: hidden;
		grid-column: 1 / 11;
		margin-top: 132px;
		padding-bottom: 0;
		scrollbar-width: none;
		touch-action: pan-x pan-y;
		transform: translateX(-50%);
	}

	.use-case-carousel::-webkit-scrollbar {
		display: none;
	}

	.use-case-track {
		display: flex;
		gap: clamp(34px, 5vw, 96px);
		width: max-content;
		padding-inline: 0;
	}

	.use-case {
		width: clamp(280px, 21.5vw, 410px);
		min-height: 0;
		aspect-ratio: 2 / 3;
		flex: 0 0 auto;
		padding: 30px;
		display: flex;
		flex-direction: column;
		position: relative;
		overflow: hidden;
		border-radius: 18px;
		background: var(--act-black);
		color: var(--act-white);
		isolation: isolate;
	}

	.practice-controls {
		display: flex;
		align-items: center;
		gap: 8px;
		grid-column: 1 / 11;
		justify-self: center;
		margin-top: 56px;
		padding: 8px;
		border-radius: 9999px;
		border: 1px solid var(--glass-rim);
		background: rgb(16 16 16 / 0.72);
		box-shadow:
			inset 0 1px 0 rgb(var(--act-white-rgb) / 0.26),
			inset 0 -1px 0 rgb(0 0 0 / 0.26),
			0 18px 44px rgb(0 0 0 / 0.18);
		backdrop-filter: blur(22px) saturate(1.4);
	}

	.practice-controls button {
		width: 40px;
		height: 40px;
		padding: 0;
		border: 0;
		border-radius: 999px;
		background: linear-gradient(135deg, rgb(2 2 3 / 0.98), rgb(24 24 28 / 0.86));
		box-shadow: inset 0 1px 0 rgb(var(--act-white-rgb) / 0.16), 0 10px 26px rgb(0 0 0 / 0.25);
		color: var(--act-white);
		font: inherit;
		font-size: 18px;
		font-weight: 700;
		line-height: 1;
		cursor: pointer;
		transition: background 180ms ease, color 180ms ease, transform 180ms ease;
	}

	.practice-controls button:hover,
	.practice-controls button:focus-visible {
		background: rgb(40 40 44 / 0.98);
		color: var(--act-white);
		transform: none;
		outline: none;
	}

	.use-case::before {
		content: "";
		position: absolute;
		inset: 0;
		background: linear-gradient(180deg, rgb(0 0 0 / 0.12), transparent 20%, transparent 60%, rgb(0 0 0 / 0.65) 100%);
		z-index: -1;
	}

	.use-case--extended::after {
		content: "";
		position: absolute;
		inset: 0;
		background: #000807;
		z-index: -3;
	}

	.use-case--extended .use-case-art {
		mask-image: linear-gradient(to right, transparent, black 6%, black 94%, transparent), linear-gradient(to bottom, transparent, black 6%, black 90%, transparent);
		mask-composite: intersect;
	}

	.use-case-art {
		position: absolute;
		inset: 0;
		background-image: var(--image);
		background-color: var(--act-black);
		background-position: var(--position);
		background-repeat: no-repeat;
		background-size: var(--image-size);
		filter: saturate(1.08);
		opacity: 1;
		transform: translateX(var(--art-offset-x)) scale(var(--art-scale));
		transform-origin: center;
		transition: transform 700ms cubic-bezier(0.16, 1, 0.3, 1), filter 700ms ease;
		will-change: transform;
		z-index: -2;
	}

	.use-case-video {
		position: absolute;
		inset: 0;
		width: 100%;
		height: 100%;
		object-fit: cover;
		object-position: var(--position);
	}

	@media (hover: hover) and (pointer: fine) {
		.use-case:hover .use-case-art {
