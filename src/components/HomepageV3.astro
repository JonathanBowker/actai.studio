const useCases = [
	{
		sector: "Manufacturing & supply",
		title: "Operational knowledge, exactly where the team needs it.",
		titleLines: ["Operational knowledge", "exactly where the", "team needs it."],
		image: "/images/use-case-art/portrait-01-wireframe.png",
		accent: "#6d42ff",
		position: "50% 42%",
		details: ["Production context", "Shift handovers", "Supplier actions"],
	},
	{
		sector: "Risk & compliance",
		agentTitleLines: ["Risk & compliance", "Agent"],
		title: "Clear review points, evidence and escalation.",
		titleLines: ["Clear review points", "evidence and", "escalation."],
		image: "/images/use-case-art/portrait_03-turquoise-contour.png",
		video: "/videos/card-02-cyan-contour-pingpong.mp4",
		artScale: 0.84,
		artOffsetX: "12%",
		accent: "#d02ca4",
		position: "50% 42%",
		details: ["Review evidence", "Escalation routes", "Control ownership"],
	},
	{
		sector: "Professional services",
		title: "Expert context, ready for the next brief.",
		titleLines: ["Expert context", "ready for the", "next brief."],
		image: "/images/use-case-art/portrait_02-neon-dreamscape-v2.png",
		accent: "#2548ff",
		position: "50% 50%",
		details: ["Brief context", "Expert handovers", "Client decisions"],
	},
	{
		sector: "Brand & media",
		title: "Content that stays useful and on brand.",
		titleLines: ["Content that", "stays useful and", "on brand."],
		image: "/images/use-case-art/portrait_02-liquid-gold.png",
		video: "/videos/card-04-molten-chrome-pingpong.mp4",
		videoPlaybackRate: 1,
		accent: "#ec3c8d",
		position: "50% 42%",
		details: ["Brand guidance", "Approval routes", "Channel context"],
	},
	{
		sector: "Finance & banking",
		title: "Keep reporting moving without losing control.",
		titleLines: ["Keep reporting", "moving without", "losing control."],
		image: "/images/use-case-art/portrait_07.png",
		accent: "#dd3295",
		position: "50% 42%",
		details: ["Board packs", "Variance notes", "Approval trails"],
	},
	{
		sector: "Land & estates",
		agentTitleLines: ["Land & estates", "Agent"],
		title: "Make estate knowledge easier to act on.",
		titleLines: ["Make estate", "knowledge easier", "to act on."],
		image: "/images/use-case-art/portrait-06-topographic.png",
		imageSize: "auto 120%",
		accent: "#7452ff",
		position: "50% calc(42% - 24px)",
		details: ["Asset context", "Maintenance records", "Local rules"],
