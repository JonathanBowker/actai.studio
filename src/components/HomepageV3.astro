<script>
	const stackedSections = [
		...document.querySelectorAll(".v3-page main > .hero, .v3-page main > .section"),
		...document.querySelectorAll(".v3-page > .site-footer"),
	];
	const stackMotionPreference = window.matchMedia("(prefers-reduced-motion: reduce)");
	let stackFrame = 0;

	const getLayoutTop = (element) => {
		let top = 0;
		let node = element;
		while (node instanceof HTMLElement) {
			top += node.offsetTop;
			node = node.offsetParent;
		}
		return top;
	};

	const updateSectionStack = () => {
		stackFrame = 0;
		const viewportHeight = window.innerHeight;

		stackedSections.forEach((section, index) => {
			if (!(section instanceof HTMLElement)) return;
			if (stackMotionPreference.matches) {
				section.style.removeProperty("--section-stack-hold");
				return;
			}

			const nextSection = stackedSections[index + 1];
			const nextTop = nextSection instanceof HTMLElement ? getLayoutTop(nextSection) : null;
			const transitionStart = nextTop === null ? 0 : Math.max(0, nextTop - viewportHeight);
			const transitionDistance = nextTop === null ? 0 : nextTop - transitionStart;
			const hold = Math.max(0, Math.min(transitionDistance, window.scrollY - transitionStart));
			section.style.setProperty("--section-stack-hold", `${hold.toFixed(2)}px`);
		});
	};

	const requestSectionStackUpdate = () => {
		if (stackFrame) return;
		stackFrame = window.requestAnimationFrame(updateSectionStack);
	};

	window.addEventListener("scroll", requestSectionStackUpdate, { passive: true });
	window.addEventListener("resize", requestSectionStackUpdate, { passive: true });
	window.addEventListener("load", requestSectionStackUpdate, { once: true });
	stackMotionPreference.addEventListener("change", requestSectionStackUpdate);
	document.fonts?.ready.then(requestSectionStackUpdate);
	const stackResizeObserver = new ResizeObserver(requestSectionStackUpdate);
	const stackMain = document.querySelector(".v3-page main");
	if (stackMain) stackResizeObserver.observe(stackMain);
	updateSectionStack();

	const alignSectionTarget = (target) => {
		const header = document.querySelector(".site-header");
		const headerHeight = header instanceof HTMLElement ? header.offsetHeight : 0;
		const sectionCurve = target.matches(".section, .site-footer")
			? Number.parseFloat(getComputedStyle(document.querySelector(".v3-page")).getPropertyValue("--round")) || 0
			: 0;
		const targetTop = getLayoutTop(target) + sectionCurve - headerHeight;
		window.scrollTo({ top: Math.max(0, targetTop), behavior: "auto" });
		window.requestAnimationFrame(updateSectionStack);
	};

	document.querySelectorAll('.v3-page a[href^="#"]').forEach((anchor) => {
		anchor.addEventListener("click", (event) => {
			if (!(anchor instanceof HTMLAnchorElement)) return;
			const targetId = anchor.hash.slice(1);
			const target = document.getElementById(targetId);
			if (!(target instanceof HTMLElement)) return;
			event.preventDefault();
			history.pushState(null, "", anchor.hash);
			anchor.closest("details")?.removeAttribute("open");
			alignSectionTarget(target);
		});
	});

	if (window.location.hash) {
		const initialTarget = document.getElementById(window.location.hash.slice(1));
		if (initialTarget instanceof HTMLElement) window.addEventListener("load", () => alignSectionTarget(initialTarget), { once: true });
	}

	document.querySelectorAll("[data-air-carousel]").forEach((carousel) => {
		const slides = [...carousel.querySelectorAll("[data-air-slide]")];
		const dots = [...carousel.querySelectorAll("[data-air-dot]")];
		const descriptions = [...carousel.querySelectorAll("[data-air-description]")];
		const reducedMotion = window.matchMedia("(prefers-reduced-motion: reduce)");
		let activeIndex = 0;
		let moving = false;
		let paused = false;
		let startX = null;
		let startY = null;
		const slideDuration = 1050;
		const slideEasing = "cubic-bezier(0.65, 0, 0.35, 1)";

		const render = () => {
			slides.forEach((slide, index) => {
				slide.dataset.active = String(index === activeIndex);
				slide.setAttribute("aria-hidden", String(index !== activeIndex));
				slide.style.zIndex = String(index === activeIndex ? 2 : 1);
			});
			dots.forEach((dot, index) => {
				dot.dataset.active = String(index === activeIndex);
				dot.setAttribute("aria-current", index === activeIndex ? "true" : "false");
				dot.setAttribute("aria-pressed", String(index === activeIndex));
			});
			descriptions.forEach((description, index) => {
				description.hidden = index !== activeIndex;
			});
		};

		const moveTo = (targetIndex, direction) => {
			if (moving || targetIndex === activeIndex) return;
			const outgoing = slides[activeIndex];
			const incoming = slides[targetIndex];

			if (reducedMotion.matches || typeof incoming.animate !== "function") {
				activeIndex = targetIndex;
				render();
				return;
			}

			moving = true;
			const travel = direction > 0 ? 104 : -104;
			const incomingStart = `translateY(${travel}%) scale(1.025)`;
			const centre = "translateY(0) scale(1)";
			const outgoingEnd = `translateY(${direction * -3}%) scale(0.985)`;

			incoming.dataset.sliding = "true";
			outgoing.dataset.sliding = "true";
			incoming.style.opacity = "1";
			incoming.style.transform = incomingStart;
			incoming.style.zIndex = "4";
			outgoing.style.opacity = "1";
			outgoing.style.transform = centre;
			outgoing.style.zIndex = "3";

			const incomingAnimation = incoming.animate(
				[{ transform: incomingStart }, { transform: centre }],
				{ duration: slideDuration, easing: slideEasing, fill: "forwards" },
			);
			outgoing.animate(
				[
					{ transform: centre, filter: "brightness(1)" },
					{ transform: outgoingEnd, filter: "brightness(0.72)" },
				],
				{ duration: slideDuration, easing: slideEasing, fill: "forwards" },
			);

			incomingAnimation.finished.then(() => {
				activeIndex = targetIndex;
				slides.forEach((slide) => slide.getAnimations().forEach((animation) => animation.cancel()));
				render();
				window.requestAnimationFrame(() => {
					incoming.removeAttribute("data-sliding");
					outgoing.removeAttribute("data-sliding");
					moving = false;
				});
			});
		};

		const move = (direction) => {
			const targetIndex = (activeIndex + direction + slides.length) % slides.length;
			moveTo(targetIndex, direction);
		};

		dots.forEach((dot, index) => dot.addEventListener("click", () => {
			paused = true;
			let direction = index > activeIndex ? 1 : -1;
			if (activeIndex === slides.length - 1 && index === 0) direction = 1;
			moveTo(index, direction);
		}));

		carousel.addEventListener("touchstart", (event) => {
			startX = event.touches[0]?.clientX ?? null;
			startY = event.touches[0]?.clientY ?? null;
			paused = true;
		}, { passive: true });

		carousel.addEventListener("touchend", (event) => {
			const endX = event.changedTouches[0]?.clientX;
			const endY = event.changedTouches[0]?.clientY;
			if (startX === null || startY === null || endX === undefined || endY === undefined) return;
			const distanceX = startX - endX;
			const distanceY = startY - endY;
			const distance = Math.abs(distanceX) > Math.abs(distanceY) ? distanceX : distanceY;
			if (Math.abs(distance) > 28) move(distance > 0 ? 1 : -1);
			startX = null;
			startY = null;
			paused = false;
		}, { passive: true });

		carousel.addEventListener("touchcancel", () => {
			startX = null;
			startY = null;
			paused = false;
		}, { passive: true });
		carousel.addEventListener("mouseenter", () => { paused = true; });
		carousel.addEventListener("mouseleave", () => { paused = false; });
		carousel.addEventListener("focusin", () => { paused = true; });
		carousel.addEventListener("focusout", () => { paused = false; });

		if (!reducedMotion.matches) {
			window.setInterval(() => {
				const bounds = carousel.getBoundingClientRect();
				if (!paused && bounds.top < window.innerHeight && bounds.bottom > 0) move(1);
			}, 3200);
		}

		render();
	});

	document.querySelectorAll("[data-practice-carousel]").forEach((carousel) => {
		if (!(carousel instanceof HTMLElement) || carousel.dataset.initialised === "true") return;
		const track = carousel.querySelector("[data-practice-track]");
		if (!(track instanceof HTMLElement)) return;
		carousel.dataset.initialised = "true";

		const originalCards = [...track.children].filter((card) => card instanceof HTMLElement);
		originalCards.forEach((card) => {
			const clone = card.cloneNode(true);
			if (!(clone instanceof HTMLElement)) return;
			clone.setAttribute("aria-hidden", "true");
			clone.dataset.practiceClone = "true";
			track.append(clone);
		});

		const controls = carousel.parentElement;
		const previous = controls?.querySelector("[data-practice-previous]");
		const next = controls?.querySelector("[data-practice-next]");
		const reducedMotion = window.matchMedia("(prefers-reduced-motion: reduce)");
		const handheldLayout = window.matchMedia("(max-width: 720px), (pointer: coarse) and (max-width: 920px)");
		let pauseUntil = 0;
		let lastTick = performance.now();
		window.requestAnimationFrame(() => {
			if (handheldLayout.matches) {
				carousel.scrollLeft = 0;
				return;
			}
			const firstCard = originalCards[0];
			if (!(firstCard instanceof HTMLElement)) return;
			const gap = Number.parseFloat(getComputedStyle(track).gap) || 0;
			carousel.scrollLeft = (firstCard.offsetWidth + gap) * 0.48;
		});

		const loopWidth = () => {
			const firstClone = track.querySelector("[data-practice-clone]");
			return firstClone instanceof HTMLElement ? firstClone.offsetLeft - track.offsetLeft : track.scrollWidth / 2;
		};

		const normalise = () => {
			if (handheldLayout.matches) return;
			const width = loopWidth();
			if (!width) return;
			while (carousel.scrollLeft >= width) carousel.scrollLeft -= width;
			while (carousel.scrollLeft < 0) carousel.scrollLeft += width;
		};

		const moveByCard = (direction) => {
			const firstCard = originalCards[0];
			if (!(firstCard instanceof HTMLElement)) return;
			const gap = Number.parseFloat(getComputedStyle(track).gap) || 0;
			pauseUntil = performance.now() + 3200;
			carousel.scrollBy({ left: direction * (firstCard.offsetWidth + gap), behavior: reducedMotion.matches ? "auto" : "smooth" });
			window.setTimeout(normalise, reducedMotion.matches ? 0 : 520);
		};

		previous?.addEventListener("click", () => {
			const width = loopWidth();
			if (carousel.scrollLeft < 2 && width) carousel.scrollLeft += width;
			moveByCard(-1);
		});
		next?.addEventListener("click", () => moveByCard(1));

		["wheel", "touchstart", "pointerdown", "focusin", "mouseenter"].forEach((eventName) => {
			carousel.addEventListener(eventName, () => {
				pauseUntil = performance.now() + 2600;
			}, { passive: true });
		});
		carousel.addEventListener("scroll", normalise, { passive: true });

		if (!reducedMotion.matches) {
			const animatePracticeCarousel = (time) => {
				const delta = Math.min(34, time - lastTick);
				lastTick = time;
				const bounds = carousel.getBoundingClientRect();
				const isVisible = bounds.top < window.innerHeight && bounds.bottom > 0;
				if (!handheldLayout.matches && isVisible && time >= pauseUntil) {
					carousel.scrollLeft += delta * 0.045;
					normalise();
				}
				window.requestAnimationFrame(animatePracticeCarousel);
			};
			window.requestAnimationFrame(animatePracticeCarousel);
		}
	});
</script>
