---
import "../styles/global.css";
import SeoGuard from "../components/SeoGuard.astro";
import { MeetingBookingSection, MeetingHeroSection, SiteHeader } from "../components/sections";

const bookingHref = "/contact";
const buttonClass = "inline-flex h-10 items-center justify-center border border-ink bg-acid px-3 text-xs leading-none text-ink no-underline transition-colors hover:bg-ink hover:text-paper sm:px-4 sm:text-sm";

const nextSteps = [
	{
		label: "01",
		title: "We read your note",
		body: "We look at the business context, the pressure you are trying to resolve and what you want AI to make possible.",
	},
	{
		label: "02",
		title: "30-minute conversation",
		body: "We talk through where you are, what is getting in the way and whether an agentic approach is the right route.",
	},
	{
		label: "03",
		title: "Clear next step",
		body: "You leave with a recommendation: what to explore, what to avoid and what would need to be scoped next.",
	},
];
---

<html lang="en">
	<head>
		<meta charset="utf-8" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="icon" href="/favicon.ico" />
		<meta name="viewport" content="width=device-width" />
		<meta name="generator" content={Astro.generator} />
		<meta
			name="description"
			content="Book a face to face meeting with Act to discuss where AI can make a real difference in your business."
		/>
		<SeoGuard />
		<title>Begin the conversation | actai.studio</title>
	</head>
	<body class="min-h-screen pt-[var(--header-height)]">
		<SiteHeader />

		<main>
			<MeetingHeroSection />

			<MeetingBookingSection {bookingHref} {buttonClass} {nextSteps} />
		</main>
	</body>
</html>
