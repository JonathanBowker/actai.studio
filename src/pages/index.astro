---
import "../styles/global.css";

const bookingHref = "/meeting";
const bookingButtonClass = "inline-flex h-10 items-center justify-center border border-ink bg-acid px-4 text-[16px] leading-none text-ink no-underline transition-colors hover:bg-ink hover:text-paper";

// Prospect-specific versions can swap these labels and image placeholders
// without changing the surrounding possibility section.
const agentSlots = [
	{ label: "operations agent", accent: "bg-acid" },
	{ label: "bookings agent", accent: "bg-sky" },
	{ label: "knowledge agent", accent: "bg-coral text-paper" },
	{ label: "production agent", accent: "bg-paper" },
];

const proofSignals = [
	["01", "outreach arm of Advanced Analytica"],
	["02", "agentic systems, automation and web production"],
	["03", "strategy, specification and build in one room"],
];

const heroCards = [
	{
		label: "01 context",
		title: "Business knowledge",
		copy: "What works, what stalls and what cannot be guessed from outside.",
		position: "lg:left-[52%] lg:top-[24%]",
	},
	{
		label: "02 opportunity",
		title: "Agent brief",
		copy: "The task, skills, boundaries and proof needed before anything gets built.",
		position: "lg:left-[68%] lg:top-[44%]",
	},
	{
		label: "03 system",
		title: "Working agent",
		copy: "A focused system that can finish real work inside the business.",
		position: "lg:left-[48%] lg:top-[64%]",
	},
];

const stalls = [
	{
		title: "you know AI matters",
		copy: "But the first useful move is unclear. We find the business problem before we talk about the technology.",
	},
	{
		title: "knowledge is stuck",
		copy: "It sits with busy people, static documents and workflows that were never designed for agents.",
	},
	{
		title: "automation stopped early",
		copy: "The simple work has been covered. The valuable work is specific, multi-step and full of judgement.",
	},
];

const methodSteps = [
	{
		label: "01 meet",
		copy: "Thirty minutes face to face. You bring the context, pressure and ambition. We listen for the work that should change.",
	},
	{
		label: "02 map",
		copy: "We bring AI into the conversation, test the shape of the opportunity and separate useful work from novelty.",
	},
	{
		label: "03 build",
		copy: "We turn what we learn into a brief: skills, functions, safeguards, systems and the first agentic build.",
	},
];

const directors = [
	{
		name: "Jonny Bowker",
		role: "Technical Director",
		phone: "+44 7552 045 721",
		email: "jonathan@advancedanalytica.co.uk",
		site: "advancedanalytica.co.uk",
		linkedin: "LinkedIn",
	},
	{
		name: "Mark Chatelier",
		role: "Creative Director",
		phone: "+44 7500 904 400",
		email: "mark@chateliercreative.com",
		site: "chateliercreative.com",
		linkedin: "LinkedIn",
	},
];

// Confirm public-logo clearance before replacing these placeholders with marks.
const clientLogos = [
	"Target",
	"Disney",
	"Castrol",
	"Code and Theory",
	"JPMorgan",
	"PwC",
];
---

<html lang="en">
	<head>
		<meta charset="utf-8" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="icon" href="/favicon.ico" />
		<meta name="viewport" content="width=device-width" />
		<meta name="generator" content={Astro.generator} />
		<meta
			name="description"
			content="actai.studio designs and ships practical AI systems, automations, and web experiences."
		/>
		<title>actai.studio</title>
		<style>
			.act-hero {
				--mx: 72%;
				--my: 42%;
				background:
					radial-gradient(circle at var(--mx) var(--my), rgba(216, 255, 61, 0.34), transparent 0 5.5rem, rgba(245, 245, 245, 0.08) 5.6rem 5.8rem, transparent 5.9rem),
					linear-gradient(120deg, rgba(17, 17, 17, 0.98) 0%, rgba(17, 17, 17, 0.86) 42%, rgba(17, 17, 17, 0.68) 100%),
					repeating-linear-gradient(90deg, rgba(245, 245, 245, 0.05) 0 1px, transparent 1px 9vw),
					repeating-linear-gradient(0deg, rgba(245, 245, 245, 0.04) 0 1px, transparent 1px 8vh),
					#111111;
			}

			.act-hero::before {
				content: "";
				position: absolute;
				inset: 0;
				pointer-events: none;
				background-image: radial-gradient(rgba(245, 245, 245, 0.12) 0.7px, transparent 0.7px);
				background-size: 5px 5px;
				mix-blend-mode: screen;
				opacity: 0.16;
			}

			.act-hero-lens {
				left: calc(var(--mx) - 4.5rem);
				top: calc(var(--my) - 4.5rem);
				box-shadow: 0 0 0 1px rgba(245, 245, 245, 0.38), inset 0 0 28px rgba(245, 245, 245, 0.15);
				transition: opacity 180ms ease;
			}

			.act-hero-card {
				backdrop-filter: blur(16px) saturate(1.2);
				-webkit-backdrop-filter: blur(16px) saturate(1.2);
			}

			.act-hero-card.is-active {
				background: #d8ff3d;
				color: #111111;
				border-color: #d8ff3d;
				transform: translateY(-0.5rem);
			}

			@media (max-width: 1023px), (prefers-reduced-motion: reduce) {
				.act-hero {
					--mx: 75%;
					--my: 28%;
				}

				.act-hero-lens {
					display: none;
				}
			}
		</style>
	</head>
	<body class="min-h-screen pt-[var(--header-height)]">
		<header class="fixed left-0 top-0 z-50 grid h-[var(--header-height)] w-full grid-cols-[1fr_auto] border-b border-ink bg-ink text-paper md:grid-cols-[minmax(180px,1fr)_auto_minmax(180px,1fr)]">
			<a
				href="/"
				class="flex items-center px-4 text-paper no-underline transition-colors hover:bg-paper hover:text-ink sm:px-6"
				aria-label="act-ai studio"
			>
				<svg
					class="h-7 w-auto"
					viewBox="360 289.86 1200.07 500.75"
					role="img"
					aria-hidden="true"
				>
					<path fill="currentColor" d="M1001.43 538.23c29.46 0 54.12 20.28 60.97 47.62h137.8c-8.22-97.46-94.04-174.14-198.78-174.14-110.17 0-199.48 84.82-199.48 189.45s89.31 189.45 199.48 189.45 190.56-76.68 198.78-174.14h-137.8c-6.85 27.34-31.51 47.62-60.97 47.62-34.75 0-62.93-28.17-62.93-62.93s28.17-62.93 62.93-62.93Z" />
					<path fill="currentColor" d="M645.48 289.86H507.44L360.07 784.04h150.46l19.25-70.49h131.09l19.25 70.49h150.46L683.21 289.86h-37.73ZM562.62 593.3l32.71-119.78 32.71 119.78h-65.42Z" />
					<path fill="currentColor" d="M1439.38 536.94V416.7h-45.8V289.86h-141.11V416.7h-45.81v120.24h45.81v247.09h141.11V536.94h45.8Z" />
					<path fill="currentColor" d="M1418.96 663.79h141.11v120.25h-141.11z" />
				</svg>
			</a>
			<nav class="hidden items-center justify-center gap-8 px-6 text-[16px] md:flex">
				<a class="leading-[var(--header-height)] text-paper no-underline hover:bg-paper hover:px-1 hover:text-ink" href="#work">work</a>
				<a class="leading-[var(--header-height)] text-paper no-underline hover:bg-paper hover:px-1 hover:text-ink" href="#method">method</a>
			</nav>
			<a
				href={bookingHref}
				class={`${bookingButtonClass} mx-4 my-2 sm:mx-6`}
			>
				Book a call
			</a>
		</header>

		<main>
			<section class="act-hero relative isolate min-h-[calc(100svh-var(--header-height))] overflow-hidden border-b border-ink text-paper" data-act-hero>
				<canvas class="absolute inset-0 z-0 h-full w-full opacity-80" data-act-network aria-hidden="true"></canvas>
				<div class="act-hero-lens pointer-events-none absolute z-10 hidden h-36 w-36 rounded-full border border-paper/45 bg-paper/5 lg:block" aria-hidden="true"></div>

				<div class="relative z-20 grid min-h-[calc(100svh-var(--header-height))] gap-10 p-4 sm:p-6 lg:grid-cols-[minmax(320px,40vw)_1fr] lg:p-10">
					<div class="flex flex-col justify-between gap-16">
						<div>
							<p class="mb-10 text-[1rem] leading-[1.25]">A face to face route into useful <span class="uppercase">AI</span></p>
							<h1 class="max-w-[11ch] font-display text-[clamp(4.5rem,15vw,16rem)] font-bold leading-[0.78] tracking-normal">
								AI needs direction
							</h1>
						</div>
						<div class="grid max-w-[35rem] gap-6">
							<p class="text-[clamp(1.45rem,3vw,3.1rem)] leading-[1.04]">
								You know your business. We find the agentic system worth building.
							</p>
							<div class="flex flex-wrap items-center gap-4">
								<a href={bookingHref} class={`${bookingButtonClass} border-acid`}>Book a call</a>
								<p class="max-w-[20rem] text-[1rem] leading-[1.25] text-paper/75">
									Thirty minutes. One real business problem. A clear next step.
								</p>
							</div>
						</div>
					</div>

					<div class="relative min-h-[420px] lg:min-h-0">
						<div class="absolute right-0 top-0 hidden h-40 w-40 border border-paper/30 bg-paper/5 lg:block"></div>
						<div class="absolute bottom-8 right-8 hidden h-64 w-64 border border-dashed border-paper/35 lg:block"></div>
						{
							heroCards.map((card, index) => (
								<article
									class={`act-hero-card relative mb-4 border border-paper/35 bg-ink/55 p-5 text-paper transition duration-300 sm:p-6 lg:absolute lg:mb-0 lg:w-[18rem] ${card.position}`}
									data-act-card
									data-card-index={index}
								>
									<p class="mb-10 text-sm leading-none text-current/65">{card.label}</p>
									<h2 class="text-[1.35rem] font-bold leading-[1.05]">{card.title}</h2>
									<p class="mt-4 text-[1rem] leading-[1.25] text-current/80">{card.copy}</p>
								</article>
							))
						}
						<a
							href={bookingHref}
							class="act-hero-card relative grid border border-acid bg-acid p-5 text-ink no-underline transition hover:bg-paper sm:p-6 lg:absolute lg:bottom-[10%] lg:left-[62%] lg:w-[18rem]"
							data-act-card
							data-card-index="3"
						>
							<span class="mb-10 text-sm leading-none">04 next step</span>
							<span class="text-[1.35rem] font-bold leading-[1.05]">Book a call</span>
							<span class="mt-4 text-[1rem] leading-[1.25]">Leave with direction, not another AI talking point.</span>
						</a>
					</div>
				</div>
			</section>

			<section class="grid border-b border-paper/20 bg-ink text-paper md:grid-cols-3">
				{proofSignals.map(([label, copy]) => (
					<div class="border-b border-paper/20 p-5 md:border-b-0 md:border-r last:md:border-r-0 sm:p-6">
						<p class="mb-12 text-sm leading-none text-acid">{label}</p>
						<p class="max-w-[20rem] text-[1.1rem] leading-[1.25]">{copy}</p>
					</div>
				))}
			</section>

			<section id="work" class="border-b border-ink">
				<div class="grid gap-10 px-4 py-10 sm:px-6 lg:grid-cols-[minmax(220px,34vw)_1fr] lg:px-10">
					<p class="sticky top-24 max-w-[22rem] text-[1rem] leading-[1.25]">Where it stalls</p>
					<h2 class="max-w-[13ch] font-display text-[clamp(3.4rem,11vw,11rem)] font-bold leading-[0.8]">
						most AI work stops before it works
					</h2>
				</div>
				<div class="grid border-t border-ink md:grid-cols-3">
					{stalls.map((stall, index) => (
						<article class="min-h-[300px] border-b border-ink p-5 md:border-b-0 md:border-r last:md:border-r-0 sm:p-6">
							<p class="mb-16 text-sm leading-none">{String(index + 1).padStart(2, "0")}</p>
							<h3 class="font-display text-[clamp(2.7rem,7vw,6rem)] font-bold leading-[0.82]">{stall.title}</h3>
							<p class="mt-8 max-w-[28rem] text-[1rem] leading-[1.25]">{stall.copy}</p>
						</article>
					))}
				</div>
			</section>

			<section class="grid border-b border-ink md:grid-cols-2">
				<article class="min-h-[360px] border-b border-ink p-5 md:border-b-0 md:border-r sm:p-6 lg:p-10">
					<p class="mb-16 text-[1rem] leading-[1.25]">The difference</p>
					<h2 class="font-display text-[clamp(3rem,9vw,9rem)] font-bold leading-[0.8]">chatbot</h2>
					<p class="mt-8 max-w-[28rem] text-[1.1rem] leading-[1.25]">
						A chatbot holds a conversation. You lead. It responds.
					</p>
				</article>
				<article class="min-h-[360px] p-5 sm:p-6 lg:p-10">
					<p class="mb-16 text-[1rem] leading-[1.25]">The difference</p>
					<h2 class="font-display text-[clamp(3rem,9vw,9rem)] font-bold leading-[0.8]">agent</h2>
					<p class="mt-8 max-w-[32rem] text-[1.1rem] leading-[1.25]">
						An agent gets it done. Give it a job, the skills to do it, the boundaries to work within, and it finishes the task itself.
					</p>
				</article>
			</section>

			<section class="border-b border-ink">
				<div class="grid gap-10 px-4 py-10 sm:px-6 lg:grid-cols-[minmax(220px,34vw)_1fr] lg:px-10">
					<div>
						<p class="sticky top-24 max-w-[22rem] text-[1.1rem] leading-[1.25]">
							To find the answer, we start with you. What works. What doesn't. What could.
						</p>
					</div>
					<div>
						<h2 class="max-w-[15ch] font-display text-[clamp(3rem,10vw,10rem)] font-bold leading-[0.8]">
							<span class="uppercase">AI</span> can do almost anything
						</h2>
						<p class="mt-8 max-w-[34rem] text-[1.35rem] leading-[1.12]">
							That's not the point. The question is what <span class="uppercase">AI</span> can really do for your business.
						</p>
					</div>
				</div>
				<div class="grid border-t border-ink md:grid-cols-4">
					{
						agentSlots.map((slot, index) => (
							<article class="min-h-[260px] border-b border-ink p-5 md:border-b-0 md:border-r last:md:border-r-0 sm:p-6">
								<div class={`mb-16 aspect-[4/3] border border-ink ${slot.accent}`}>
									<div class="flex h-full items-center justify-center text-[1rem] leading-none">
										{String(index + 1).padStart(2, "0")}
									</div>
								</div>
								<p class="border-t border-ink pt-2 text-[1rem] leading-[1.25]">{slot.label}</p>
							</article>
						))
					}
				</div>
				<div class="border-t border-ink px-4 py-8 sm:px-6 lg:px-10">
					<a href={bookingHref} class={`${bookingButtonClass} w-fit`}>Book a call</a>
				</div>
			</section>

			<section id="method" class="grid border-b border-ink lg:grid-cols-[1fr_2fr]">
				<div class="border-b border-ink bg-sky p-4 pb-12 sm:p-6 sm:pb-16 lg:border-b-0 lg:border-r">
					<p class="font-display text-[clamp(3rem,9vw,9rem)] font-bold leading-[0.8]">then we act</p>
				</div>
				<div class="grid md:grid-cols-3">
					{methodSteps.map((step) => (
						<div class="border-b border-ink p-5 md:border-b-0 md:border-r last:md:border-r-0 sm:p-6">
							<h2 class="text-[1rem] font-bold">{step.label}</h2>
							<p class="mt-10 leading-[1.25]">{step.copy}</p>
						</div>
					))}
				</div>
			</section>

			<section class="grid border-b border-ink lg:grid-cols-[1fr_2fr]">
				<div class="border-b border-ink p-4 sm:p-6 lg:border-b-0 lg:border-r">
					<div class="flex h-28 w-28 items-center justify-center border border-ink bg-paper text-center text-[0.9rem] leading-[1.05]">
						Repay.<br>Earth
					</div>
				</div>
				<div class="p-4 sm:p-6 lg:p-10">
					<h2 class="max-w-[16ch] font-display text-[clamp(3rem,9vw,9rem)] font-bold leading-[0.8]">
						we build the technology. we govern the footprint. we repay the earth.
					</h2>
					<div class="mt-10 grid gap-6 text-[1.1rem] leading-[1.35] lg:grid-cols-2">
						<p>Repay.Earth is our commitment to making the impact of <span class="uppercase">AI</span> visible and doing something about it.</p>
						<p>As <span class="uppercase">AI</span> becomes more embedded in business, so does its environmental cost. Repay.Earth gives us a way to address that impact when the need arises, working with established measurement, offsetting and restoration partners.</p>
						<p>It connects the technology we build with verified natural capital to reduce and repay its impact. Because progress shouldn't come at the Earth's expense.</p>
					</div>
				</div>
			</section>

			<section class="grid border-b border-ink lg:grid-cols-[1fr_1fr]">
				<div class="border-b border-ink p-4 sm:p-6 lg:border-b-0 lg:border-r lg:p-10">
					<p class="mb-8 text-[1rem] leading-[1.25]">Start with a conversation</p>
					<h2 class="max-w-[11ch] font-display text-[clamp(3.8rem,11vw,12rem)] font-bold leading-[0.78]">
						book a call. leave with direction.
					</h2>
					<p class="mt-8 max-w-[31rem] text-[1.25rem] leading-[1.15]">
						We will tell you what to explore, what to avoid and what would need to be scoped next.
					</p>
					<a href={bookingHref} class={`${bookingButtonClass} mt-10 w-fit`}>Book a call</a>
				</div>
				<div class="grid md:grid-cols-2">
					{directors.map((director) => (
						<article class="border-b border-ink p-5 md:border-b-0 md:border-r last:md:border-r-0 sm:p-6">
							<p class="text-[1.35rem] font-bold leading-[1.1]">{director.name}</p>
							<p class="mt-2 leading-[1.25]">{director.role}</p>
							<div class="mt-10 grid gap-2 leading-[1.25]">
								<p>{director.phone}</p>
								<p>{director.email}</p>
								<p>{director.site}</p>
								<p>{director.linkedin}</p>
							</div>
						</article>
					))}
				</div>
			</section>

			<section class="px-4 py-12 sm:px-6 lg:px-10">
				<div class="grid gap-10 lg:grid-cols-[minmax(220px,34vw)_1fr]">
					<p class="max-w-[22rem] text-[1.1rem] leading-[1.25]">
						Act is the outreach arm of Advanced Analytica.
					</p>
					<div>
						<p class="max-w-[54rem] text-[clamp(1.8rem,4vw,4.5rem)] leading-[0.98]">
							Most businesses already have the knowledge. The problem is putting it to work.
						</p>
						<p class="mt-8 max-w-[44rem] text-[1.1rem] leading-[1.35]">
							It sits with busy people, in static documents and processes that were never built for <span class="uppercase">AI</span>. We turn that into agentic systems that actually run in production. And we bring the strategy, specification and skills to make it real.
						</p>
						<div class="mt-10 grid border-t border-ink sm:grid-cols-2 lg:grid-cols-3">
							{clientLogos.map((logo) => (
								<div class="border-b border-ink p-5 text-[1rem] leading-[1.25] sm:border-r">
									{logo}
								</div>
							))}
						</div>
						<p class="mt-4 max-w-[42rem] text-sm leading-[1.35]">
							Placeholder client names from private deck. Confirm clearance before replacing with public logo marks.
						</p>
					</div>
				</div>
			</section>
		</main>

		<footer class="grid gap-8 px-4 py-6 text-[16px] sm:px-6 md:grid-cols-3 lg:px-10">
			<p><strong>act</strong> studio</p>
			<p>The outreach arm of Advanced Analytica</p>
			<a class="text-ink underline decoration-ink underline-offset-4 hover:bg-ink hover:text-paper" href="mailto:hello@actai.studio">hello@actai.studio</a>
		</footer>
		<script>
			const hero = document.querySelector("[data-act-hero]");
			const canvas = document.querySelector("[data-act-network]");
			const cards = [...document.querySelectorAll("[data-act-card]")];
			const reducedMotion = window.matchMedia("(prefers-reduced-motion: reduce)");

			if (hero && canvas) {
				const ctx = canvas.getContext("2d");
				let width = 0;
				let height = 0;
				let frame = 0;
				let active = 0;
				let pointer = { x: 0.72, y: 0.42, live: false };
				const nodes = Array.from({ length: 34 }, (_, index) => ({
					x: (Math.sin(index * 12.9898) * 43758.5453) % 1,
					y: (Math.sin(index * 78.233) * 24634.6345) % 1,
					r: 2 + (index % 4),
					speed: 0.002 + (index % 5) * 0.00035,
				})).map((node) => ({
					...node,
					x: Math.abs(node.x),
					y: Math.abs(node.y),
				}));

				function resize() {
					const rect = hero.getBoundingClientRect();
					const ratio = Math.min(window.devicePixelRatio || 1, 2);
					width = rect.width;
					height = rect.height;
					canvas.width = Math.max(1, Math.floor(width * ratio));
					canvas.height = Math.max(1, Math.floor(height * ratio));
					canvas.style.width = `${width}px`;
					canvas.style.height = `${height}px`;
					ctx.setTransform(ratio, 0, 0, ratio, 0, 0);
				}

				function setActive(index) {
					active = index;
					cards.forEach((card) => {
						card.classList.toggle("is-active", Number(card.dataset.cardIndex) === active);
					});
				}

				function draw() {
					frame += 1;
					ctx.clearRect(0, 0, width, height);

					const px = pointer.x * width;
					const py = pointer.y * height;
					const activeNode = nodes[active * 8 + 4] || nodes[0];
					activeNode.x += ((pointer.x || 0.72) - activeNode.x) * 0.035;
					activeNode.y += ((pointer.y || 0.42) - activeNode.y) * 0.035;

					for (const node of nodes) {
						node.y += Math.sin(frame * node.speed + node.x * 4) * 0.00045;
						if (node.y > 1.04) node.y = -0.04;
						if (node.y < -0.04) node.y = 1.04;
					}

					for (let i = 0; i < nodes.length; i += 1) {
						const a = nodes[i];
						for (let j = i + 1; j < nodes.length; j += 1) {
							const b = nodes[j];
							const ax = a.x * width;
							const ay = a.y * height;
							const bx = b.x * width;
							const by = b.y * height;
							const dist = Math.hypot(ax - bx, ay - by);
							if (dist < 190) {
								const nearPointer = Math.max(0, 1 - Math.hypot((ax + bx) / 2 - px, (ay + by) / 2 - py) / 320);
								ctx.strokeStyle = `rgba(216, 255, 61, ${0.09 + nearPointer * 0.24})`;
								ctx.lineWidth = 1;
								ctx.beginPath();
								ctx.moveTo(ax, ay);
								ctx.lineTo(bx, by);
								ctx.stroke();
							}
						}
					}

					nodes.forEach((node, index) => {
						const x = node.x * width;
						const y = node.y * height;
						const pulse = index === active * 8 + 4 ? 1 : Math.max(0, 1 - Math.hypot(x - px, y - py) / 260);
						ctx.fillStyle = pulse > 0.4 ? "#d8ff3d" : "rgba(245, 245, 245, 0.55)";
						ctx.beginPath();
						ctx.arc(x, y, node.r + pulse * 4, 0, Math.PI * 2);
						ctx.fill();
					});

					if (!reducedMotion.matches) requestAnimationFrame(draw);
				}

				hero.addEventListener("pointermove", (event) => {
					const rect = hero.getBoundingClientRect();
					pointer = {
						x: Math.max(0, Math.min(1, (event.clientX - rect.left) / rect.width)),
						y: Math.max(0, Math.min(1, (event.clientY - rect.top) / rect.height)),
						live: true,
					};
					hero.style.setProperty("--mx", `${pointer.x * 100}%`);
					hero.style.setProperty("--my", `${pointer.y * 100}%`);
				});

				cards.forEach((card) => {
					card.addEventListener("mouseenter", () => setActive(Number(card.dataset.cardIndex)));
					card.addEventListener("focusin", () => setActive(Number(card.dataset.cardIndex)));
				});

				resize();
				setActive(0);
				window.addEventListener("resize", resize);
				draw();
			}
		</script>
	</body>
</html>
