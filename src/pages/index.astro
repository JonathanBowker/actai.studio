---
import "../styles/global.css";
import "../styles/index/index.css";
import SeoGuard from "../components/SeoGuard.astro";
import { isReviewStaging } from "../lib/siteEnvironment";
import {
	SiteHeader,
	ScrollToneController,
	HeroSection,
	LeadershipIntroSection,
	LeadershipAreasSection,
	ProcessSection,
	RippleEffectsSection,
	ResultsSection,
	DirectionSection,
	CallToActionSection,
	FaqSection,
	FooterSection,
} from "../components/sections";

const bookingHref = "/meeting";
const showReviewPlaceholders = isReviewStaging(Astro.url);

const useCaseImages = Array.from(
	{ length: 6 },
	(_, index) => `/images/use-case-shapes/shape-${String(index + 1).padStart(2, "0")}.jpg`,
);

const caseStudies = [
	{
		filter: "regulated",
		kicker: "Finance & Banking",
		title: "Keep reporting moving without losing control",
		copy: "A scoped agent can gather the right inputs, check them against agreed rules and prepare review-ready updates for finance teams.",
		points: ["Board packs", "Variance notes", "Approval trails"],
	},
	{
		filter: "built",
		kicker: "Land & Estates",
		title: "Make estate knowledge easier to act on",
		copy: "Bring leases, maintenance history, access rules and local knowledge into an agent that can answer practical questions with sources.",
		points: ["Asset context", "Maintenance records", "Local rules"],
	},
	{
		filter: "customer",
		kicker: "Hospitality & Entertainment",
		title: "Support bookings, staffing and guest detail",
		copy: "Use agents to organise the moving parts around events, enquiries, schedules and service notes without replacing human judgement.",
		points: ["Booking context", "Staff handovers", "Guest follow-up"],
	},
	{
		filter: "supply",
		kicker: "Transport & Logistics",
		title: "Help teams respond when plans change",
		copy: "A practical agent can surface constraints, flag knock-on effects and prepare clear updates when routes, stock or timings move.",
		points: ["Route changes", "Stock signals", "Customer updates"],
	},
	{
		filter: "supply",
		kicker: "Agriculture & Food",
		title: "Turn seasonal knowledge into usable guidance",
		copy: "Agents can help teams retrieve field notes, compliance detail and supplier context when timing and local judgement matter.",
		points: ["Field notes", "Supplier context", "Compliance checks"],
	},
	{
		filter: "regulated",
		kicker: "Risk & Compliance",
		title: "Make sensitive work easier to review",
		copy: "Shape agents with clear boundaries, evidence trails and escalation points so regulated work stays visible and accountable.",
		points: ["Evidence trails", "Review loops", "Escalation rules"],
	},
	{
		filter: "supply",
		kicker: "Technology & Software",
		title: "Turn product knowledge into better support",
		copy: "A focused agent can help teams answer product, implementation and support questions using the latest internal context.",
		points: ["Product notes", "Support patterns", "Release context"],
	},
	{
		filter: "knowledge",
		kicker: "Consulting & Operations",
		title: "Make delivery knowledge repeatable",
		copy: "Capture how experienced people diagnose, plan and deliver work, then shape that judgement into agent support for the wider team.",
		points: ["Delivery playbooks", "Client context", "Repeatable steps"],
	},
	{
		filter: "customer",
		kicker: "Brand & Media",
		title: "Keep content useful and on brand",
		copy: "Agents can help generate, review and adapt content against your standards, with clear approval before anything goes live.",
		points: ["Tone checks", "Asset reuse", "Approval flow"],
	},
	{
		filter: "built",
		kicker: "Property & Real Estate",
		title: "Make portfolio detail easier to navigate",
		copy: "Help teams find lease detail, tenant context and maintenance history without searching across scattered folders and inboxes.",
		points: ["Lease detail", "Tenant context", "Maintenance history"],
	},
	{
		filter: "regulated",
		kicker: "Healthcare & Care",
		title: "Support admin without losing sensitivity",
		copy: "A carefully scoped agent can help with non-clinical coordination, policy lookup and handover preparation while keeping review points clear.",
		points: ["Policy lookup", "Care coordination", "Review points"],
	},
	{
		filter: "knowledge",
		kicker: "Education & Training",
		title: "Turn learning material into guided support",
		copy: "Shape course content, staff guidance and learner questions into an agent that supports understanding without replacing teaching.",
		points: ["Course content", "Learner support", "Staff guidance"],
	},
	{
		filter: "knowledge",
		kicker: "Professional Services",
		title: "Make client context easier to reuse",
		copy: "Agents can help teams prepare briefs, retrieve precedent and keep client knowledge consistent across busy delivery teams.",
		points: ["Client briefs", "Precedent lookup", "Delivery notes"],
	},
	{
		filter: "customer",
		kicker: "Retail & Ecommerce",
		title: "Connect product, service and stock context",
		copy: "Give teams faster access to product detail, customer issues and fulfilment context so support stays practical and accurate.",
		points: ["Product detail", "Service patterns", "Fulfilment context"],
	},
	{
		filter: "supply",
		kicker: "Manufacturing & Supply",
		title: "Make operational knowledge easier to apply",
		copy: "A focused agent can surface process notes, supplier detail and quality checks when teams need practical answers quickly.",
		points: ["Process notes", "Supplier detail", "Quality checks"],
	},
];

const leadershipSectors = caseStudies.slice(0, 8).map((study, index) => ({
	kicker: study.kicker,
	title: study.title,
	points: study.points,
	image: study.kicker === "Manufacturing & Supply"
		? "/images/use-case-shapes/manufacturing-neon.png"
		: useCaseImages[index % useCaseImages.length],
	number: index + 1,
}));

const leadershipSectorColumns = [
	leadershipSectors.slice(0, 4),
	leadershipSectors.slice(4, 8),
];

const caseStudyFilters = [
	{ label: "All sectors", value: "all" },
	{ label: "Regulated work", value: "regulated" },
	{ label: "Built environment", value: "built" },
	{ label: "Customer-facing", value: "customer" },
	{ label: "Knowledge work", value: "knowledge" },
	{ label: "Product & supply", value: "supply" },
];

const resultStats = [
	{
		value: "[Measure needed]",
		label: "Agent in the Room™ outcome measure, pending a verified source.",
	},
	{
		value: "[Measure needed]",
		label: "Time returned to teams, pending a verified source.",
	},
	{
		value: "[Evidence needed]",
		label: "Business value evidence, pending a verified source.",
	},
	{
		value: "[Evidence needed]",
		label: "Delivery evidence, pending a verified source.",
	},
];

const faqs = [
	["What is Agent in the Room™?", "Agent in the Room™ is a live working session. An AI agent, briefed on your business, joins the room through a speaker. Your people and our director question it together. You leave with a scoped AI direction."],
	["Do we need to know which agent we want before we speak?", "No. Start with the pressure, delay or repeated work inside the business. We help uncover the right use case, test whether AI is appropriate and define what a useful agent would need to know and do."],
	["Do you only advise, or do you build the agents too?", "We do both. Act AI Studio can set the direction, structure the knowledge and build working agents into your business. Delivery can include agent instructions, knowledge architecture, workflows, review points, governance and implementation support."],
	["What kinds of work can an agent take on?", "Agents are most useful where skilled people lose time searching for information, repeating answers, preparing documents, checking rules or moving work between systems. The right agent supports judgement and removes process work rather than pretending every task should be automated."],
	["Can an agent use our existing business knowledge?", "Yes. We shape approved documents, guidance, processes and expert knowledge into a clear source for the agent. Its scope, sources and escalation points are defined so people can understand where an answer came from and when human review is required."],
	["How do you manage risk, security and governance?", "Risk is designed into the work from the beginning. We define access, approved knowledge, boundaries, review points and escalation rules before an agent is treated as ready. The level of control is matched to the sensitivity of the work and your existing policies."],
	["What is an Act AI Studio knowledge pack?", "A knowledge pack is a compressed ZIP containing the diagnosis, agent prompt and supporting knowledge for a specific use case. It can be uploaded directly to a compatible chat assistant or unzipped and loaded as individual files."],
	["Will this replace our people?", "The aim is to give skilled people time back. Agents handle repeatable process work, retrieve context and prepare outputs so your team can spend more time applying judgement, building relationships and making decisions."],
	["Who do you work with?", "We work directly with business leaders in mid-caps, scale-ups and larger businesses. Act AI Studio is most useful when there is a real operational problem, access to the people who understand it and a willingness to turn business knowledge into a working capability."],
	["How do we get started?", "Start with a conversation. In 30 minutes, we can understand where time is being lost, what has already been tried and whether there is a valuable next step. If there is, we will recommend a clear scope before asking you to commit to delivery."],
];
---

<html lang="en">
	<head>
		<meta charset="utf-8" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="icon" href="/favicon.ico" />
		<meta name="viewport" content="width=device-width" />
		<meta name="generator" content={Astro.generator} />
		<meta name="description" content="Act AI Studio finds where AI creates value in your business, then shapes and builds the right agent." />
		<SeoGuard />
		<title>Act AI Studio | Find the value before building the agent</title>
	</head>
	<body class="pt-[var(--header-height)]">
<SiteHeader />
<ScrollToneController />

		<main class="bg-[#ebe9e4]">
			<HeroSection />
			<LeadershipIntroSection />
			<ProcessSection {bookingHref} />
			<LeadershipAreasSection {leadershipSectorColumns} />
			<RippleEffectsSection />
			<DirectionSection {bookingHref} />
			{showReviewPlaceholders && <ResultsSection {resultStats} {bookingHref} />}
			<CallToActionSection {bookingHref} />
			<FaqSection {faqs} />
			<FooterSection {bookingHref} />
		</main>

		<script>
			const trackSiteEvent = (name, detail = {}) => {
				window.dispatchEvent(new CustomEvent(name, { detail }));
				window.dataLayer?.push({ event: name, ...detail });
			};

			document.querySelectorAll("[data-agent-card-click]").forEach((link) => {
				link.addEventListener("click", () => {
					trackSiteEvent("agent_card_click", { agentSlug: link.dataset.agentCardClick });
				});
			});

			const revealItems = document.querySelectorAll(".reveal");

			const observer = new IntersectionObserver((entries) => {
				entries.forEach((entry) => {
					if (entry.isIntersecting) {
						entry.target.classList.add("is-visible");
						if (entry.target.querySelector("[data-frame-stack]")) {
							window.setTimeout(() => entry.target.classList.add("frame-ready"), 1500);
						}
					}
				});
			}, { threshold: 0.12 });

			revealItems.forEach((item) => observer.observe(item));

			const caseCards = [...document.querySelectorAll("[data-case-card]")];
			const caseRevealButton = document.querySelector("[data-case-reveal]");
			const caseRevealWrap = caseRevealButton?.closest("div");
			const caseFilter = document.querySelector("[data-case-filter]");
			const caseFilterToggle = document.querySelector("[data-case-filter-toggle]");
			const caseFilterMenu = document.querySelector("[data-case-filter-menu]");
			const caseFilterLabel = document.querySelector("[data-case-filter-label]");
			let activeCaseFilter = "all";
			let visibleCaseCount = 3;

			const matchingCaseCards = () => caseCards.filter((card) => activeCaseFilter === "all" || card.dataset.caseFilterValue === activeCaseFilter);

			const setCaseFilterOpen = (open) => {
				if (!caseFilterToggle || !caseFilterMenu) return;
				caseFilterToggle.setAttribute("aria-expanded", String(open));
				caseFilterMenu.classList.toggle("hidden", !open);
			};

			const updateCaseCards = () => {
				const matching = matchingCaseCards();
				caseCards.forEach((card) => {
					const match = matching.includes(card);
					const visible = match && matching.indexOf(card) < visibleCaseCount;
					card.toggleAttribute("hidden", !visible);
					if (visible) window.requestAnimationFrame(() => card.classList.add("is-visible"));
				});
				caseRevealWrap?.toggleAttribute("hidden", matching.length <= visibleCaseCount);
			};

			caseFilterToggle?.addEventListener("click", () => {
				setCaseFilterOpen(caseFilterToggle.getAttribute("aria-expanded") !== "true");
			});

			document.querySelectorAll("[data-case-filter-option]").forEach((option) => {
				option.addEventListener("click", () => {
					activeCaseFilter = option.dataset.caseFilterOption || "all";
					visibleCaseCount = 3;
					if (caseFilterLabel) caseFilterLabel.textContent = option.dataset.caseFilterName || "All sectors";
					setCaseFilterOpen(false);
					updateCaseCards();
				});
			});

			document.addEventListener("click", (event) => {
				if (caseFilter && !caseFilter.contains(event.target)) setCaseFilterOpen(false);
			});

			caseRevealButton?.addEventListener("click", () => {
				visibleCaseCount += 3;
				updateCaseCards();
			});

			updateCaseCards();

			const featureNavItems = [...document.querySelectorAll("[data-feature-nav]")];
			const featureCards = [...document.querySelectorAll("[data-feature-card]")];
			const featureTrack = document.querySelector("[data-feature-track]");
			let featurePauseUntil = 0;
			const setActiveFeature = (activeIndex) => {
				featureNavItems.forEach((item) => {
					const active = item.dataset.featureNav === String(activeIndex);
					item.dataset.active = String(active);
					item.setAttribute("aria-pressed", String(active));
				});
			};

			featureNavItems.forEach((item) => {
				item.addEventListener("click", () => {
					const target = document.getElementById(item.dataset.featureTarget);
					if (!target) return;

					setActiveFeature(item.dataset.featureNav);
					const reduceMotion = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
					if (featureTrack && window.innerWidth >= 1024) {
						featurePauseUntil = performance.now() + 5200;
						const top = target.offsetTop - featureTrack.offsetTop - featureTrack.clientHeight * 0.1;
						featureTrack.scrollTo({ top, behavior: reduceMotion ? "auto" : "smooth" });
					} else {
						const offset = 96;
						const top = target.getBoundingClientRect().top + window.scrollY - offset;
						window.scrollTo({ top, behavior: reduceMotion ? "auto" : "smooth" });
					}
				});
			});

			const featureObserver = new IntersectionObserver((entries) => {
				const visibleEntry = entries
					.filter((entry) => entry.isIntersecting)
					.sort((a, b) => b.intersectionRatio - a.intersectionRatio)[0];

				if (visibleEntry) setActiveFeature(visibleEntry.target.dataset.featureCard);
			}, {
				root: window.innerWidth >= 1024 ? featureTrack : null,
				rootMargin: "-28% 0px -36% 0px",
				threshold: [0.18, 0.35, 0.52, 0.7],
			});

			featureCards.forEach((card) => featureObserver.observe(card));

			if (featureTrack && window.innerWidth >= 1024 && !window.matchMedia("(prefers-reduced-motion: reduce)").matches) {
				let featureDirection = 1;
				let featureLastTick = performance.now();
				featurePauseUntil = performance.now() + 1400;

				["wheel", "touchstart", "pointerdown"].forEach((eventName) => {
					featureTrack.addEventListener(eventName, () => {
						featurePauseUntil = performance.now() + 3200;
					}, { passive: true });
				});

				const animateFeatureTrack = (time) => {
					const delta = Math.min(34, time - featureLastTick);
					featureLastTick = time;
					const maxScroll = Math.max(0, featureTrack.scrollHeight - featureTrack.clientHeight);

					if (maxScroll && time >= featurePauseUntil) {
						featureTrack.scrollTop += featureDirection * delta * 0.045;
						if (featureTrack.scrollTop >= maxScroll - 2) featureDirection = -1;
						if (featureTrack.scrollTop <= 2) featureDirection = 1;
					}

					requestAnimationFrame(animateFeatureTrack);
				};

				requestAnimationFrame(animateFeatureTrack);
			}

			const sectorColumns = [...document.querySelectorAll("[data-sector-column]")];
			if (!window.matchMedia("(prefers-reduced-motion: reduce)").matches) {
				let sectorMotionStarted = false;
				const startSectorColumnMotion = () => {
					if (sectorMotionStarted) return;
					sectorMotionStarted = true;

					const getSectorStep = (column) => {
						const firstCard = column.firstElementChild;
						const secondCard = firstCard?.nextElementSibling;
						if (!(firstCard instanceof HTMLElement)) return 0;
						if (secondCard instanceof HTMLElement) return secondCard.offsetTop - firstCard.offsetTop;
						return firstCard.offsetHeight;
					};

					const scrollState = sectorColumns.map((column, index) => {
						const step = getSectorStep(column);
						column.scrollTop = index % 2 === 0 ? 0 : step * 0.45;
						return {
							column,
						};
					});

					let lastTick = performance.now();
					const animateSectorColumns = (time) => {
						const delta = Math.min(34, time - lastTick);
						lastTick = time;

						scrollState.forEach((state) => {
							const step = getSectorStep(state.column);
							if (!step) return;

							state.column.scrollTop += delta * 0.08;
							while (state.column.scrollTop >= step && state.column.children.length > 1) {
								const firstCard = state.column.firstElementChild;
								if (!firstCard) break;
								state.column.append(firstCard);
								state.column.scrollTop -= step;
							}
						});

						requestAnimationFrame(animateSectorColumns);
					};

					requestAnimationFrame(animateSectorColumns);
				};

				requestAnimationFrame(startSectorColumnMotion);
			}

			document.querySelectorAll("[data-use-case-track]").forEach((track) => {
				const scrollByCard = (direction) => {
					const card = track.querySelector(".use-case-card");
					const distance = card ? card.getBoundingClientRect().width + 24 : track.clientWidth * 0.8;
					track.scrollBy({
						left: direction * distance,
						behavior: window.matchMedia("(prefers-reduced-motion: reduce)").matches ? "auto" : "smooth",
					});
				};

				track.parentElement?.querySelectorAll("[data-use-case-scroll]").forEach((button) => {
					button.addEventListener("click", () => {
						scrollByCard(Number(button.dataset.useCaseScroll || 1));
					});
				});

			});

			const triageTracks = [...document.querySelectorAll("[data-triage-track]")];
			const triageMobileTrack = document.querySelector("[data-triage-mobile-track]");
			const reducedMotion = window.matchMedia("(prefers-reduced-motion: reduce)");
			const scrollTriageTrack = (track, direction) => {
				const card = track.querySelector(".use-case-card");
				const distance = card ? card.getBoundingClientRect().width + 24 : track.clientWidth * 0.8;
				track.scrollBy({ left: direction * distance, behavior: reducedMotion.matches ? "auto" : "smooth" });
			};

			document.querySelectorAll("[data-triage-scroll]").forEach((button) => {
				button.addEventListener("click", () => {
					const direction = Number(button.dataset.triageScroll || 1);
					if (window.innerWidth <= 760 && triageMobileTrack) {
						scrollTriageTrack(triageMobileTrack, direction);
						return;
					}
					triageTracks.forEach((track) => scrollTriageTrack(track, direction));
				});
			});

			[...triageTracks, triageMobileTrack].filter(Boolean).forEach((track) => {
				track.addEventListener("wheel", (event) => {
					if (Math.abs(event.deltaY) <= Math.abs(event.deltaX)) return;
					track.scrollLeft += event.deltaY;
					event.preventDefault();
				}, { passive: false });
			});

			requestAnimationFrame(() => triageTracks.forEach((track) => { track.scrollLeft = 0; }));

			document.querySelectorAll("[data-frame-stack]").forEach((stack) => {
				const layers = [...stack.querySelectorAll("[data-frame-layer]")];
				let progress = 0;
				let touchY = null;

				const applyFrameProgress = () => {
					const revealDistance = stack.clientHeight * 0.56;
					const revealOrder = [layers[4], layers[3], layers[2], layers[1]];

					layers.forEach((layer) => {
						layer.style.setProperty("--frame-peek", "0px");
					});

					revealOrder.forEach((layer, orderIndex) => {
						if (!layer) return;
						const segmentStart = orderIndex / revealOrder.length;
						const segmentEnd = (orderIndex + 1) / revealOrder.length;
						const localProgress = Math.min(1, Math.max(0, (progress - segmentStart) / (segmentEnd - segmentStart)));
						layer.style.setProperty("--frame-peek", `${localProgress * revealDistance}px`);
					});
				};

				const updateFrameProgress = (delta) => {
					const next = Math.min(1, Math.max(0, progress + delta / 680));
					const changed = next !== progress;
					progress = next;
					applyFrameProgress();
					return changed;
				};

				const resetTouch = () => {
					touchY = null;
				};

				const handleTouchMove = (event) => {
					const nextY = event.touches[0]?.clientY;
					if (touchY === null || nextY === undefined) return;
					const changed = updateFrameProgress(touchY - nextY);
					touchY = nextY;
					if (changed) event.preventDefault();
				};

				stack.addEventListener("wheel", (event) => {
					const changed = updateFrameProgress(-event.deltaY);
					if (changed) event.preventDefault();
				}, { passive: false });

				stack.addEventListener("touchstart", (event) => {
					touchY = event.touches[0]?.clientY ?? null;
				}, { passive: true });

				stack.addEventListener("touchmove", handleTouchMove, { passive: false });
				stack.addEventListener("touchend", resetTouch);
				stack.addEventListener("touchcancel", resetTouch);

				applyFrameProgress();
			});

			document.querySelectorAll("[data-faq]").forEach((item) => {
				const button = item.querySelector("button");
				button?.addEventListener("click", () => {
					const open = item.dataset.open === "true";
					item.dataset.open = String(!open);
					button.setAttribute("aria-expanded", String(!open));
				});
			});
		</script>
	</body>
</html>
