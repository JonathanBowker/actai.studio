---
import "../styles/global.css";

const services = [
	{
		title: "plan",
		label: "01",
		copy: "intelligence needs direction. you know the business. we find where AI can impact it.",
		accent: "bg-acid",
	},
	{
		title: "agent",
		label: "02",
		copy: "a chatbot holds a conversation. an agent completes a task with skills, boundaries and purpose.",
		accent: "bg-sky",
	},
	{
		title: "govern",
		label: "03",
		copy: "we turn what we learn into a structured scope: skills, functions, safeguards and what comes next.",
		accent: "bg-coral text-paper",
	},
];

const specimens = [
	["direction", "Intelligence needs a business problem"],
	["difference", "Chatbots respond. Agents finish the job"],
	["possibility", "AI can do almost anything. That is not the point"],
	["dialogue", "Bring an informed agent into the room"],
	["scope", "Skills, functions, boundaries, next steps"],
	["govern", "Build the technology. Govern the footprint"],
];
---

<html lang="en">
	<head>
		<meta charset="utf-8" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="icon" href="/favicon.ico" />
		<meta name="viewport" content="width=device-width" />
		<meta name="generator" content={Astro.generator} />
		<meta
			name="description"
			content="actai.studio designs and ships practical AI systems, automations, and web experiences."
		/>
		<title>actai.studio</title>
	</head>
	<body class="min-h-screen pt-[var(--header-height)] lowercase">
		<header class="fixed left-0 top-0 z-50 grid h-[var(--header-height)] w-full grid-cols-[1fr_auto] border-b border-ink bg-ink text-paper md:grid-cols-[minmax(180px,1fr)_auto_minmax(180px,1fr)]">
			<a
				href="/"
				class="flex items-center px-4 text-paper no-underline transition-colors hover:bg-paper hover:text-ink sm:px-6"
				aria-label="act-ai studio"
			>
				<svg
					class="h-7 w-auto"
					viewBox="360 289.86 1200.07 500.75"
					role="img"
					aria-hidden="true"
				>
					<path fill="currentColor" d="M1001.43 538.23c29.46 0 54.12 20.28 60.97 47.62h137.8c-8.22-97.46-94.04-174.14-198.78-174.14-110.17 0-199.48 84.82-199.48 189.45s89.31 189.45 199.48 189.45 190.56-76.68 198.78-174.14h-137.8c-6.85 27.34-31.51 47.62-60.97 47.62-34.75 0-62.93-28.17-62.93-62.93s28.17-62.93 62.93-62.93Z" />
					<path fill="currentColor" d="M645.48 289.86H507.44L360.07 784.04h150.46l19.25-70.49h131.09l19.25 70.49h150.46L683.21 289.86h-37.73ZM562.62 593.3l32.71-119.78 32.71 119.78h-65.42Z" />
					<path fill="currentColor" d="M1439.38 536.94V416.7h-45.8V289.86h-141.11V416.7h-45.81v120.24h45.81v247.09h141.11V536.94h45.8Z" />
					<path fill="currentColor" d="M1418.96 663.79h141.11v120.25h-141.11z" />
				</svg>
			</a>
			<nav class="hidden items-center justify-center gap-8 px-6 text-[16px] md:flex">
				<a class="leading-[var(--header-height)] text-paper no-underline hover:bg-paper hover:px-1 hover:text-ink" href="#work">work</a>
				<a class="leading-[var(--header-height)] text-paper no-underline hover:bg-paper hover:px-1 hover:text-ink" href="#method">method</a>
				<a class="leading-[var(--header-height)] text-paper no-underline hover:bg-paper hover:px-1 hover:text-ink" href="mailto:hello@actai.studio">contact</a>
			</nav>
			<a
				href="mailto:hello@actai.studio"
				class="flex items-center justify-end px-4 text-[16px] text-paper no-underline transition-colors hover:bg-paper hover:text-ink sm:px-6"
			>
				(0) inbox
			</a>
		</header>

		<main>
			<section class="grid min-h-[calc(100svh-var(--header-height))] grid-rows-[1fr_auto] border-b border-ink">
				<div class="grid items-end gap-12 px-4 py-8 sm:px-6 lg:grid-cols-[minmax(220px,34vw)_1fr] lg:px-10">
					<p class="max-w-[28rem] text-[clamp(1.45rem,3.2vw,3.25rem)] leading-[1.02] normal-case">
						Intelligence needs direction.<br>
						You know your business. <br>
						We know the <span class="uppercase">AI</span> opportunity. 
					</p>

					<h1 class="max-w-[12ch] font-display text-[clamp(4.2rem,17vw,18rem)] font-bold leading-[0.78] tracking-normal">
						TOGETHER WE ACT
					</h1>
				</div>
				<div class="grid border-t border-ink md:grid-cols-3">
					{
						services.map((service) => (
							<article class="group min-h-[220px] border-b border-ink p-4 transition-colors hover:bg-ink hover:text-paper md:border-b-0 md:border-r last:md:border-r-0 sm:p-6">
								<div class={`mb-16 inline-flex h-10 min-w-10 items-center justify-center border border-ink px-3 text-sm group-hover:border-paper ${service.accent}`}>
									{service.label}
								</div>
								<h2 class="font-display text-[clamp(2.5rem,7vw,6.5rem)] font-bold leading-[0.82]">
									{service.title}
								</h2>
								<p class="mt-8 max-w-[28rem] text-[1rem] leading-[1.25]">{service.copy}</p>
							</article>
						))
					}
				</div>
			</section>

			<section id="work" class="px-4 py-10 sm:px-6 lg:px-10">
				<div class="grid gap-6 lg:grid-cols-[minmax(220px,34vw)_1fr]">
					<div>
						<p class="sticky top-24 max-w-[22rem] text-[1.1rem] leading-[1.25]">
							Most businesses already have the knowledge. it sits with busy people, static documents and processes that were never built for <span class="uppercase">AI</span>.
						</p>
					</div>
					<ul class="grid border-t border-ink md:grid-cols-2">
						{
							specimens.map(([title, detail], index) => (
								<li class="group min-h-[230px] border-b border-ink md:odd:border-r">
									<a href="mailto:hello@actai.studio" class="flex h-full flex-col justify-between p-5 text-ink no-underline transition-colors hover:bg-ink hover:text-paper sm:p-6">
										<div class="flex items-start justify-between gap-4">
											<span class="text-sm">{String(index + 1).padStart(2, "0")}</span>
											<span class="h-4 w-4 border border-current bg-current transition-transform group-hover:rotate-45" />
										</div>
										<div>
											<p class="mb-4 border-t border-current pt-2 text-[1rem] leading-[1.25] normal-case">
												{title === "possibility" ? <><span class="uppercase">AI</span> can do almost anything. That is not the point</> : detail}
											</p>
											<h3 class="font-display text-[clamp(2.75rem,8vw,7rem)] font-bold leading-[0.82]">{title}</h3>
										</div>
									</a>
								</li>
							))
						}
					</ul>
				</div>
			</section>

			<section id="method" class="grid border-y border-ink lg:grid-cols-[1fr_2fr]">
				<div class="border-b border-ink bg-sky p-4 pb-12 sm:p-6 sm:pb-16 lg:border-b-0 lg:border-r">
					<p class="font-display text-[clamp(3rem,9vw,9rem)] font-bold leading-[0.8]">act. and change.</p>
				</div>
				<div class="grid md:grid-cols-3">
					<div class="border-b border-ink p-5 md:border-b-0 md:border-r sm:p-6">
						<h2 class="text-[1rem] font-bold">01 ask</h2>
						<p class="mt-10 leading-[1.25]">we bring an informed agent into the room. you ask it anything. we talk to it about your problem.</p>
					</div>
					<div class="border-b border-ink p-5 md:border-b-0 md:border-r sm:p-6">
						<h2 class="text-[1rem] font-bold">02 drive</h2>
						<p class="mt-10 leading-[1.25]">you see how it can be directed. we answer what it cannot, and separate useful work from novelty.</p>
					</div>
					<div class="p-5 sm:p-6">
						<h2 class="text-[1rem] font-bold">03 build</h2>
						<p class="mt-10 leading-[1.25]">we define the skills, functions and boundaries, then build agentic systems that can work in production.</p>
					</div>
				</div>
			</section>
		</main>

		<footer class="grid gap-8 px-4 py-6 text-[16px] sm:px-6 md:grid-cols-3 lg:px-10">
			<p><strong>act</strong> studio</p>
			<p>the outreach arm of advanced analytica</p>
			<a class="text-ink underline decoration-ink underline-offset-4 hover:bg-ink hover:text-paper" href="mailto:hello@actai.studio">hello@actai.studio</a>
		</footer>
	</body>
</html>
