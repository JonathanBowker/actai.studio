---
import "../styles/global.css";
import SeoGuard from "../components/SeoGuard.astro";
import { isReviewStaging } from "../lib/siteEnvironment";
import {
	SiteHeader,
	ScrollToneController,
	HeroSection,
	LeadershipIntroSection,
	LeadershipAreasSection,
	ProcessSection,
	WorkflowSection,
	RippleEffectsSection,
	ResultsSection,
	DirectionSection,
	CallToActionSection,
	FaqSection,
	FooterSection,
} from "../components/sections";

const bookingHref = "/meeting";
const showReviewPlaceholders = isReviewStaging(Astro.url);

const useCaseImages = Array.from(
	{ length: 6 },
	(_, index) => `/images/use-case-shapes/shape-${String(index + 1).padStart(2, "0")}.jpg`,
);

const caseStudies = [
	{
		filter: "regulated",
		kicker: "Finance & Banking",
		title: "Keep reporting moving without losing control",
		copy: "A scoped agent can gather the right inputs, check them against agreed rules and prepare review-ready updates for finance teams.",
		points: ["Board packs", "Variance notes", "Approval trails"],
	},
	{
		filter: "built",
		kicker: "Land & Estates",
		title: "Make estate knowledge easier to act on",
		copy: "Bring leases, maintenance history, access rules and local knowledge into an agent that can answer practical questions with sources.",
		points: ["Asset context", "Maintenance records", "Local rules"],
	},
	{
		filter: "customer",
		kicker: "Hospitality & Entertainment",
		title: "Support bookings, staffing and guest detail",
		copy: "Use agents to organise the moving parts around events, enquiries, schedules and service notes without replacing human judgement.",
		points: ["Booking context", "Staff handovers", "Guest follow-up"],
	},
	{
		filter: "supply",
		kicker: "Transport & Logistics",
		title: "Help teams respond when plans change",
		copy: "A practical agent can surface constraints, flag knock-on effects and prepare clear updates when routes, stock or timings move.",
		points: ["Route changes", "Stock signals", "Customer updates"],
	},
	{
		filter: "supply",
		kicker: "Agriculture & Food",
		title: "Turn seasonal knowledge into usable guidance",
		copy: "Agents can help teams retrieve field notes, compliance detail and supplier context when timing and local judgement matter.",
		points: ["Field notes", "Supplier context", "Compliance checks"],
	},
	{
		filter: "regulated",
		kicker: "Risk & Compliance",
		title: "Make sensitive work easier to review",
		copy: "Shape agents with clear boundaries, evidence trails and escalation points so regulated work stays visible and accountable.",
		points: ["Evidence trails", "Review loops", "Escalation rules"],
	},
	{
		filter: "supply",
		kicker: "Technology & Software",
		title: "Turn product knowledge into better support",
		copy: "A focused agent can help teams answer product, implementation and support questions using the latest internal context.",
		points: ["Product notes", "Support patterns", "Release context"],
	},
	{
		filter: "knowledge",
		kicker: "Consulting & Operations",
		title: "Make delivery knowledge repeatable",
		copy: "Capture how experienced people diagnose, plan and deliver work, then shape that judgement into agent support for the wider team.",
		points: ["Delivery playbooks", "Client context", "Repeatable steps"],
	},
	{
		filter: "customer",
		kicker: "Brand & Media",
		title: "Keep content useful and on brand",
		copy: "Agents can help generate, review and adapt content against your standards, with clear approval before anything goes live.",
		points: ["Tone checks", "Asset reuse", "Approval flow"],
	},
	{
		filter: "built",
		kicker: "Property & Real Estate",
		title: "Make portfolio detail easier to navigate",
		copy: "Help teams find lease detail, tenant context and maintenance history without searching across scattered folders and inboxes.",
		points: ["Lease detail", "Tenant context", "Maintenance history"],
	},
	{
		filter: "regulated",
		kicker: "Healthcare & Care",
		title: "Support admin without losing sensitivity",
		copy: "A carefully scoped agent can help with non-clinical coordination, policy lookup and handover preparation while keeping review points clear.",
		points: ["Policy lookup", "Care coordination", "Review points"],
	},
	{
		filter: "knowledge",
		kicker: "Education & Training",
		title: "Turn learning material into guided support",
		copy: "Shape course content, staff guidance and learner questions into an agent that supports understanding without replacing teaching.",
		points: ["Course content", "Learner support", "Staff guidance"],
	},
	{
		filter: "knowledge",
		kicker: "Professional Services",
		title: "Make client context easier to reuse",
		copy: "Agents can help teams prepare briefs, retrieve precedent and keep client knowledge consistent across busy delivery teams.",
		points: ["Client briefs", "Precedent lookup", "Delivery notes"],
	},
	{
		filter: "customer",
		kicker: "Retail & Ecommerce",
		title: "Connect product, service and stock context",
		copy: "Give teams faster access to product detail, customer issues and fulfilment context so support stays practical and accurate.",
		points: ["Product detail", "Service patterns", "Fulfilment context"],
	},
	{
		filter: "supply",
		kicker: "Manufacturing & Supply",
		title: "Make operational knowledge easier to apply",
		copy: "A focused agent can surface process notes, supplier detail and quality checks when teams need practical answers quickly.",
		points: ["Process notes", "Supplier detail", "Quality checks"],
	},
];

const leadershipSectors = caseStudies.map((study, index) => ({
	kicker: study.kicker,
	title: study.title,
	points: study.points,
	image: useCaseImages[index % useCaseImages.length],
	number: index + 1,
}));

const leadershipSectorColumns = [
	leadershipSectors.filter((_, index) => index % 2 === 0),
	leadershipSectors.filter((_, index) => index % 2 === 1),
];

const caseStudyFilters = [
	{ label: "All sectors", value: "all" },
	{ label: "Regulated work", value: "regulated" },
	{ label: "Built environment", value: "built" },
	{ label: "Customer-facing", value: "customer" },
	{ label: "Knowledge work", value: "knowledge" },
	{ label: "Product & supply", value: "supply" },
];

const resultStats = [
	{
		value: "[Measure needed]",
		label: "Agent in the Room™ outcome measure, pending a verified source.",
	},
	{
		value: "[Measure needed]",
		label: "Time returned to teams, pending a verified source.",
	},
	{
		value: "[Evidence needed]",
		label: "Business value evidence, pending a verified source.",
	},
	{
		value: "[Evidence needed]",
		label: "Delivery evidence, pending a verified source.",
	},
];

const faqs = [
	["What is Agent in the Room™?", "Agent in the Room™ is a live working session. An AI agent, briefed on your business, joins the room through a speaker. Your people and our director question it together. You leave with a scoped AI direction."],
	["Do we need to know which agent we want before we speak?", "No. Start with the pressure, delay or repeated work inside the business. We help uncover the right use case, test whether AI is appropriate and define what a useful agent would need to know and do."],
	["Do you only advise, or do you build the agents too?", "We do both. Act AI Studio can set the direction, structure the knowledge and build working agents into your business. Delivery can include agent instructions, knowledge architecture, workflows, review points, governance and implementation support."],
	["What kinds of work can an agent take on?", "Agents are most useful where skilled people lose time searching for information, repeating answers, preparing documents, checking rules or moving work between systems. The right agent supports judgement and removes process work rather than pretending every task should be automated."],
	["Can an agent use our existing business knowledge?", "Yes. We shape approved documents, guidance, processes and expert knowledge into a clear source for the agent. Its scope, sources and escalation points are defined so people can understand where an answer came from and when human review is required."],
	["How do you manage risk, security and governance?", "Risk is designed into the work from the beginning. We define access, approved knowledge, boundaries, review points and escalation rules before an agent is treated as ready. The level of control is matched to the sensitivity of the work and your existing policies."],
	["What is an Act AI Studio knowledge pack?", "A knowledge pack is a compressed ZIP containing the diagnosis, agent prompt and supporting knowledge for a specific use case. It can be uploaded directly to a compatible chat assistant or unzipped and loaded as individual files."],
	["Will this replace our people?", "The aim is to give skilled people time back. Agents handle repeatable process work, retrieve context and prepare outputs so your team can spend more time applying judgement, building relationships and making decisions."],
	["Who do you work with?", "We work directly with business leaders in mid-caps, scale-ups and larger businesses. Act AI Studio is most useful when there is a real operational problem, access to the people who understand it and a willingness to turn business knowledge into a working capability."],
	["How do we get started?", "Start with a conversation. In 30 minutes, we can understand where time is being lost, what has already been tried and whether there is a valuable next step. If there is, we will recommend a clear scope before asking you to commit to delivery."],
];
---

<html lang="en">
	<head>
		<meta charset="utf-8" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="icon" href="/favicon.ico" />
		<meta name="viewport" content="width=device-width" />
		<meta name="generator" content={Astro.generator} />
		<meta name="description" content="Act AI Studio finds where AI creates value in your business, then shapes and builds the right agent." />
		<SeoGuard />
		<title>Act AI Studio | Find the value before building the agent</title>
		<style is:global>
			:root {
				--cream: #ebe9e4;
				--paper: #f6f4ef;
				--ink: #11110f;
				--muted: #77736a;
				--dark: #131412;
				--olive: #1e291d;
				--gold: #8a6a2e;
				--lime: #dfff42;
			}

			html {
				background: var(--cream);
				scroll-behavior: smooth;
			}

			body {
				background: var(--cream);
				color: var(--ink);
				overflow-x: clip;
			}

			.glass {
				backdrop-filter: blur(22px) saturate(1.1);
				-webkit-backdrop-filter: blur(22px) saturate(1.1);
			}

			body[data-contact-open="true"] {
				overflow: hidden;
			}

			body[data-contact-open="true"] main,
			body[data-contact-open="true"] .nav-pill,
			body[data-contact-open="true"] .contact-trigger {
				filter: blur(11px);
				pointer-events: none;
				transform: translateZ(0);
				transition: filter 220ms ease;
				user-select: none;
			}

			.contact-trigger {
				box-shadow: 0 18px 50px rgba(0, 0, 0, 0.12);
			}

			.contact-layer {
				display: grid;
				inset: 0;
				opacity: 0;
				pointer-events: none;
				position: fixed;
				transition: opacity 220ms ease;
				z-index: 80;
			}

			.contact-layer[data-open="true"] {
				opacity: 1;
				pointer-events: auto;
			}

			.contact-scrim {
				background: rgba(0, 0, 0, 0.52);
				inset: 0;
				position: absolute;
			}

			.contact-panel {
				align-self: stretch;
				background: #171717;
				border: 1px solid rgba(255, 255, 255, 0.06);
				border-radius: 1.8rem;
				box-shadow: 0 32px 90px rgba(0, 0, 0, 0.48);
				color: white;
				justify-self: end;
				margin: 0.25rem 0.45rem 0.25rem 0;
				max-height: calc(100vh - 0.5rem);
				overflow-y: auto;
				padding: clamp(2.5rem, 3vw, 2.95rem);
				position: relative;
				transform: translateX(2rem);
				transition: transform 320ms cubic-bezier(0.16, 1, 0.3, 1);
				width: min(42rem, calc(100vw - 1rem));
			}

			.contact-layer[data-open="true"] .contact-panel {
				transform: translateX(0);
			}

			.contact-close {
				background: rgba(255, 255, 255, 0.14);
				border: 0;
				border-radius: 9999px;
				color: white;
				cursor: pointer;
				align-items: center;
				display: inline-flex;
				gap: 0.5rem;
				font: inherit;
				font-weight: 700;
				padding: 0.72rem 1rem;
				position: absolute;
				right: 1rem;
				top: 1rem;
				transform: none;
				transition:
					background 180ms ease,
					opacity 180ms ease,
					transform 180ms ease;
				z-index: 2;
			}

			.contact-layer[data-confirm-open="true"] .contact-close {
				opacity: 0;
				pointer-events: none;
			}

			.contact-close:hover {
				background: rgba(255, 255, 255, 0.2);
				transform: translateY(-0.08rem);
			}

			.contact-control {
				background: #242424;
				border: 0;
				border-radius: 0.9rem;
				color: white;
				font: inherit;
				font-weight: 700;
				min-width: 0;
				outline: 0;
				min-height: 2.75rem;
				padding: 0.84rem 1rem;
				width: 100%;
			}

			.contact-control::placeholder {
				color: rgba(255, 255, 255, 0.42);
			}

			.contact-control:focus,
			.contact-option input:focus-visible + span,
			.contact-submit:focus-visible,
			.contact-close:focus-visible {
				outline: 2px solid white;
				outline-offset: 3px;
			}

			.contact-option span {
				background: #242424;
				border-radius: 999px;
				color: rgba(255, 255, 255, 0.52);
				cursor: pointer;
				display: inline-flex;
				font-weight: 700;
				min-height: 2.85rem;
				padding: 0.78rem 1rem;
				transition:
					background 180ms ease,
					color 180ms ease,
					box-shadow 180ms ease;
			}

			.contact-option input:checked + span {
				background: white;
				box-shadow: 0 0 0 3px rgba(255, 255, 255, 0.12);
				color: #11110f;
			}

			.contact-submit {
				background: white;
				border: 0;
				border-radius: 9999px;
				color: #11110f;
				cursor: pointer;
				font: inherit;
				font-weight: 800;
				min-height: 3.15rem;
				transition:
					background 180ms ease,
					color 180ms ease,
					transform 180ms ease;
			}

			.contact-submit:hover {
				background: var(--lime);
				transform: translateY(-1px);
			}

			.contact-confirm {
				background: #1b1b1b;
				border-radius: 1.7rem;
				box-shadow: 0 24px 70px rgba(0, 0, 0, 0.42);
				color: white;
				left: min(26rem, 34vw);
				opacity: 0;
				padding: 2.1rem 1.25rem 1.25rem;
				pointer-events: none;
				position: fixed;
				text-align: center;
				top: 43%;
				transform: translate(-50%, -50%) scale(0.98);
				transition:
					opacity 180ms ease,
					transform 220ms cubic-bezier(0.16, 1, 0.3, 1);
				width: min(22rem, calc(100vw - 2rem));
				z-index: 90;
			}

			.contact-confirm[data-open="true"] {
				opacity: 1;
				pointer-events: auto;
				transform: translate(-50%, -50%) scale(1);
			}

			.rounded-sheet {
				border-radius: 3.4rem 3.4rem 0 0;
			}

			.stack-panel {
				border-radius: 3.4rem 3.4rem 0 0;
				box-shadow: 0 -32px 80px rgba(0, 0, 0, 0.16);
				margin-top: -5.6rem;
				position: relative;
			}

			.reveal {
				opacity: 0;
				transform: translateY(30px);
				transition:
					opacity 780ms cubic-bezier(0.16, 1, 0.3, 1),
					transform 780ms cubic-bezier(0.16, 1, 0.3, 1);
				transition-delay: var(--delay, 0ms);
			}

			.reveal.is-visible {
				opacity: 1;
				transform: translateY(0);
			}

			.hero-title {
				font-size: clamp(3.6rem, 7.2vw, 8.2rem);
			}

			.hero-video-frame {
				height: max(100vh, calc(100vw / 1.6985));
				left: 50%;
				pointer-events: none;
				position: absolute;
				top: 50%;
				transform: translate(-50%, -50%);
				width: max(100vw, calc(100vh * 1.6985));
			}

			.hero-script {
				font-family: var(--font-sans);
				font-style: italic;
				font-weight: 400;
			}

			.feature-panel {
				background:
					radial-gradient(circle at 24% 30%, rgba(138, 106, 46, 0.78), transparent 0 34rem),
					radial-gradient(circle at 78% 20%, rgba(48, 74, 42, 0.72), transparent 0 35rem),
					linear-gradient(120deg, #4a3418, #142017 66%);
			}

			.vertical-card {
				background: rgba(255, 255, 255, 0.045);
				border: 1px solid rgba(255, 255, 255, 0.12);
			}

			.feature-index {
				background: rgba(0, 0, 0, 0.18);
				border: 1px solid rgba(255, 255, 255, 0.06);
				color: rgba(255, 255, 255, 0.43);
				cursor: pointer;
				text-align: left;
			}

			.feature-index[data-active="true"] {
				background: rgba(0, 0, 0, 0.38);
				border-color: rgba(255, 255, 255, 0.36);
				box-shadow: inset 0 0 0 1px rgba(255, 255, 255, 0.18);
				color: white;
			}

			.feature-track {
				-webkit-overflow-scrolling: touch;
				overscroll-behavior-y: contain;
				padding-bottom: 5rem;
				padding-top: 0;
				scrollbar-width: none;
			}

			.feature-track::-webkit-scrollbar {
				display: none;
			}

			.feature-window {
				position: relative;
			}

			.feature-window::before,
			.feature-window::after {
				content: "";
				left: 0;
				pointer-events: none;
				position: absolute;
				right: 0;
				z-index: 10;
			}

			.feature-card {
				max-width: 34.75rem;
				min-height: 31rem;
				scroll-margin-top: 8rem;
				width: 100%;
			}

			@media (min-width: 1024px) {
				.feature-window {
					height: 40rem;
					overflow: hidden;
				}

				.feature-window::before {
					background: linear-gradient(180deg, rgba(33, 42, 26, 0.98) 0%, rgba(33, 42, 26, 0) 100%);
					height: 5rem;
					top: 0;
				}

				.feature-window::after {
					background: linear-gradient(0deg, rgba(36, 29, 18, 0.98) 0%, rgba(36, 29, 18, 0) 100%);
					bottom: 0;
					height: 4rem;
				}

				.feature-track {
					height: 100%;
					overflow-y: auto;
					padding-bottom: 6rem;
					padding-top: 1rem;
				}

				.feature-card {
					min-height: 31rem;
					scroll-margin-top: 2rem;
				}
			}

			.use-case-track {
				-webkit-overflow-scrolling: touch;
				background: transparent !important;
				box-shadow: none !important;
				scroll-snap-type: x proximity;
				scrollbar-width: none;
			}

			.use-case-track::-webkit-scrollbar {
				display: none;
			}

			.use-case-card {
				background: transparent;
				box-shadow: none;
				color: white;
				scroll-snap-align: start;
			}

			.use-case-shell {
				aspect-ratio: 15 / 16;
			}

			.use-case-card:nth-child(3n + 1) {
				--case-glow-a: rgba(255, 78, 24, 0.34);
				--case-glow-b: rgba(255, 179, 34, 0.3);
				--case-glow-c: rgba(87, 8, 23, 0.42);
				--case-haze: rgba(182, 171, 181, 0.34);
			}

			.use-case-card:nth-child(3n + 2) {
				--case-glow-a: rgba(97, 120, 255, 0.34);
				--case-glow-b: rgba(213, 136, 255, 0.28);
				--case-glow-c: rgba(20, 32, 62, 0.44);
				--case-haze: rgba(190, 199, 210, 0.34);
			}

			.use-case-card:nth-child(3n) {
				--case-glow-a: rgba(56, 213, 170, 0.3);
				--case-glow-b: rgba(237, 236, 142, 0.28);
				--case-glow-c: rgba(28, 43, 34, 0.46);
				--case-haze: rgba(179, 186, 178, 0.32);
			}

			.use-case-shell {
				background: transparent;
				box-shadow: none;
				isolation: isolate;
			}

			.use-case-art-image {
				filter: saturate(1.08) contrast(0.98);
				object-position: center 42%;
				opacity: 1;
				transform: scale(1.28);
				z-index: 0;
			}

			.use-case-texture,
			.use-case-shell::before,
			.use-case-shell::after {
				content: "";
				inset: 0;
				pointer-events: none;
				position: absolute;
			}

			.use-case-texture {
				background:
					radial-gradient(circle at 34% 40%, var(--case-glow-a) 0 11rem, transparent 24rem),
					radial-gradient(circle at 72% 36%, var(--case-glow-b) 0 9rem, transparent 22rem),
					radial-gradient(circle at 42% 74%, var(--case-glow-c) 0 11rem, transparent 23rem),
					linear-gradient(145deg, rgba(255, 255, 255, 0.24), rgba(255, 255, 255, 0.03));
				filter: blur(22px) saturate(1.18);
				mix-blend-mode: screen;
				opacity: 0.28;
				transform: scale(1.14) rotate(var(--case-tilt, 0deg));
				z-index: 1;
			}

			.use-case-shell::before {
				background:
					radial-gradient(circle at 20% 92%, rgba(255, 255, 255, 0.12), transparent 22rem),
					linear-gradient(180deg, rgba(0, 0, 0, 0.12), rgba(0, 0, 0, 0.32));
				z-index: 2;
			}

			.use-case-shell::after {
				background: linear-gradient(150deg, rgba(255, 255, 255, 0.12), rgba(255, 255, 255, 0.01) 44%, rgba(255, 255, 255, 0.08));
				z-index: 3;
			}

			.use-case-content {
				background: transparent;
				box-shadow: none;
				height: 100%;
				z-index: 4;
			}

			.use-case-kicker {
				left: 1rem;
				position: absolute;
				right: 1rem;
				top: 1rem;
			}

			.use-case-kicker > p {
				font-size: 0.78rem;
			}

			.use-case-nav {
				background: rgba(255, 255, 255, 0.12);
				box-shadow:
					inset 0 1px 10px rgba(255, 255, 255, 0.16),
					0 8px 24px rgba(0, 0, 0, 0.08);
			}

			.use-case-title {
				font-size: clamp(1.8rem, 2.4vw, 2.3rem);
				line-height: 0.98;
				margin-inline: auto;
				max-width: 14ch;
				text-align: center;
				text-wrap: balance;
			}

			.use-case-heading {
				align-content: start;
				left: 1rem;
				max-width: none;
				min-height: auto;
				padding-top: 0;
				position: absolute;
				right: 1rem;
				top: 4.5rem;
			}

			.use-case-copy {
				font-size: clamp(0.96rem, 1.2vw, 1.08rem);
				line-height: 1.3;
				margin-inline: auto;
				max-width: 31ch;
				text-align: center;
				text-wrap: balance;
			}

			.use-case-detail {
				backdrop-filter: blur(14px) saturate(1.08);
				-webkit-backdrop-filter: blur(14px) saturate(1.08);
				background:
					linear-gradient(180deg, rgba(255, 255, 255, 0.18), rgba(255, 255, 255, 0.08)),
					rgba(255, 255, 255, 0.1);
				border: 1px solid rgba(255, 255, 255, 0.28);
				bottom: 0.9rem;
				box-shadow:
					0 18px 60px rgba(0, 0, 0, 0.12),
					inset 0 1px 14px rgba(255, 255, 255, 0.16),
					inset 0 -18px 34px rgba(0, 0, 0, 0.08);
				display: grid;
				left: 50%;
				max-width: calc(100% - 2rem);
				min-height: 8.4rem;
				position: absolute;
				transform: translateX(-50%);
			}

			.use-case-menu-title {
				font-size: 0.78rem;
				margin-bottom: 0.65rem;
				text-align: center;
			}

			.use-case-menu-body {
				align-content: start;
				display: grid;
				font-size: 0.92rem;
				gap: 0.45rem;
			}

			.use-case-menu-row {
				align-items: center;
				background: rgba(255, 255, 255, 0.14);
				border-radius: 0.55rem;
				display: flex;
				justify-content: space-between;
				min-height: 2.05rem;
				padding: 0.48rem 0.75rem;
			}

			.use-case-menu-muted {
				padding: 0.32rem 0.75rem;
			}

			.use-case-chart {
				align-items: end;
				display: grid;
				gap: 0.35rem;
				grid-template-columns: repeat(4, minmax(0, 1fr));
				height: 3.2rem;
				margin-inline: auto;
				width: min(100%, 11rem);
			}

			.use-case-chart span {
				background: linear-gradient(180deg, rgba(255, 255, 255, 0.86), rgba(255, 255, 255, 0.22));
				border-radius: 999px 999px 0.35rem 0.35rem;
				display: block;
				min-height: 0.7rem;
			}

			.use-case-status-dot {
				background: rgba(255, 255, 255, 0.78);
				border-radius: 999px;
				height: 0.48rem;
				width: 0.48rem;
			}

			.triage-detail {
				align-content: space-between;
				gap: 0.8rem;
				min-height: 10.5rem;
			}

			.triage-card .use-case-title {
				font-size: clamp(1.45rem, 2vw, 2rem);
				max-width: 17ch;
			}

			.triage-card .use-case-shell {
				aspect-ratio: 4 / 5;
			}

			.triage-vertical-grid {
				align-self: start;
				position: relative;
			}

			.triage-vertical-grid::before,
			.triage-vertical-grid::after {
				content: "";
				left: 0;
				pointer-events: none;
				position: absolute;
				right: 0;
				z-index: 2;
			}

			.triage-vertical-grid::before {
				background: linear-gradient(180deg, #f6f4ef 0%, rgba(246, 244, 239, 0) 100%);
				height: 5rem;
				top: 0;
			}

			.triage-vertical-grid::after {
				background: linear-gradient(0deg, #f6f4ef 0%, rgba(246, 244, 239, 0.88) 30%, rgba(246, 244, 239, 0) 100%);
				bottom: 0;
				height: 8rem;
			}

			.triage-vertical-column {
				-webkit-overflow-scrolling: touch;
				overscroll-behavior-y: contain;
				scrollbar-width: none;
			}

			.triage-vertical-column::-webkit-scrollbar {
				display: none;
			}

			.triage-vertical-card {
				width: 100%;
			}

			.triage-vertical-card .use-case-title {
				font-size: clamp(1.05rem, 1.25vw, 1.35rem);
				line-height: 1.05;
			}

			.triage-vertical-card .use-case-shell {
				aspect-ratio: 4 / 5;
				border-radius: 0.9rem;
			}

			.triage-vertical-card .triage-detail {
				min-height: 8.6rem;
			}

			.triage-vertical-card .triage-detail > p {
				font-size: 0.78rem;
				line-height: 1.22;
			}

			.triage-vertical-card .triage-action {
				font-size: 0.82rem;
			}

			.triage-mobile-track {
				display: none;
			}

			.triage-action {
				background: white;
				color: #11110f;
			}

			.triage-action:hover {
				background: #dfff42;
			}

			.proof-card {
				background: #f7f6f2;
				border: 1px solid rgba(17, 17, 15, 0.05);
				box-shadow: 0 18px 50px rgba(17, 17, 15, 0.05);
			}

			.proof-card:nth-child(2) {
				border-color: color-mix(in srgb, var(--accent) 82%, white);
			}

			.frame-layer {
				opacity: 0;
				transform: translate(-50%, calc(64% + var(--frame-peek, 0px))) scale(0.9);
				transform-origin: center;
				transition:
					opacity 920ms cubic-bezier(0.16, 1, 0.3, 1),
					transform 620ms cubic-bezier(0.16, 1, 0.3, 1);
				transition-delay: var(--frame-delay, 0ms);
			}

			.reveal.is-visible .frame-layer {
				opacity: 1;
				transform: translate(-50%, calc(-50% + var(--frame-peek, 0px))) scale(1);
			}

			.reveal.frame-ready .frame-layer {
				transition-delay: 0ms;
			}

			.frame-stack {
				touch-action: pan-y;
			}

			.sector-grid {
				align-items: start;
				position: relative;
			}

			.sector-grid::before,
			.sector-grid::after {
				content: "";
				left: 0;
				pointer-events: none;
				position: absolute;
				right: 0;
				z-index: 4;
			}

			.sector-grid::before {
				background: linear-gradient(180deg, #f6f4ef 0%, rgba(246, 244, 239, 0.92) 36%, rgba(246, 244, 239, 0) 100%);
				height: 8rem;
				top: 0;
			}

			.sector-grid::after {
				background: linear-gradient(0deg, #f6f4ef 0%, rgba(246, 244, 239, 0.92) 36%, rgba(246, 244, 239, 0) 100%);
				bottom: 0;
				height: 8rem;
			}

			.sector-grid-dark::before {
				background: linear-gradient(180deg, #11110f 0%, rgba(17, 17, 15, 0.92) 36%, rgba(17, 17, 15, 0) 100%);
			}

			.sector-grid-dark::after {
				background: linear-gradient(0deg, #11110f 0%, rgba(17, 17, 15, 0.92) 36%, rgba(17, 17, 15, 0) 100%);
			}

			.sector-column {
				-webkit-overflow-scrolling: touch;
				overscroll-behavior-y: contain;
				scrollbar-width: none;
				touch-action: pan-y;
			}

			.sector-column::-webkit-scrollbar {
				display: none;
			}

			.sector-column:nth-child(2) {
				transform: translateY(5rem);
			}

			.footer-word {
				background: linear-gradient(180deg, #686868 0%, #686868 42%, rgba(104, 104, 104, 0) 92%);
				-webkit-background-clip: text;
				background-clip: text;
				color: transparent;
			}

			.faq-answer {
				display: grid;
				grid-template-rows: 0fr;
				transition: grid-template-rows 260ms ease;
			}

			.faq-answer > div {
				overflow: hidden;
			}

			.faq-item[data-open="true"] .faq-answer {
				grid-template-rows: 1fr;
			}

			.faq-item[data-open="true"] .faq-icon {
				transform: rotate(180deg);
			}

			.cta-pill {
				transform: translateY(0);
				transition: transform 420ms cubic-bezier(0.16, 1, 0.3, 1);
			}

			.reveal:not(.is-visible) .cta-pill {
				transform: translateY(0.45em);
			}

			.cta-line:hover .cta-pill {
				transform: translateY(-0.08em) rotate(-1.5deg);
			}

			.cta-line:hover .cta-pill-alt {
				transform: translateY(0.08em) rotate(1.5deg);
			}

			@media (max-width: 760px) {
				.triage-vertical-grid {
					display: none;
				}

				.triage-mobile-track {
					display: flex;
				}

				body[data-contact-open="true"] main,
				body[data-contact-open="true"] .nav-pill,
				body[data-contact-open="true"] .contact-trigger {
					filter: blur(7px);
				}

				.contact-trigger {
					bottom: 1rem;
					left: auto;
					padding: 0;
					right: 1rem;
					top: auto;
					transform: none;
					width: 3.5rem;
				}

				.contact-trigger span:last-child {
					clip: rect(0 0 0 0);
					clip-path: inset(50%);
					height: 1px;
					overflow: hidden;
					position: absolute;
					white-space: nowrap;
					width: 1px;
				}

				.contact-panel {
					align-self: end;
					border-radius: 1.6rem 1.6rem 0 0;
					margin: 0;
					max-height: 92vh;
					padding: 1.35rem;
					width: 100%;
				}

				.contact-close {
					right: 1rem;
					top: 1rem;
				}

				.contact-confirm {
					left: 50%;
					top: 50%;
				}

				.rounded-sheet {
					border-radius: 2rem 2rem 0 0;
				}

				.stack-panel {
					border-radius: 2rem 2rem 0 0;
					margin-top: -2.8rem;
				}

				.hero-title {
					font-size: clamp(2.65rem, 11.5vw, 3.5rem);
					max-width: calc(100vw - 2rem);
				}
			}

			@media (prefers-reduced-motion: reduce) {
				html {
					scroll-behavior: auto;
				}

				.reveal {
					opacity: 1;
					transform: none;
					transition: none;
				}

				.frame-layer {
					opacity: 1;
					transform: translate(-50%, -50%) scale(1);
					transition: none;
				}

				.cta-pill,
				.reveal:not(.is-visible) .cta-pill,
				.cta-line:hover .cta-pill,
				.cta-line:hover .cta-pill-alt,
				.contact-panel,
				.contact-layer {
					transform: none;
					transition: none;
				}
			}
		</style>
	</head>
	<body class="pt-[4.5rem]">
<SiteHeader />
<ScrollToneController />

		<main class="bg-[#ebe9e4]">
			<HeroSection />
			<LeadershipIntroSection />
			<ProcessSection {bookingHref} />
			<WorkflowSection />
			<LeadershipAreasSection {leadershipSectorColumns} />
			<RippleEffectsSection />
			<DirectionSection {bookingHref} />
			{showReviewPlaceholders && <ResultsSection {resultStats} {bookingHref} />}
			<CallToActionSection {bookingHref} />
			<FaqSection {faqs} />
			<FooterSection {bookingHref} />
		</main>

		<script>
			const trackSiteEvent = (name, detail = {}) => {
				window.dispatchEvent(new CustomEvent(name, { detail }));
				window.dataLayer?.push({ event: name, ...detail });
			};

			document.querySelectorAll("[data-agent-card-click]").forEach((link) => {
				link.addEventListener("click", () => {
					trackSiteEvent("agent_card_click", { agentSlug: link.dataset.agentCardClick });
				});
			});

			const revealItems = document.querySelectorAll(".reveal");

			const observer = new IntersectionObserver((entries) => {
				entries.forEach((entry) => {
					if (entry.isIntersecting) {
						entry.target.classList.add("is-visible");
						if (entry.target.querySelector("[data-frame-stack]")) {
							window.setTimeout(() => entry.target.classList.add("frame-ready"), 1500);
						}
					}
				});
			}, { threshold: 0.12 });

			revealItems.forEach((item) => observer.observe(item));

			const caseCards = [...document.querySelectorAll("[data-case-card]")];
			const caseRevealButton = document.querySelector("[data-case-reveal]");
			const caseRevealWrap = caseRevealButton?.closest("div");
			const caseFilter = document.querySelector("[data-case-filter]");
			const caseFilterToggle = document.querySelector("[data-case-filter-toggle]");
			const caseFilterMenu = document.querySelector("[data-case-filter-menu]");
			const caseFilterLabel = document.querySelector("[data-case-filter-label]");
			let activeCaseFilter = "all";
			let visibleCaseCount = 3;

			const matchingCaseCards = () => caseCards.filter((card) => activeCaseFilter === "all" || card.dataset.caseFilterValue === activeCaseFilter);

			const setCaseFilterOpen = (open) => {
				if (!caseFilterToggle || !caseFilterMenu) return;
				caseFilterToggle.setAttribute("aria-expanded", String(open));
				caseFilterMenu.classList.toggle("hidden", !open);
			};

			const updateCaseCards = () => {
				const matching = matchingCaseCards();
				caseCards.forEach((card) => {
					const match = matching.includes(card);
					const visible = match && matching.indexOf(card) < visibleCaseCount;
					card.toggleAttribute("hidden", !visible);
					if (visible) window.requestAnimationFrame(() => card.classList.add("is-visible"));
				});
				caseRevealWrap?.toggleAttribute("hidden", matching.length <= visibleCaseCount);
			};

			caseFilterToggle?.addEventListener("click", () => {
				setCaseFilterOpen(caseFilterToggle.getAttribute("aria-expanded") !== "true");
			});

			document.querySelectorAll("[data-case-filter-option]").forEach((option) => {
				option.addEventListener("click", () => {
					activeCaseFilter = option.dataset.caseFilterOption || "all";
					visibleCaseCount = 3;
					if (caseFilterLabel) caseFilterLabel.textContent = option.dataset.caseFilterName || "All sectors";
					setCaseFilterOpen(false);
					updateCaseCards();
				});
			});

			document.addEventListener("click", (event) => {
				if (caseFilter && !caseFilter.contains(event.target)) setCaseFilterOpen(false);
			});

			caseRevealButton?.addEventListener("click", () => {
				visibleCaseCount += 3;
				updateCaseCards();
			});

			updateCaseCards();

			const featureNavItems = [...document.querySelectorAll("[data-feature-nav]")];
			const featureCards = [...document.querySelectorAll("[data-feature-card]")];
			const featureTrack = document.querySelector("[data-feature-track]");
			let featurePauseUntil = 0;
			const setActiveFeature = (activeIndex) => {
				featureNavItems.forEach((item) => {
					const active = item.dataset.featureNav === String(activeIndex);
					item.dataset.active = String(active);
					item.setAttribute("aria-pressed", String(active));
				});
			};

			featureNavItems.forEach((item) => {
				item.addEventListener("click", () => {
					const target = document.getElementById(item.dataset.featureTarget);
					if (!target) return;

					setActiveFeature(item.dataset.featureNav);
					const reduceMotion = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
					if (featureTrack && window.innerWidth >= 1024) {
						featurePauseUntil = performance.now() + 5200;
						const top = target.offsetTop - featureTrack.offsetTop - featureTrack.clientHeight * 0.1;
						featureTrack.scrollTo({ top, behavior: reduceMotion ? "auto" : "smooth" });
					} else {
						const offset = 96;
						const top = target.getBoundingClientRect().top + window.scrollY - offset;
						window.scrollTo({ top, behavior: reduceMotion ? "auto" : "smooth" });
					}
				});
			});

			const featureObserver = new IntersectionObserver((entries) => {
				const visibleEntry = entries
					.filter((entry) => entry.isIntersecting)
					.sort((a, b) => b.intersectionRatio - a.intersectionRatio)[0];

				if (visibleEntry) setActiveFeature(visibleEntry.target.dataset.featureCard);
			}, {
				root: window.innerWidth >= 1024 ? featureTrack : null,
				rootMargin: "-28% 0px -36% 0px",
				threshold: [0.18, 0.35, 0.52, 0.7],
			});

			featureCards.forEach((card) => featureObserver.observe(card));

			if (featureTrack && window.innerWidth >= 1024 && !window.matchMedia("(prefers-reduced-motion: reduce)").matches) {
				let featureDirection = 1;
				let featureLastTick = performance.now();
				featurePauseUntil = performance.now() + 1400;

				["wheel", "touchstart", "pointerdown"].forEach((eventName) => {
					featureTrack.addEventListener(eventName, () => {
						featurePauseUntil = performance.now() + 3200;
					}, { passive: true });
				});

				const animateFeatureTrack = (time) => {
					const delta = Math.min(34, time - featureLastTick);
					featureLastTick = time;
					const maxScroll = Math.max(0, featureTrack.scrollHeight - featureTrack.clientHeight);

					if (maxScroll && time >= featurePauseUntil) {
						featureTrack.scrollTop += featureDirection * delta * 0.045;
						if (featureTrack.scrollTop >= maxScroll - 2) featureDirection = -1;
						if (featureTrack.scrollTop <= 2) featureDirection = 1;
					}

					requestAnimationFrame(animateFeatureTrack);
				};

				requestAnimationFrame(animateFeatureTrack);
			}

			const sectorColumns = [...document.querySelectorAll("[data-sector-column]")];
			if (!window.matchMedia("(prefers-reduced-motion: reduce)").matches) {
				let sectorMotionStarted = false;
				const startSectorColumnMotion = () => {
					if (sectorMotionStarted) return;
					sectorMotionStarted = true;

					const scrollState = sectorColumns.map((column, index) => {
						const loopPoint = Math.max(0, column.scrollHeight / 2);
						column.scrollTop = index % 2 === 0 ? loopPoint * 0.06 : loopPoint * 0.72;
						return {
							column,
							direction: index % 2 === 0 ? 1 : -1,
							pauseUntil: 0,
						};
					});

					let lastTick = performance.now();
					const animateSectorColumns = (time) => {
						const delta = Math.min(34, time - lastTick);
						lastTick = time;

						scrollState.forEach((state) => {
							const loopPoint = Math.max(0, state.column.scrollHeight / 2);
							if (!loopPoint || time < state.pauseUntil) return;

							state.column.scrollTop += state.direction * delta * 0.064;
							if (state.direction > 0 && state.column.scrollTop >= loopPoint) {
								state.column.scrollTop -= loopPoint;
							}
							if (state.direction < 0 && state.column.scrollTop <= 0) {
								state.column.scrollTop += loopPoint;
							}
						});

						requestAnimationFrame(animateSectorColumns);
					};

					scrollState.forEach((state) => {
						["wheel", "touchstart", "pointerdown"].forEach((eventName) => {
							state.column.addEventListener(eventName, () => {
								state.pauseUntil = performance.now() + 2600;
							}, { passive: true });
						});
					});

					requestAnimationFrame(animateSectorColumns);
				};

				requestAnimationFrame(startSectorColumnMotion);
			}

			document.querySelectorAll("[data-use-case-track]").forEach((track) => {
				const scrollByCard = (direction) => {
					const card = track.querySelector(".use-case-card");
					const distance = card ? card.getBoundingClientRect().width + 24 : track.clientWidth * 0.8;
					track.scrollBy({
						left: direction * distance,
						behavior: window.matchMedia("(prefers-reduced-motion: reduce)").matches ? "auto" : "smooth",
					});
				};

				track.parentElement?.querySelectorAll("[data-use-case-scroll]").forEach((button) => {
					button.addEventListener("click", () => {
						scrollByCard(Number(button.dataset.useCaseScroll || 1));
					});
				});

			});

			const triageTracks = [...document.querySelectorAll("[data-triage-track]")];
			const triageMobileTrack = document.querySelector("[data-triage-mobile-track]");
			const reducedMotion = window.matchMedia("(prefers-reduced-motion: reduce)");
			const scrollTriageTrack = (track, direction) => {
				const card = track.querySelector(".use-case-card");
				const distance = card ? card.getBoundingClientRect().width + 24 : track.clientWidth * 0.8;
				track.scrollBy({ left: direction * distance, behavior: reducedMotion.matches ? "auto" : "smooth" });
			};

			document.querySelectorAll("[data-triage-scroll]").forEach((button) => {
				button.addEventListener("click", () => {
					const direction = Number(button.dataset.triageScroll || 1);
					if (window.innerWidth <= 760 && triageMobileTrack) {
						scrollTriageTrack(triageMobileTrack, direction);
						return;
					}
					triageTracks.forEach((track) => scrollTriageTrack(track, direction));
				});
			});

			[...triageTracks, triageMobileTrack].filter(Boolean).forEach((track) => {
				track.addEventListener("wheel", (event) => {
					if (Math.abs(event.deltaY) <= Math.abs(event.deltaX)) return;
					track.scrollLeft += event.deltaY;
					event.preventDefault();
				}, { passive: false });
			});

			requestAnimationFrame(() => triageTracks.forEach((track) => { track.scrollLeft = 0; }));

			document.querySelectorAll("[data-frame-stack]").forEach((stack) => {
				const layers = [...stack.querySelectorAll("[data-frame-layer]")];
				let progress = 0;
				let touchY = null;

				const applyFrameProgress = () => {
					const revealDistance = stack.clientHeight * 0.56;
					const revealOrder = [layers[4], layers[3], layers[2], layers[1]];

					layers.forEach((layer) => {
						layer.style.setProperty("--frame-peek", "0px");
					});

					revealOrder.forEach((layer, orderIndex) => {
						if (!layer) return;
						const segmentStart = orderIndex / revealOrder.length;
						const segmentEnd = (orderIndex + 1) / revealOrder.length;
						const localProgress = Math.min(1, Math.max(0, (progress - segmentStart) / (segmentEnd - segmentStart)));
						layer.style.setProperty("--frame-peek", `${localProgress * revealDistance}px`);
					});
				};

				const updateFrameProgress = (delta) => {
					const next = Math.min(1, Math.max(0, progress + delta / 680));
					const changed = next !== progress;
					progress = next;
					applyFrameProgress();
					return changed;
				};

				const resetTouch = () => {
					touchY = null;
				};

				const handleTouchMove = (event) => {
					const nextY = event.touches[0]?.clientY;
					if (touchY === null || nextY === undefined) return;
					const changed = updateFrameProgress(touchY - nextY);
					touchY = nextY;
					if (changed) event.preventDefault();
				};

				stack.addEventListener("wheel", (event) => {
					const changed = updateFrameProgress(-event.deltaY);
					if (changed) event.preventDefault();
				}, { passive: false });

				stack.addEventListener("touchstart", (event) => {
					touchY = event.touches[0]?.clientY ?? null;
				}, { passive: true });

				stack.addEventListener("touchmove", handleTouchMove, { passive: false });
				stack.addEventListener("touchend", resetTouch);
				stack.addEventListener("touchcancel", resetTouch);

				applyFrameProgress();
			});

			document.querySelectorAll("[data-faq]").forEach((item) => {
				const button = item.querySelector("button");
				button?.addEventListener("click", () => {
					const open = item.dataset.open === "true";
					item.dataset.open = String(!open);
					button.setAttribute("aria-expanded", String(!open));
				});
			});
		</script>
	</body>
</html>
