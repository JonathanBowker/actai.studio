import ScrollToneController from "../components/sections/ScrollToneController.astro";
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<SeoGuard
			path="/"
			title="Act AI Studio | Intelligence needs direction"
			description="Act AI Studio finds where your business creates value and shapes AI to accelerate the delivery of it."
		/>
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<title>Act AI Studio | Intelligence needs direction</title>
	</head>
	<body>
		<ScrollToneController />
		<HomepageV3 />
		<NoWidows />
	</body>
</html>
