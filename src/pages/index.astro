				<h2 class="footer-word pointer-events-none mx-auto -mb-8 max-w-[64rem] text-center text-[clamp(3rem,7vw,7.5rem)] font-bold leading-[0.9]">
					AI planning for busy businesses
				</h2>
				<div class="relative z-10 mx-auto grid min-h-[24rem] max-w-[96rem] gap-10 rounded-[1.4rem] bg-[#151614] p-8 text-white md:grid-cols-[1fr_1fr_0.7fr]">
					<div class="grid content-between gap-10">
						<div>
							<p class="text-[1.7rem] font-bold">Act.</p>
							<p class="mt-10 font-bold text-white/55">Get a useful recommendation.<br />No spam. No noise.</p>
							<a href={bookingHref} class="mt-6 inline-flex h-12 items-center rounded-xl bg-white px-6 font-bold text-black no-underline transition hover:bg-[#dfff42]">
								Book a meeting
							</a>
						</div>
						<p class="text-white/42">© 2026 Act. All Rights Reserved.</p>
					</div>
					<div>
						<p class="mb-5 font-bold text-white/38">Information</p>
						<div class="grid gap-2 font-bold">
							<a class="text-white no-underline" href="/">Home</a>
							<a class="text-white no-underline" href="#process">Process</a>
							<a class="text-white no-underline" href="#use-cases">Use Cases</a>
							<a class="text-white no-underline" href="#case-studies">Case Studies</a>
							<a class="text-white no-underline" href="#faq">FAQ</a>
						</div>
						<p class="mb-3 mt-10 font-bold text-white/38">Contact</p>
						<a class="font-bold text-white no-underline" href="mailto:hello@actai.studio">hello@actai.studio</a>
					</div>
					<div>
						<p class="mb-5 font-bold text-white/38">Social</p>
						<div class="grid gap-2 font-bold">
							<a class="text-white no-underline" href="https://www.linkedin.com/company/advanced-analytica/" target="_blank" rel="noreferrer">LinkedIn</a>
						</div>
					</div>
				</div>
			</footer>
		</main>

		<script>
			const revealItems = document.querySelectorAll(".reveal");
			const observer = new IntersectionObserver((entries) => {
				entries.forEach((entry) => {
					if (entry.isIntersecting) {
						entry.target.classList.add("is-visible");
						if (entry.target.querySelector("[data-frame-stack]")) {
							window.setTimeout(() => entry.target.classList.add("frame-ready"), 1500);
						}
					}
				});
			}, { threshold: 0.12 });

			revealItems.forEach((item) => observer.observe(item));

			const menuToggle = document.querySelector("[data-menu-toggle]");
			const menuPanel = document.querySelector("[data-menu-panel]");
			const menuIcon = document.querySelector("[data-menu-icon]");
			const setMenuOpen = (open) => {
				if (!menuToggle || !menuPanel) return;
				menuPanel.dataset.open = String(open);
				menuToggle.setAttribute("aria-expanded", String(open));
				menuToggle.setAttribute("aria-label", open ? "Close menu" : "Open menu");
				if (menuIcon) menuIcon.dataset.open = String(open);
			};

			menuToggle?.addEventListener("click", () => {
				setMenuOpen(menuPanel?.dataset.open !== "true");
			});

			menuPanel?.querySelectorAll("a").forEach((link) => {
				link.addEventListener("click", () => setMenuOpen(false));
			});

			const proofModal = document.querySelector("[data-proof-modal]");
			const proofClose = proofModal?.querySelector("[data-proof-close]");
			const proofNumber = proofModal?.querySelector("[data-proof-number]");
			const proofTitle = proofModal?.querySelector("[data-proof-title]");
			const proofLead = proofModal?.querySelector("[data-proof-lead]");
			const proofBody = proofModal?.querySelector("[data-proof-body]");
			const setProofModalOpen = (open) => {
				if (!proofModal) return;
				proofModal.dataset.open = String(open);
				document.body.dataset.modalOpen = String(open);
				if (open) proofClose?.focus();
			};

			document.querySelectorAll("[data-proof-open]").forEach((button) => {
				button.addEventListener("click", () => {
					if (proofNumber) {
						proofNumber.textContent = button.dataset.proofNumber || "";
						proofNumber.style.color = button.style.getPropertyValue("--accent") || "";
					}
					if (proofTitle) proofTitle.textContent = button.dataset.proofTitle || "";
					if (proofLead) proofLead.textContent = button.dataset.proofLead || "";
					if (proofBody) proofBody.textContent = button.dataset.proofBody || "";
					setProofModalOpen(true);
				});
			});

			proofClose?.addEventListener("click", () => setProofModalOpen(false));
			proofModal?.addEventListener("click", (event) => {
				if (event.target === proofModal) setProofModalOpen(false);
			});

			window.addEventListener("keydown", (event) => {
				if (event.key === "Escape") {
					setMenuOpen(false);
					setProofModalOpen(false);
				}
			});

			const featureNavItems = [...document.querySelectorAll("[data-feature-nav]")];
			const featureCards = [...document.querySelectorAll("[data-feature-card]")];
			const setActiveFeature = (activeIndex) => {
				featureNavItems.forEach((item) => {
					const active = item.dataset.featureNav === String(activeIndex);
					item.dataset.active = String(active);
					item.setAttribute("aria-pressed", String(active));
				});
			};

			featureNavItems.forEach((item) => {
				item.addEventListener("click", () => {
					const target = document.getElementById(item.dataset.featureTarget);
					if (!target) return;

					setActiveFeature(item.dataset.featureNav);
					const offset = window.innerWidth >= 1024 ? window.innerHeight * 0.14 : 96;
					const top = target.getBoundingClientRect().top + window.scrollY - offset;
					window.scrollTo({
						top,
						behavior: window.matchMedia("(prefers-reduced-motion: reduce)").matches ? "auto" : "smooth",
					});
				});
			});

			const featureObserver = new IntersectionObserver((entries) => {
				const visibleEntry = entries
					.filter((entry) => entry.isIntersecting)
					.sort((a, b) => b.intersectionRatio - a.intersectionRatio)[0];

				if (visibleEntry) setActiveFeature(visibleEntry.target.dataset.featureCard);
			}, {
				rootMargin: "-28% 0px -36% 0px",
				threshold: [0.18, 0.35, 0.52, 0.7],
			});

			featureCards.forEach((card) => featureObserver.observe(card));

			const sectorColumns = [...document.querySelectorAll("[data-sector-column]")];
			if (!window.matchMedia("(prefers-reduced-motion: reduce)").matches) {
				let sectorMotionStarted = false;
				const startSectorColumnMotion = () => {
					if (sectorMotionStarted) return;
					sectorMotionStarted = true;

					const scrollState = sectorColumns.map((column, index) => {
						const loopPoint = Math.max(0, column.scrollHeight / 2);
						column.scrollTop = index % 2 === 0 ? loopPoint * 0.06 : loopPoint * 0.72;
						return {
							column,
							direction: index % 2 === 0 ? 1 : -1,
							hovered: false,
							pauseUntil: 0,
						};
					});

					let lastTick = performance.now();
					const animateSectorColumns = (time) => {
						const delta = Math.min(34, time - lastTick);
						lastTick = time;

						scrollState.forEach((state) => {
							const loopPoint = Math.max(0, state.column.scrollHeight / 2);
							if (!loopPoint || state.hovered || time < state.pauseUntil) return;

							state.column.scrollTop += state.direction * delta * 0.038;
							if (state.direction > 0 && state.column.scrollTop >= loopPoint) {
								state.column.scrollTop -= loopPoint;
							}
							if (state.direction < 0 && state.column.scrollTop <= 0) {
								state.column.scrollTop += loopPoint;
							}
						});

						requestAnimationFrame(animateSectorColumns);
					};

					scrollState.forEach((state) => {
						["wheel", "touchstart", "pointerdown"].forEach((eventName) => {
							state.column.addEventListener(eventName, () => {
								state.pauseUntil = performance.now() + 2600;
							}, { passive: true });
						});
						state.column.addEventListener("mouseenter", () => {
							state.hovered = true;
						});
						state.column.addEventListener("mouseleave", () => {
							state.hovered = false;
							state.pauseUntil = performance.now() + 450;
						});
					});

					requestAnimationFrame(animateSectorColumns);
				};

				requestAnimationFrame(startSectorColumnMotion);
			}

			document.querySelectorAll("[data-use-case-track]").forEach((track) => {
				const scrollByCard = (direction) => {
					const card = track.querySelector(".use-case-card");
					const distance = card ? card.getBoundingClientRect().width + 24 : track.clientWidth * 0.8;
					track.scrollBy({
						left: direction * distance,
						behavior: window.matchMedia("(prefers-reduced-motion: reduce)").matches ? "auto" : "smooth",
					});
				};

				document.querySelectorAll("[data-use-case-scroll]").forEach((button) => {
					button.addEventListener("click", () => {
						scrollByCard(Number(button.dataset.useCaseScroll || 1));
					});
				});

				track.addEventListener("wheel", (event) => {
					if (Math.abs(event.deltaY) <= Math.abs(event.deltaX)) return;
					track.scrollLeft += event.deltaY;
					event.preventDefault();
				}, { passive: false });
			});

			document.querySelectorAll("[data-frame-stack]").forEach((stack) => {
				const layers = [...stack.querySelectorAll("[data-frame-layer]")];
				let progress = 0;
				let touchY = null;

				const applyFrameProgress = () => {
					const revealDistance = stack.clientHeight * 0.56;
					const revealOrder = [layers[4], layers[3], layers[2], layers[1]];

					layers.forEach((layer) => {
						layer.style.setProperty("--frame-peek", "0px");
					});

					revealOrder.forEach((layer, orderIndex) => {
						if (!layer) return;
						const segmentStart = orderIndex / revealOrder.length;
						const segmentEnd = (orderIndex + 1) / revealOrder.length;
						const localProgress = Math.min(1, Math.max(0, (progress - segmentStart) / (segmentEnd - segmentStart)));
						layer.style.setProperty("--frame-peek", `${localProgress * revealDistance}px`);
					});
				};

				const updateFrameProgress = (delta) => {
					const next = Math.min(1, Math.max(0, progress + delta / 680));
					const changed = next !== progress;
					progress = next;
					applyFrameProgress();
					return changed;
				};

				const resetTouch = () => {
					touchY = null;
				};

				const handleTouchMove = (event) => {
					const nextY = event.touches[0]?.clientY;
					if (touchY === null || nextY === undefined) return;
					const changed = updateFrameProgress(touchY - nextY);
					touchY = nextY;
					if (changed) event.preventDefault();
				};

				stack.addEventListener("wheel", (event) => {
					const changed = updateFrameProgress(-event.deltaY);
					if (changed) event.preventDefault();
				}, { passive: false });

				stack.addEventListener("touchstart", (event) => {
					touchY = event.touches[0]?.clientY ?? null;
				}, { passive: true });

				stack.addEventListener("touchmove", handleTouchMove, { passive: false });
				stack.addEventListener("touchend", resetTouch);
				stack.addEventListener("touchcancel", resetTouch);

				applyFrameProgress();
			});

			document.querySelectorAll("[data-faq]").forEach((item) => {
				const button = item.querySelector("button");
				button?.addEventListener("click", () => {
					const open = item.dataset.open === "true";
					item.dataset.open = String(!open);
					button.setAttribute("aria-expanded", String(!open));
				});
			});
		</script>
	</body>
</html>
