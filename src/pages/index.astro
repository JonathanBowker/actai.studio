---
import "../styles/global.css";

const bookingHref = "/meeting";

const cards = [
	{
		number: "01",
		title: "Know what to do next",
		copy: "Act. has developed the tools and techniques to find the agents worth pursuing.",
		accent: "#8a6cff",
		detailLead: "Our approach.",
		detailBody: "We start with one real business pressure, then separate useful AI work from the surrounding noise. You leave with a clear recommendation: explore, avoid or scope next.",
	},
	{
		number: "02",
		title: "One realistic scope",
		copy: "A practical agent starts with a task, a boundary, a review and fix loop as proof.",
		accent: "#f26a21",
		detailLead: "How we prove it.",
		detailBody: "A useful agent is not a vague promise. It has a task, a boundary, a review and fix loop, and evidence that shows whether the system is ready to move forward.",
	},
	{
		number: "03",
		title: "Bring knowledge instantly",
		copy: "We turn what your people know into instructions an agent can safely use.",
		accent: "#16a6ad",
		detailLead: "What your team already knows.",
		detailBody: "We translate the judgement already inside your business into clear operating instructions, so an agent can use that knowledge safely, consistently and with human review where it matters.",
	},
];

const featureTabs = [
	{
		number: "01",
		label: "Book a discovery meeting",
		title: "Book a discovery meeting",
		copy: "We start with a focused conversation about where AI could remove pressure, save time or improve decisions.",
		image: "/images/business-workflow-tasks.svg",
	},
	{
		number: "02",
		label: "Find the business problem",
		title: "Find the business problem",
		copy: "We begin with the work itself: where time is spent where it shouldn't, decisions slow down, or knowledge gets stuck.",
		image: "/images/agentic-use-case.svg",
	},
	{
		number: "03",
		label: "Design the required agent",
		title: "Design the required agent",
		copy: "We define the task, boundaries, evidence and review loops an agent needs before it can be useful.",
		image: "/images/trusted-agent.svg",
	},
	{
		number: "04",
		label: "Implement the agent system",
		title: "Implement the agent system",
		copy: "We turn the framework into a working system your people can test, challenge and improve.",
		image: "/images/production-proof.svg",
	},
	{
		number: "05",
		label: "Monitor & grow your business",
		title: "Monitor & grow your business",
		copy: "We track what works, strengthen what proves useful and expand only where the evidence supports it.",
		image: "/images/production-proof.svg",
	},
];

const verticals = ["Brand", "Operations", "Investment protection", "Land & estates", "Technology due diligence"];

const leadershipSectors = [
	{ label: "Strategy & Direction", image: "/fixa-assets/WXKx26vqrAI7XfrXAgsHkTeOeV0.webp" },
	{ label: "Operations", image: "/images/act-hero-cinematic.png" },
	{ label: "Sales & Pipeline", image: "/fixa-assets/herovideo-poster.jpg" },
	{ label: "Customer Service", image: "/fixa-assets/K6oVlqJ1SryJzVBte2yxIFoGqI.webp" },
	{ label: "Finance & Reporting", image: "/fixa-assets/MpwLfV3BL41ih4BTUbGjwjVEyU.webp" },
	{ label: "People & HR", image: "/fixa-assets/tC5phDS1LNYMA1wQWaeq9OsGW18.webp" },
	{ label: "Media Generation", image: "/fixa-assets/kZW1dq5Sqd0rvMulTBXHA3l3Jd4.webp" },
	{ label: "Procurement", image: "/fixa-assets/wdiyf3RainSE2ei21wGTmn1A8QQ.webp" },
	{ label: "Risk & Compliance", image: "/fixa-assets/sj6JNlwzLQYdJHUI6xdUTxyaw.webp" },
	{ label: "Knowledge Management", image: "/fixa-assets/xaO4Cqoe5QhlisikpQ3p47J9Zdw.png" },
	{ label: "Data & Insight", image: "/fixa-assets/KrDXRisTbXaEqR76RQpP0QRTTQo.png" },
	{ label: "Project Delivery", image: "/fixa-assets/WXKx26vqrAI7XfrXAgsHkTeOeV0.webp" },
	{ label: "Training & Enablement", image: "/images/act-hero-cinematic.png" },
	{ label: "Brand Management", image: "/fixa-assets/herovideo-poster.jpg" },
	{ label: "Admin & Coordination", image: "/fixa-assets/MpwLfV3BL41ih4BTUbGjwjVEyU.webp" },
	{ label: "Governance", image: "/fixa-assets/tC5phDS1LNYMA1wQWaeq9OsGW18.webp" },
];

const leadershipSectorColumns = [
	leadershipSectors.filter((_, index) => index % 2 === 0),
	leadershipSectors.filter((_, index) => index % 2 === 1),
];

const frameworkCards = [
	{
		title: "Find the problem worth solving",
		copy: "Most businesses already have the knowledge. We sit with you to find where it's stuck, not just where AI sounds impressive.",
		image: "/fixa-assets/WXKx26vqrAI7XfrXAgsHkTeOeV0.webp",
		type: "phase",
	},
	{
		title: "Scope one thing properly",
		copy: "We measure success by what changes, not by what looks impressive. One clear job, defined before anything gets built.",
		image: "/images/act-hero-cinematic.png",
		type: "goal",
	},
	{
		title: "Build the agent around the job",
		copy: "The skills it needs, the boundaries it works within, and proof it's ready before it touches real work.",
		image: "/fixa-assets/herovideo-poster.jpg",
		type: "goal",
	},
	{
		title: "Keep evidence, not impressions",
		copy: "Every agent we shape leaves a trail, what it did, why, and what changed. Judged on outcomes, not demos.",
		image: "/fixa-assets/K6oVlqJ1SryJzVBte2yxIFoGqI.webp",
		type: "results",
	},
	{
		title: "Cut through scattered documents",
		copy: "Give teams a private route to the knowledge already sitting in static files, that knows the business context and the right next question.",
		image: "/fixa-assets/tC5phDS1LNYMA1wQWaeq9OsGW18.webp",
		type: "phase",
	},
	{
		title: "Keep governance provable",
		copy: "Build review points, evidence trails and escalation rules in from the start, so sensitive work stays accountable, not just compliant on paper.",
		image: "/images/agentic-use-case.svg",
		type: "phase",
	},
	{
		title: "Lock the brief before you spend",
		copy: "Storyboard, cast and shot list agreed and signed off first. Nothing gets generated until the plan is right.",
		image: "/fixa-assets/MpwLfV3BL41ih4BTUbGjwjVEyU.webp",
		type: "phase",
	},
	{
		title: "Prepare for what's next",
		copy: "Whether that's succession, an exit, or simply scaling past one person holding all the knowledge in their head.",
		image: "/images/agentic-use-case-2.svg",
		type: "results",
	},
	{
		title: "Catch drift before it ships",
		copy: "Check imagery, copy and tone against the guidelines automatically, so brand compliance isn't a bottleneck or an afterthought.",
		image: "/images/agentic-use-case.svg",
		type: "results",
	},
];

const caseStudies = [
	{
		kicker: "Finance & Banking",
		title: "Keep reporting moving without losing control",
		copy: "A scoped agent can gather the right inputs, check them against agreed rules and prepare review-ready updates for finance teams.",
		points: ["Board packs", "Variance notes", "Approval trails"],
	},
	{
		kicker: "Land & Estates",
		title: "Make estate knowledge easier to act on",
		copy: "Bring leases, maintenance history, access rules and local knowledge into an agent that can answer practical questions with sources.",
		points: ["Asset context", "Maintenance records", "Local rules"],
	},
	{
		kicker: "Hospitality & Entertainment",
		title: "Support bookings, staffing and guest detail",
		copy: "Use agents to organise the moving parts around events, enquiries, schedules and service notes without replacing human judgement.",
		points: ["Booking context", "Staff handovers", "Guest follow-up"],
	},
	{
		kicker: "Transport & Logistics",
		title: "Help teams respond when plans change",
		copy: "A practical agent can surface constraints, flag knock-on effects and prepare clear updates when routes, stock or timings move.",
		points: ["Route changes", "Stock signals", "Customer updates"],
	},
	{
		kicker: "Agriculture & Food",
		title: "Turn seasonal knowledge into usable guidance",
		copy: "Agents can help teams retrieve field notes, compliance detail and supplier context when timing and local judgement matter.",
		points: ["Field notes", "Supplier context", "Compliance checks"],
	},
	{
		kicker: "Risk & Compliance",
		title: "Make sensitive work easier to review",
		copy: "Shape agents with clear boundaries, evidence trails and escalation points so regulated work stays visible and accountable.",
		points: ["Evidence trails", "Review loops", "Escalation rules"],
	},
	{
		kicker: "Technology & Software",
		title: "Turn product knowledge into better support",
		copy: "A focused agent can help teams answer product, implementation and support questions using the latest internal context.",
		points: ["Product notes", "Support patterns", "Release context"],
	},
	{
		kicker: "Consulting & Operations",
		title: "Make delivery knowledge repeatable",
		copy: "Capture how experienced people diagnose, plan and deliver work, then shape that judgement into agent support for the wider team.",
		points: ["Delivery playbooks", "Client context", "Repeatable steps"],
	},
	{
		kicker: "Brand & Media",
		title: "Keep content useful and on brand",
		copy: "Agents can help generate, review and adapt content against your standards, with clear approval before anything goes live.",
		points: ["Tone checks", "Asset reuse", "Approval flow"],
	},
];

const faqs = [
	["Is this a chatbot project?", "No. A chatbot responds. We design agentic systems that complete defined work with boundaries, evidence and review loops."],
	["What happens in the first meeting?", "We talk through one real business pressure and leave with a clear recommendation: explore, avoid or scope next."],
	["Do we need to know what to build already?", "No. The meeting is for finding the useful first shape, not pretending the answer is obvious before the work starts."],
	["Can this support regulated or high-risk work?", "Yes, but carefully. We define governance, human review points and proof before anything is positioned as production-ready."],
	["Who is behind Act?", "Act is the outreach arm of Advanced Analytica, bringing strategy, production and governance into one practical route."],
];
---

<html lang="en">
	<head>
		<meta charset="utf-8" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="icon" href="/favicon.ico" />
		<meta name="viewport" content="width=device-width" />
		<meta name="generator" content={Astro.generator} />
		<meta name="description" content="actai.studio designs practical agentic systems from business knowledge, clear scope and governance." />
		<title>actai.studio</title>
		<style>
			:root {
				--cream: #ebe9e4;
				--paper: #f6f4ef;
				--ink: #11110f;
				--muted: #77736a;
				--dark: #131412;
				--olive: #1e291d;
				--gold: #8a6a2e;
				--lime: #dfff42;
			}

			html {
				background: var(--cream);
				scroll-behavior: smooth;
			}

			body {
				background: var(--cream);
				color: var(--ink);
				overflow-x: clip;
			}

			.glass {
				backdrop-filter: blur(22px) saturate(1.1);
				-webkit-backdrop-filter: blur(22px) saturate(1.1);
			}

			.nav-pill {
				box-shadow: 0 18px 50px rgba(0, 0, 0, 0.12);
			}

			.site-menu {
				display: grid;
				grid-template-rows: 0fr;
				opacity: 0;
				pointer-events: none;
				transform: translateY(-0.5rem);
				transition:
					grid-template-rows 260ms cubic-bezier(0.16, 1, 0.3, 1),
					opacity 220ms ease,
					transform 260ms cubic-bezier(0.16, 1, 0.3, 1);
			}

			.site-menu[data-open="true"] {
				grid-template-rows: 1fr;
				opacity: 1;
				pointer-events: auto;
				transform: translateY(0);
			}

			.site-menu > div {
				overflow: hidden;
			}

			.menu-icon {
				position: relative;
			}

			.menu-icon,
			.menu-icon::before,
			.menu-icon::after {
				background: currentColor;
				border-radius: 999px;
				display: block;
				height: 2px;
				transition:
					transform 200ms ease,
					opacity 160ms ease;
				width: 14px;
			}

			.menu-icon::before,
			.menu-icon::after {
				content: "";
				left: 0;
				position: absolute;
			}

			.menu-icon::before {
				top: -5px;
			}

			.menu-icon::after {
				top: 5px;
			}

			.menu-icon[data-open="true"] {
				background: transparent;
			}

			.menu-icon[data-open="true"]::before {
				transform: translateY(5px) rotate(45deg);
			}

			.menu-icon[data-open="true"]::after {
				transform: translateY(-5px) rotate(-45deg);
			}

			.rounded-sheet {
				border-radius: 3.4rem 3.4rem 0 0;
			}

			.stack-panel {
				border-radius: 3.4rem 3.4rem 0 0;
				box-shadow: 0 -32px 80px rgba(0, 0, 0, 0.16);
				margin-top: -5.6rem;
				position: relative;
			}

			.reveal {
				opacity: 0;
				transform: translateY(30px);
				transition:
					opacity 780ms cubic-bezier(0.16, 1, 0.3, 1),
					transform 780ms cubic-bezier(0.16, 1, 0.3, 1);
				transition-delay: var(--delay, 0ms);
			}

			.reveal.is-visible {
				opacity: 1;
				transform: translateY(0);
			}

			.hero-title {
				font-size: clamp(3.6rem, 7.2vw, 8.2rem);
				line-height: 1.04;
				letter-spacing: 0;
			}

			.hero-video-frame {
				height: max(100vh, calc(100vw / 1.6985));
				left: 50%;
				pointer-events: none;
				position: absolute;
				top: 50%;
				transform: translate(-50%, -50%);
				width: max(100vw, calc(100vh * 1.6985));
			}

			.hero-script {
				font-family: var(--font-sans);
				font-style: italic;
				font-weight: 400;
			}

			.feature-panel {
				background:
					radial-gradient(circle at 24% 30%, rgba(138, 106, 46, 0.78), transparent 0 34rem),
					radial-gradient(circle at 78% 20%, rgba(48, 74, 42, 0.72), transparent 0 35rem),
					linear-gradient(120deg, #4a3418, #142017 66%);
			}

			.vertical-card {
				background: rgba(255, 255, 255, 0.045);
				border: 1px solid rgba(255, 255, 255, 0.12);
			}

			.feature-index {
				background: rgba(0, 0, 0, 0.18);
				border: 0;
				color: rgba(255, 255, 255, 0.43);
				cursor: pointer;
				text-align: left;
			}

			.feature-index[data-active="true"] {
				background: rgba(0, 0, 0, 0.38);
				color: white;
			}

			.feature-track {
				padding-bottom: 10vh;
				padding-top: 0;
			}

			.feature-card {
				max-width: 34.75rem;
				min-height: min(29rem, 58vh);
				scroll-margin-top: 8rem;
				width: 100%;
			}

			.use-case-track {
				-webkit-overflow-scrolling: touch;
				scroll-snap-type: x proximity;
				scrollbar-width: none;
			}

			.use-case-track::-webkit-scrollbar {
				display: none;
			}

			.use-case-card {
				scroll-snap-align: start;
			}

			.proof-card {
				background: #f7f6f2;
				border: 1px solid rgba(17, 17, 15, 0.05);
				box-shadow: 0 18px 50px rgba(17, 17, 15, 0.05);
			}

			.proof-card:nth-child(2) {
				border-color: color-mix(in srgb, var(--accent) 82%, white);
			}

			.frame-layer {
				opacity: 0;
				transform: translate(-50%, calc(64% + var(--frame-peek, 0px))) scale(0.9);
				transform-origin: center;
				transition:
					opacity 920ms cubic-bezier(0.16, 1, 0.3, 1),
					transform 620ms cubic-bezier(0.16, 1, 0.3, 1);
				transition-delay: var(--frame-delay, 0ms);
			}

			.reveal.is-visible .frame-layer {
				opacity: 1;
				transform: translate(-50%, calc(-50% + var(--frame-peek, 0px))) scale(1);
			}

			.reveal.frame-ready .frame-layer {
				transition-delay: 0ms;
			}

			.frame-stack {
				touch-action: pan-y;
			}

			.sector-grid {
				align-items: start;
				position: relative;
			}

			.sector-grid::before,
			.sector-grid::after {
				content: "";
				left: 0;
				pointer-events: none;
				position: absolute;
				right: 0;
				z-index: 4;
			}

			.sector-grid::before {
				background: linear-gradient(180deg, #f6f4ef 0%, rgba(246, 244, 239, 0.92) 36%, rgba(246, 244, 239, 0) 100%);
				height: 8rem;
				top: 0;
			}

			.sector-grid::after {
				background: linear-gradient(0deg, #f6f4ef 0%, rgba(246, 244, 239, 0.92) 36%, rgba(246, 244, 239, 0) 100%);
				bottom: 0;
				height: 8rem;
			}

			.sector-grid-dark::before {
				background: linear-gradient(180deg, #11110f 0%, rgba(17, 17, 15, 0.92) 36%, rgba(17, 17, 15, 0) 100%);
			}

			.sector-grid-dark::after {
				background: linear-gradient(0deg, #11110f 0%, rgba(17, 17, 15, 0.92) 36%, rgba(17, 17, 15, 0) 100%);
			}

			.sector-column {
				-webkit-overflow-scrolling: touch;
				overscroll-behavior-y: contain;
				scrollbar-width: none;
				touch-action: pan-y;
			}

			.sector-column::-webkit-scrollbar {
				display: none;
			}

			.sector-column:nth-child(2) {
				transform: translateY(5rem);
			}

			.proof-modal {
				opacity: 0;
				pointer-events: none;
				transition: opacity 220ms ease;
			}

			.proof-modal[data-open="true"] {
				opacity: 1;
				pointer-events: auto;
			}

			.proof-dialog {
				transform: translateY(1rem) scale(0.98);
				transition: transform 260ms cubic-bezier(0.16, 1, 0.3, 1);
			}

			.proof-modal[data-open="true"] .proof-dialog {
				transform: translateY(0) scale(1);
			}

			body[data-modal-open="true"] {
				overflow: hidden;
			}

			.footer-word {
				background: linear-gradient(180deg, #686868 0%, #686868 42%, rgba(104, 104, 104, 0) 92%);
				-webkit-background-clip: text;
				background-clip: text;
				color: transparent;
			}

			.faq-answer {
				display: grid;
				grid-template-rows: 0fr;
				transition: grid-template-rows 260ms ease;
			}

			.faq-answer > div {
				overflow: hidden;
			}

			.faq-item[data-open="true"] .faq-answer {
				grid-template-rows: 1fr;
			}

			.faq-item[data-open="true"] .faq-icon {
				transform: rotate(45deg);
			}

			@media (max-width: 760px) {
				.rounded-sheet {
					border-radius: 2rem 2rem 0 0;
				}

				.stack-panel {
					border-radius: 2rem 2rem 0 0;
					margin-top: -2.8rem;
				}

				.hero-title {
					font-size: clamp(2.8rem, 13vw, 4.4rem);
				}
			}

			@media (prefers-reduced-motion: reduce) {
				html {
					scroll-behavior: auto;
				}

				.reveal {
					opacity: 1;
					transform: none;
					transition: none;
				}

				.frame-layer {
					opacity: 1;
					transform: translate(-50%, -50%) scale(1);
					transition: none;
				}
			}
		</style>
	</head>
	<body>
		<header class="nav-pill fixed left-1/2 top-8 z-50 flex -translate-x-1/2 items-center gap-9 rounded-2xl bg-white/92 px-4 py-3 text-[#11110f] glass">
			<a href="/" class="flex h-8 items-center text-base font-black uppercase tracking-[-0.01em] text-[#11110f] no-underline" aria-label="actai.studio">
				ACTAI.STUDIO
			</a>
			<button class="grid h-8 w-8 place-items-center rounded-full text-2xl leading-none" type="button" aria-label="Open menu" aria-expanded="false" data-menu-toggle>
				<span class="menu-icon" data-menu-icon data-open="false" aria-hidden="true"></span>
			</button>
			<nav class="site-menu absolute left-0 right-0 top-[calc(100%+.5rem)] rounded-2xl bg-white/92 text-[#11110f] shadow-2xl glass" data-menu-panel data-open="false" aria-label="Main menu">
				<div>
					<div class="grid gap-1 p-3 font-bold">
						<a class="rounded-xl px-4 py-3 text-current no-underline transition hover:bg-black/8" href="#process">Process</a>
						<a class="rounded-xl px-4 py-3 text-current no-underline transition hover:bg-black/8" href="#use-cases">Use Cases</a>
						<a class="rounded-xl px-4 py-3 text-current no-underline transition hover:bg-black/8" href="#case-studies">Case Studies</a>
						<a class="rounded-xl px-4 py-3 text-current no-underline transition hover:bg-black/8" href="#faq">FAQ</a>
						<a class="mt-1 rounded-xl bg-[#11110f] px-4 py-3 text-center text-white no-underline transition hover:bg-[#dfff42] hover:text-black" href={bookingHref}>Book a meeting</a>
					</div>
				</div>
			</nav>
		</header>

		<main class="bg-[#ebe9e4]">
			<section class="relative grid min-h-screen place-items-center overflow-hidden px-4 py-24 text-center text-white">
				<img class="absolute inset-0 h-full w-full scale-105 object-cover" src="/fixa-assets/herovideo-poster.jpg" alt="" />
				<iframe
					class="hero-video-frame border-0"
					src="/fixa-assets/wXQXtViozUbKjC61PdWpw2.html"
					title="Hero video"
					allow="autoplay; fullscreen; picture-in-picture"
					loading="eager"
					aria-hidden="true"
					tabindex="-1"
				></iframe>
				<div class="absolute inset-0 bg-gradient-to-b from-black/10 via-black/24 to-black/60"></div>
				<div class="absolute inset-0 bg-[radial-gradient(circle_at_50%_45%,transparent_0_24rem,rgba(0,0,0,.32)_46rem)]"></div>

				<div class="relative z-10 grid max-w-[82rem] place-items-center gap-7">
					<p class="max-w-[34rem] text-[clamp(1rem,1.5vw,1.25rem)] leading-[1.15] text-white/84">
					Act. is an AI studio that works alongside business leaders who need direction, not another vendor.
					</p>
					<h1 class="hero-title max-w-[13ch] font-normal">
						Intelligence needs direction
					</h1>
					<div class="mt-8 flex max-w-[40rem] flex-col items-center justify-center gap-3 rounded-2xl bg-black/58 p-2 text-left shadow-2xl glass sm:flex-row">
						<p class="px-4 text-[1rem] font-medium leading-tight text-white">
							Finding exactly what you need.<br />
							No hidden agenda, no hype, no tech-speak.
						</p>
						<a href={bookingHref} class="inline-flex h-12 shrink-0 items-center rounded-xl bg-white px-6 font-bold text-black no-underline transition hover:bg-[#dfff42]">
							Book a meeting
						</a>
					</div>
