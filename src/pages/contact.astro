---
import "../styles/global.css";
import NoWidows from "../components/NoWidows.astro";
import SeoGuard from "../components/SeoGuard.astro";
import { ContactFormSection, ContactIntroSection, SiteHeader, SitemapFooterSection } from "../components/sections";

const bookingHref = "/meeting";
---

<html lang="en">
	<head>
		<meta charset="utf-8" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="icon" href="/favicon.ico" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<meta name="generator" content={Astro.generator} />
		<meta name="description" content="Contact Act AI Studio about your business, AI direction or an agent project." />
		<SeoGuard
			title="Contact | Act AI Studio"
			description="Contact Act AI Studio about your business, AI direction or an agent project."
		/>
		<title>Contact | Act AI Studio</title>
		<style is:global>
				html,
				body {
					background: #10100f;
					color: #f7f7f5;
			}
		</style>
	</head>
	<body class="pt-[var(--header-height)]">
		<SiteHeader showContactLink={false} theme="dark" />

		<main>
			<ContactIntroSection theme="dark" />
			<ContactFormSection theme="dark" />
		</main>
		<SitemapFooterSection {bookingHref} />
		<NoWidows />
	</body>
</html>
