---
import "../../styles/global.css";
import NoWidows from "../../components/NoWidows.astro";
import SeoGuard from "../../components/SeoGuard.astro";
import { AgentCascadeSection, AgentDiagnosisSection, AgentHeroSection, AgentPackSection, SiteHeader } from "../../components/sections";
import { getCollection } from "astro:content";

export async function getStaticPaths() {
	const agents = await getCollection("agents");
	return agents.map((agent) => ({ params: { slug: agent.id }, props: { agent } }));
}

const { agent } = Astro.props;
const bookingHref = "/meeting";
const packBase = `/packs/${agent.id}`;
const zipHref = `${packBase}/${agent.id}-triage-pack.zip`;
const heroArt = [
	"/images/use-case-shapes/shape-01.jpg",
	"/images/use-case-shapes/shape-02.jpg",
	"/images/use-case-shapes/shape-03.jpg",
	"/images/use-case-shapes/shape-04.jpg",
	"/images/use-case-shapes/shape-05.jpg",
	"/images/use-case-shapes/shape-06.jpg",
];
const artIndex = [...agent.id].reduce((total, character) => total + character.charCodeAt(0), 0) % heroArt.length;
const heroImage = heroArt[artIndex];
const cascadeLabels = ["Signal", "Friction", "Pattern", "Evidence", "Response"];
const cascadeImages = cascadeLabels.map((_, index) => heroArt[(artIndex + index + 1) % heroArt.length]);
---

<html lang="en">
	<head>
		<meta charset="utf-8" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="icon" href="/favicon.ico" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<meta name="description" content={`${agent.data.name}: a diagnostic self-help pack from Act AI Studio.`} />
		<SeoGuard
			path={`/agents/${agent.id}`}
			title={`${agent.data.name} | Act AI Studio`}
			description={`${agent.data.name}: a diagnostic self-help pack from Act AI Studio.`}
		/>
		<title>{agent.data.name} | Act AI Studio</title>
		<style is:global>
			:root { --cream:#ebe9e4; --paper:#f6f4ef; --ink:#11110f; --muted:#77736a; --lime:#dfff42; }
			html, body { background:var(--ink); }
			body { overflow-x:hidden; }
			.agent-page { background:var(--ink); color:var(--ink); min-height:100vh; overflow-x:clip; width:100%; }
			.agent-nav { align-items:center; display:flex; justify-content:space-between; left:0; padding:1.4rem clamp(1rem,3vw,2.5rem); position:absolute; top:0; width:100%; z-index:5; }
			.agent-nav__actions { display:flex; gap:.6rem; }
			.agent-nav__brand, .agent-nav__link, .agent-button { align-items:center; border-radius:.85rem; display:inline-flex; font-weight:800; justify-content:center; min-height:3.25rem; padding:.8rem 1.15rem; text-decoration:none; transition:background 180ms ease,color 180ms ease,transform 180ms ease; }
			.agent-nav__brand, .agent-nav__link--primary { background:white; color:var(--ink); }
			.agent-nav__link { background:rgba(17,17,15,.72); color:white; backdrop-filter:blur(16px); }
			.agent-nav__brand:hover, .agent-nav__link:hover, .agent-button:hover { background:var(--lime); color:var(--ink); transform:translateY(-1px); }

			.agent-hero { align-items:end; display:grid; isolation:isolate; min-height:min(58rem,100svh); overflow:hidden; padding:clamp(8rem,14vh,11rem) clamp(1rem,4vw,4.5rem) clamp(5rem,8vw,8rem); position:relative; }
			.agent-hero__media, .agent-hero__shade { inset:0; position:absolute; }
			.agent-hero__media { height:100%; object-fit:cover; transform:scale(1.04); width:100%; z-index:-2; }
			.agent-hero__shade { background:linear-gradient(180deg,rgba(17,17,15,.22),rgba(17,17,15,.18) 30%,rgba(17,17,15,.95)); z-index:-1; }
			.agent-hero__inner, .diagnosis__intro, .diagnosis__steps, .pack__inner { margin:0 auto; max-width:96rem; width:100%; }
			.agent-kicker { align-items:center; background:rgba(255,255,255,.92); border-radius:.65rem; color:var(--ink); display:inline-flex; font-size:.85rem; font-weight:800; gap:.6rem; margin:0; padding:.7rem .9rem; }
			.agent-kicker::before { background:var(--lime); border-radius:50%; content:""; height:.65rem; width:.65rem; }
			.agent-hero h1 { color:white; font-size:clamp(4rem,10vw,10rem); font-weight:700; letter-spacing:0; line-height:.82; margin:1.5rem 0 0; max-width:10ch; overflow-wrap:anywhere; }
			.agent-hero__bottom { align-items:end; display:grid; gap:2rem; grid-template-columns:minmax(0,1fr) minmax(18rem,.55fr); margin-top:clamp(3rem,8vh,7rem); }
			.agent-hero__nerve { color:white; font-size:clamp(1.75rem,3vw,3.4rem); font-weight:700; line-height:.98; margin:0; max-width:18ch; }
			.agent-hero__note { border-top:1px solid rgba(255,255,255,.45); color:rgba(255,255,255,.78); font-size:1rem; font-weight:700; line-height:1.35; margin:0; padding-top:1rem; }
			.cascade { background:var(--ink); color:white; height:190svh; position:relative; }
			.cascade__sticky { height:100svh; min-height:42rem; overflow:hidden; position:sticky; top:0; }
			.cascade__copy { left:50%; max-width:46rem; position:absolute; text-align:left; top:50%; transform:translate(-50%,-50%); width:min(54vw,46rem); z-index:2; }
			.cascade__eyebrow { align-items:center; color:var(--lime); display:flex; font-size:.82rem; font-weight:800; gap:.7rem; margin:0 0 2.5rem; text-transform:uppercase; }
			.cascade__eyebrow::after { background:rgba(255,255,255,.28); content:""; height:1px; width:5rem; }
			.cascade__statement { color:rgba(255,255,255,.36); font-size:clamp(2rem,3vw,3.45rem); font-weight:700; line-height:1.03; margin:0; }
			.cascade__statement strong { color:white; font-weight:700; }
			.cascade__index { align-items:center; display:flex; gap:.7rem; margin-top:2.5rem; }
			.cascade__index span { background:var(--lime); border-radius:50%; height:.7rem; width:.7rem; }
			.cascade__index p { color:rgba(255,255,255,.62); font-size:.82rem; font-weight:800; margin:0; }
			.cascade-tile { border-radius:1.15rem; box-shadow:0 1.5rem 5rem rgba(0,0,0,.42); margin:0; overflow:hidden; position:absolute; transform:translate3d(0,var(--cascade-drift,0),0) rotate(var(--cascade-rotate,0deg)); will-change:transform; z-index:1; }
			.cascade-tile img { display:block; height:100%; object-fit:cover; width:100%; }
			.cascade-tile figcaption { background:linear-gradient(transparent,rgba(17,17,15,.84)); bottom:0; color:white; font-size:.75rem; font-weight:800; left:0; padding:2.2rem .9rem .8rem; position:absolute; right:0; text-transform:uppercase; }
			.cascade-tile:nth-of-type(1) { --cascade-rotate:-3deg; aspect-ratio:4/5; left:6vw; top:8vh; width:clamp(10rem,17vw,17rem); }
			.cascade-tile:nth-of-type(2) { --cascade-rotate:3deg; aspect-ratio:1/1; right:8vw; top:9vh; width:clamp(9rem,14vw,14rem); }
			.cascade-tile:nth-of-type(3) { --cascade-rotate:2deg; aspect-ratio:5/4; bottom:7vh; left:11vw; width:clamp(12rem,20vw,20rem); }
			.cascade-tile:nth-of-type(4) { --cascade-rotate:-2deg; aspect-ratio:4/5; bottom:5vh; right:6vw; width:clamp(9rem,15vw,15rem); }
			.cascade-tile:nth-of-type(5) { --cascade-rotate:4deg; aspect-ratio:3/2; right:23vw; top:-8vh; width:clamp(10rem,16vw,16rem); }

			.stack-panel { border-radius:2.5rem 2.5rem 0 0; margin-top:-2.5rem; position:relative; }
			.diagnosis { background:var(--paper); padding:clamp(6rem,10vw,10rem) clamp(1rem,4vw,4.5rem) clamp(8rem,12vw,12rem); z-index:2; }
			.diagnosis__intro, .pack__header { display:grid; gap:2rem; grid-template-columns:.42fr 1fr; }
			.section-label { color:var(--muted); font-size:.85rem; font-weight:800; margin:0; text-transform:uppercase; }
			.diagnosis__intro h2, .pack__header h2 { font-size:clamp(3rem,6vw,6.6rem); font-weight:700; letter-spacing:0; line-height:.9; margin:0; max-width:13ch; }
			.diagnosis__steps { border-top:1px solid rgba(17,17,15,.24); display:grid; grid-template-columns:repeat(3,minmax(0,1fr)); margin-top:clamp(5rem,9vw,9rem); }
			.diagnostic-step { min-height:28rem; padding:2rem clamp(1.25rem,2.5vw,2.75rem) 2.5rem 0; }
			.diagnostic-step + .diagnostic-step { border-left:1px solid rgba(17,17,15,.24); padding-left:clamp(1.25rem,2.5vw,2.75rem); }
			.diagnostic-step__number { align-items:center; background:var(--ink); border-radius:50%; color:white; display:flex; font-size:.85rem; font-weight:800; height:2.75rem; justify-content:center; width:2.75rem; }
			.diagnostic-step:last-child .diagnostic-step__number { background:var(--lime); color:var(--ink); }
			.diagnostic-step h3 { font-size:clamp(1.8rem,2.5vw,2.65rem); font-weight:700; line-height:.98; margin:5rem 0 1.25rem; }
			.diagnostic-step p { color:#4d4942; font-size:clamp(1rem,1.25vw,1.2rem); font-weight:700; line-height:1.42; margin:0; max-width:31rem; }

			.pack { background:var(--ink); color:white; padding:clamp(6rem,10vw,10rem) clamp(1rem,4vw,4.5rem) 3rem; z-index:3; }
			.pack .section-label { color:rgba(255,255,255,.5); }
			.pack__contents { border-block:1px solid rgba(255,255,255,.22); display:grid; grid-template-columns:repeat(3,minmax(0,1fr)); margin-top:clamp(4rem,7vw,7rem); }
			.pack-item { min-height:15rem; padding:1.5rem 2rem 2rem 0; }
			.pack-item + .pack-item { border-left:1px solid rgba(255,255,255,.22); padding-left:2rem; }
			.pack-item span { color:var(--lime); font-size:.85rem; font-weight:800; }
			.pack-item h3 { font-size:clamp(1.35rem,2vw,2rem); line-height:1; margin:3rem 0 0; max-width:15ch; }

			.gate-workspace { align-items:start; display:grid; gap:clamp(2rem,6vw,7rem); grid-template-columns:.75fr 1fr; padding:clamp(5rem,9vw,9rem) 0; }
			.gate-workspace__copy h2 { font-size:clamp(2.25rem,3.2vw,3.75rem); line-height:1.02; margin:0; max-width:13ch; }
			.gate-workspace__copy > p { color:rgba(255,255,255,.58); font-size:1.05rem; font-weight:700; line-height:1.4; margin:1.25rem 0 0; max-width:29rem; }
			.delivery-note { border-left:4px solid var(--lime); margin-top:2rem; max-width:31rem; padding:.15rem 0 .15rem 1rem; }
			.delivery-note strong { display:block; font-size:1.05rem; margin-bottom:.45rem; }
			.delivery-note p { font-size:.95rem; margin:0; }
			.gate-surface { background:#1b1b1b; border-radius:1.5rem; padding:clamp(1.25rem,3vw,2.5rem); }
			.gate-form { display:grid; gap:1rem; }
			.gate-fields { display:grid; gap:.8rem; grid-template-columns:1fr 1fr; }
			.gate-label { display:grid; font-size:.85rem; font-weight:800; gap:.55rem; }
			.gate-input { background:#242424; border:1px solid transparent; border-radius:.75rem; color:white; font:inherit; min-height:3.35rem; padding:.9rem 1rem; width:100%; }
			.gate-input:focus, .gate-checkbox input:focus-visible + span, .agent-button:focus-visible { outline:2px solid var(--lime); outline-offset:3px; }
			.gate-checkbox { align-items:flex-start; color:rgba(255,255,255,.72); display:flex; font-size:.92rem; font-weight:700; gap:.7rem; line-height:1.35; }
			.gate-checkbox input { accent-color:var(--lime); flex:0 0 auto; height:1.1rem; margin-top:.12rem; width:1.1rem; }
			.gate-privacy, .gate-privacy a { color:rgba(255,255,255,.46); font-size:.82rem; font-weight:700; line-height:1.35; }
			.agent-button { border:0; cursor:pointer; font:inherit; }
			.agent-button--unlock { background:white; color:var(--ink); width:100%; }
			.unlock-panel { background:var(--lime); border-radius:1rem; color:var(--ink); display:grid; gap:1rem; margin-top:1rem; padding:1.25rem; }
			.unlock-panel[hidden] { display:none; }
			.unlock-panel__actions { display:grid; gap:.65rem; grid-template-columns:repeat(3,1fr); }
			.unlock-panel .agent-button { background:var(--ink); color:white; font-size:.9rem; }
			.unlock-panel .agent-button--download { background:white; color:var(--ink); }
			.unlock-panel p { font-weight:700; line-height:1.35; margin:0; }
			.agent-footer { align-items:end; border-top:1px solid rgba(255,255,255,.22); display:flex; gap:2rem; justify-content:space-between; padding:2rem 0 0; }
			.agent-footer p { color:rgba(255,255,255,.5); font-size:.85rem; font-weight:700; margin:0; }
			.reveal { opacity:0; transform:translateY(2rem); transition:opacity 700ms ease,transform 700ms cubic-bezier(.22,1,.36,1); }
			.reveal.is-visible { opacity:1; transform:translateY(0); }

			@media (max-width:760px) {
				.agent-nav { padding:1rem; }
				.agent-nav__brand, .agent-nav__link { font-size:.82rem; min-height:2.8rem; padding:.65rem .8rem; }
				.agent-nav__link:not(.agent-nav__link--primary) { display:none; }
				.agent-hero { min-height:46rem; padding-bottom:5.5rem; }
				.agent-hero h1 { font-size:clamp(3.35rem,14vw,4.7rem); max-width:100%; }
				.agent-hero__bottom, .diagnosis__intro, .pack__header, .gate-workspace { grid-template-columns:1fr; }
				.agent-hero__bottom { margin-top:3rem; }
				.cascade { height:145svh; }
				.cascade__sticky { min-height:38rem; }
				.cascade__copy { width:calc(100% - 3rem); }
				.cascade__eyebrow { margin-bottom:1.5rem; }
				.cascade__statement { font-size:clamp(1.8rem,8vw,2.5rem); }
				.cascade-tile { border-radius:.8rem; }
				.cascade-tile:nth-of-type(1) { left:-5vw; top:5vh; width:34vw; }
				.cascade-tile:nth-of-type(2) { right:-7vw; top:8vh; width:31vw; }
				.cascade-tile:nth-of-type(3) { bottom:4vh; left:-4vw; width:39vw; }
				.cascade-tile:nth-of-type(4) { bottom:3vh; right:-5vw; width:32vw; }
				.cascade-tile:nth-of-type(5) { display:none; }
				.stack-panel { border-radius:1.5rem 1.5rem 0 0; margin-top:-1.5rem; }
				.diagnosis__steps, .pack__contents { grid-template-columns:1fr; }
				.diagnostic-step { min-height:0; padding:1.5rem 0 3rem; }
				.diagnostic-step + .diagnostic-step { border-left:0; border-top:1px solid rgba(17,17,15,.24); padding-left:0; }
				.diagnostic-step h3 { margin-top:3rem; }
				.pack-item { min-height:0; padding:1.5rem 0 2.5rem; }
				.pack-item + .pack-item { border-left:0; border-top:1px solid rgba(255,255,255,.22); padding-left:0; }
				.pack-item h3 { margin-top:2rem; }
				.gate-fields, .unlock-panel__actions { grid-template-columns:1fr; }
				.agent-footer { align-items:start; flex-direction:column; }
			}
			@media (prefers-reduced-motion:reduce) {
				*, *::before, *::after { scroll-behavior:auto!important; transition-duration:.01ms!important; }
				.reveal { opacity:1; transform:none; }
				.cascade { height:100svh; }
				.cascade__sticky { position:relative; }
				.cascade-tile { --cascade-drift:0px!important; }
			}
		</style>
	</head>
	<body>
		<SiteHeader />
		<main class="agent-page">

			<AgentHeroSection {agent} {heroImage} />

			<AgentCascadeSection {agent} {cascadeImages} {cascadeLabels} />

			<AgentDiagnosisSection {agent} />

			<AgentPackSection {agent} {zipHref} {packBase} {bookingHref} />
		</main>

		<NoWidows />
		<script>
			const trackPackEvent = (name, detail = {}) => {
				window.dispatchEvent(new CustomEvent(name, { detail }));
				window.dataLayer?.push({ event: name, ...detail });
			};
			const gate = document.querySelector("[data-pack-gate]");
			const unlockPanel = document.querySelector("[data-pack-unlock]");
			const storageKey = gate ? `actai-pack:${gate.dataset.agentSlug}` : "";
			if (storageKey && localStorage.getItem(storageKey) === "unlocked") unlockPanel?.removeAttribute("hidden");
			gate?.addEventListener("submit", (event) => {
				event.preventDefault();
				localStorage.setItem(storageKey, "unlocked");
				trackPackEvent("pack_gate_submit", { agentSlug:gate.dataset.agentSlug });
				unlockPanel?.removeAttribute("hidden");
				unlockPanel?.scrollIntoView({ behavior:"smooth", block:"center" });
			});
			document.querySelectorAll("[data-open-tool]").forEach((button) => {
				button.addEventListener("click", async () => {
					const packBase = button.dataset.packBase;
					const tool = button.dataset.openTool;
					if (packBase) {
						const files = await Promise.all(["cover.md","prompt.md","agent-knowledge.md"].map(async (file) => {
							const response = await fetch(`${packBase}/${file}`);
							return `# ${file}\n\n${await response.text()}`;
						}));
						await navigator.clipboard?.writeText(files.join("\n\n---\n\n"));
					}
					trackPackEvent("pack_open_tool", { agentSlug:gate?.dataset.agentSlug, tool });
					window.open(tool === "claude" ? "https://claude.ai/new" : "https://chatgpt.com/", "_blank", "noopener,noreferrer");
				});
			});
			document.querySelector("[data-pack-download]")?.addEventListener("click", () => trackPackEvent("pack_download", { agentSlug:gate?.dataset.agentSlug }));
			const revealObserver = new IntersectionObserver((entries) => {
				entries.forEach((entry) => {
					if (entry.isIntersecting) { entry.target.classList.add("is-visible"); revealObserver.unobserve(entry.target); }
				});
			}, { threshold:.12 });
			document.querySelectorAll(".reveal").forEach((element) => revealObserver.observe(element));

			const cascade = document.querySelector("[data-cascade]");
			const cascadeTiles = [...document.querySelectorAll("[data-cascade-tile]")];
			const reduceMotion = window.matchMedia("(prefers-reduced-motion: reduce)");
			let cascadeFrame = 0;
			const updateCascade = () => {
				cascadeFrame = 0;
				if (!cascade || reduceMotion.matches) return;
				const rect = cascade.getBoundingClientRect();
				const travel = Math.max(1, rect.height - window.innerHeight);
				const progress = Math.min(1, Math.max(0, -rect.top / travel));
				cascadeTiles.forEach((tile) => {
					const speed = Number(tile.dataset.speed || 0);
					tile.style.setProperty("--cascade-drift", `${progress * speed}px`);
				});
			};
			const requestCascadeUpdate = () => {
				if (!cascadeFrame) cascadeFrame = requestAnimationFrame(updateCascade);
			};
			updateCascade();
			window.addEventListener("scroll", requestCascadeUpdate, { passive:true });
			window.addEventListener("resize", requestCascadeUpdate);
		</script>
	</body>
</html>
