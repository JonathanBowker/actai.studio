---
import "../styles/global.css";
import SeoGuard from "../components/SeoGuard.astro";
import { PrivacyContentSection, SiteHeader, SitemapFooterSection } from "../components/sections";
const bookingHref = "/meeting";
---

<html lang="en">
	<head>
		<meta charset="utf-8" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="icon" href="/favicon.ico" />
		<meta name="viewport" content="width=device-width" />
		<meta name="description" content="How Act AI Studio handles information shared through this website." />
		<SeoGuard />
		<title>Privacy notice | Act AI Studio</title>
	</head>
	<body class="bg-[#ebe9e4] pt-[var(--header-height)] text-[#11110f]">
		<SiteHeader />
		<main class="mx-auto grid min-h-screen max-w-[58rem] content-center gap-8 px-4 py-20 sm:px-8">
			<PrivacyContentSection />
		</main>
		<SitemapFooterSection {bookingHref} />
	</body>
</html>
