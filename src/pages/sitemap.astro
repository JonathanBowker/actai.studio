---
import "../styles/global.css";
import SeoGuard from "../components/SeoGuard.astro";
import { isReviewStaging } from "../lib/siteEnvironment";
import { getCollection } from "astro:content";
import {
	SitemapDirectorySection,
	SitemapFooterSection,
	SitemapHeroSection,
	SiteHeader,
} from "../components/sections";

const bookingHref = "/meeting";
const showReviewPlaceholders = isReviewStaging(Astro.url);
const agents = (await getCollection("agents")).sort((a, b) => a.data.name.localeCompare(b.data.name, "en-GB"));
const groups = [
	{
		label: "Start here",
		links: [
			{ label: "Home", href: "/", note: "Act AI Studio's direction and approach." },
			{ label: "Agent in the Room", href: "/#agent-in-the-room", note: "The call, preparation, session and build." },
			...(showReviewPlaceholders ? [{ label: "Results", href: "/#results", note: "Evidence placeholders under review." }] : []),
			{ label: "About us", href: "/#direction", note: "Meet the directors behind Act AI Studio." },
			{ label: "Frequently asked questions", href: "/#faq", note: "Practical answers about working together." },
		],
	},
	{
		label: "Talk to Act AI Studio",
		links: [
			{ label: "Request a 30-minute call", href: bookingHref, note: "Start with a direct conversation." },
			{ label: "Contact", href: "/contact", note: "Send us the business context and your question." },
		],
	},
	{
		label: "Agent diagnostics",
		wide: true,
		links: agents.map((agent) => ({
			label: agent.data.name,
			href: `/agents/${agent.id}`,
			note: agent.data.nerve,
		})),
	},
	{
		label: "Site information",
		links: [
			{ label: "Privacy notice", href: "/privacy", note: "How Act AI Studio handles the information you share." },
			{ label: "Site map", href: "/sitemap", note: "You are here." },
		],
	},
];
---

<html lang="en">
	<head>
		<meta charset="utf-8" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="icon" href="/favicon.ico" />
		<meta name="viewport" content="width=device-width" />
		<meta name="generator" content={Astro.generator} />
		<meta name="description" content="A complete directory of Act AI Studio pages, agent diagnostics and site information." />
		<SeoGuard
			title="Site map | Act AI Studio"
			description="A complete directory of Act AI Studio pages, agent diagnostics and site information."
		/>
		<title>Site map | Act AI Studio</title>
		<style is:global>
			html, body { background: #f6f4ef; color: #11110f; }
		</style>
	</head>
	<body class="pt-[var(--header-height)]">
		<SiteHeader />
		<main>
			<SitemapHeroSection />
			<SitemapDirectorySection {groups} />
		</main>
		<SitemapFooterSection {bookingHref} />
	</body>
</html>
